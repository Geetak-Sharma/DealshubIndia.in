{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "price": {
      "type": "string"
    },
    "originalPrice": {
      "type": "string"
    },
    "link": {
      "type": "string",
      "format": "uri"
    },
    "category": {
      "type": "string",
      "enum": [
        "CPU",
        "GPU",
        "Storage",
        "Peripheral",
        "Laptop",
        "Other"
      ]
    },
    "image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string",
          "format": "uri"
        }
      ]
    },
    "isLoot": {
      "default": false,
      "type": "boolean"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "price",
    "link",
    "category",
    "date"
  ]
}