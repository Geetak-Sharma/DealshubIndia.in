---
// Offline fallback page
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#22C55E" />
  <title>You're Offline — DealsHub India</title>
  <link rel="manifest" href="/manifest.json" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: #0B0E14;
      color: #f0f2f5;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      text-align: center;
      overflow: hidden;
    }

    /* Animated background glow */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 40% at 30% 20%, rgba(34,197,94,0.07) 0%, transparent 70%),
        radial-gradient(ellipse 50% 40% at 70% 80%, rgba(139,92,246,0.06) 0%, transparent 70%);
      pointer-events: none;
    }

    .offline-card {
      position: relative;
      background: rgba(19, 23, 32, 0.85);
      backdrop-filter: blur(24px);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 24px;
      padding: 48px 40px;
      max-width: 420px;
      width: 100%;
      box-shadow: 0 32px 64px rgba(0,0,0,0.5);
    }

    .offline-icon {
      font-size: 64px;
      margin-bottom: 8px;
      animation: float 3s ease-in-out infinite;
      display: block;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50%       { transform: translateY(-10px); }
    }

    .signal-bars {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      gap: 4px;
      height: 32px;
      margin: 16px auto;
    }

    .signal-bar {
      width: 8px;
      border-radius: 3px;
      background: rgba(255,255,255,0.1);
      animation: signalPulse 1.5s ease-in-out infinite;
    }
    .signal-bar:nth-child(1) { height: 8px;  animation-delay: 0s; }
    .signal-bar:nth-child(2) { height: 14px; animation-delay: 0.15s; }
    .signal-bar:nth-child(3) { height: 20px; animation-delay: 0.3s; }
    .signal-bar:nth-child(4) { height: 28px; animation-delay: 0.45s; }

    @keyframes signalPulse {
      0%, 100% { background: rgba(255,255,255,0.1); }
      50%       { background: rgba(239,68,68,0.6); }
    }

    h1 {
      font-size: 22px;
      font-weight: 900;
      letter-spacing: -0.5px;
      margin-bottom: 10px;
      color: #f0f2f5;
    }

    p {
      font-size: 14px;
      color: rgba(255,255,255,0.5);
      line-height: 1.6;
      margin-bottom: 28px;
    }

    .btn-retry {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #22C55E;
      color: #021a0a;
      font-weight: 800;
      font-size: 14px;
      padding: 13px 28px;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 4px 20px rgba(34,197,94,0.35);
      text-decoration: none;
      width: 100%;
      justify-content: center;
      margin-bottom: 12px;
    }

    .btn-retry:hover {
      filter: brightness(1.1);
      transform: translateY(-2px);
      box-shadow: 0 8px 28px rgba(34,197,94,0.5);
    }

    .btn-retry:active {
      transform: scale(0.97);
    }

    .btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 13px 28px;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,0.1);
      background: transparent;
      color: rgba(255,255,255,0.6);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .btn-secondary:hover {
      background: rgba(255,255,255,0.05);
      color: #f0f2f5;
    }

    .cached-tip {
      margin-top: 20px;
      padding: 12px 16px;
      background: rgba(34,197,94,0.05);
      border: 1px solid rgba(34,197,94,0.12);
      border-radius: 10px;
      font-size: 11px;
      color: rgba(34,197,94,0.8);
      font-weight: 600;
    }
  </style>
</head>
<body>
  <div class="offline-card">
    <span class="offline-icon">📡</span>

    <div class="signal-bars">
      <div class="signal-bar"></div>
      <div class="signal-bar"></div>
      <div class="signal-bar"></div>
      <div class="signal-bar"></div>
    </div>

    <h1>You're Offline</h1>
    <p>No internet connection detected. Check your Wi-Fi or mobile data and try again — deals are waiting!</p>

    <button class="btn-retry" onclick="retryConnection()" id="retry-btn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>
      </svg>
      Try Again
    </button>

    <a href="/" class="btn-secondary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
      Go to Cached Home
    </a>

    <div class="cached-tip">
      💡 Previously visited pages may still load from cache
    </div>
  </div>

  <script>
    function retryConnection() {
      const btn = document.getElementById('retry-btn');
      btn.textContent = 'Checking…';
      btn.style.opacity = '0.7';

      // Try to fetch a lightweight resource
      fetch('/manifest.json', { cache: 'no-store' })
        .then(() => {
          // Back online — redirect to homepage
          window.location.href = '/';
        })
        .catch(() => {
          btn.innerHTML = `
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/>
            </svg>
            Still Offline — Try Again`;
          btn.style.opacity = '1';
        });
    }

    // Auto-retry when browser reports online
    window.addEventListener('online', () => {
      window.location.href = '/';
    });
  </script>
</body>
</html>
