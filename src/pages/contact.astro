---
import PolicyLayout from '../layouts/PolicyLayout.astro';
import PageSubHeader from '../components/PageSubHeader.astro';
---

<PolicyLayout 
  title="Contact Us - DealsHub India" 
  description="Get in touch with the DealsHub India team for support, business inquiries, or deal-hunting questions."
>
  <div class="u-mb-6">
    <PageSubHeader 
      badgeText="CONTACT" 
      authorText="SUPPORT" 
      dateText="24/7" 
      bannerText="Contact" 
      navTargetClass=".nav__link--contact" 
    />
  </div>
  <div class="glass-panel policy-body">
    <h1 class="policy-h1">Contact Us</h1>
    
    <p>Have a question about a deal? Need help with a reward confirmation? Or just want to say hi? We're here to help!</p>
    
    <p>At DealsHub India, we strive to bring you the best loots and savings. If you encounter any issues or have feedback, please don't hesitate to reach out to our team.</p>
    
    <div class="policy-contact-block">
      <div class="policy-contact-label">Official Support Email</div>
      <a href="mailto:squeamish27@gmail.com" id="contact-email-link" class="policy-contact-email">squeamish27@gmail.com</a>
    </div>

    <div class="u-mt-6">
      <h2 class="policy-h2">Why Contact Us?</h2>
      <ul>
        <li><strong>Reward Tracking:</strong> Inquiries regarding Amazon Gift Cards or Profit confirmations.</li>
        <li><strong>Deal Submissions:</strong> Found a loot? Share it with the community!</li>
        <li><strong>Business Inquiries:</strong> Partnerships and promotional opportunities.</li>
      </ul>
    </div>
    
    <p>We typically respond within 24-48 business hours.</p>

    <div class="policy-footer-nav">
      <a href="/" class="policy-back-link">&larr; Back to Home</a>
    </div>
  </div>
</PolicyLayout>

