---
import AppShell from "@/layouts/AppShell.astro";
import Heading from "@/components/foundation/Heading.astro";
import Text from "@/components/foundation/Text.astro";
import LivingDealCard from "@/features/living-deal-card/LivingDealCard.astro";
import { buildDealCardData } from "@/features/living-deal-card/services/DealCardService";
import { Sparkles, Search, TrendingUp, TrendingDown, Clock, ShieldCheck, Activity, Target } from "lucide-react";
import Badge from "@/components/foundation/Badge.astro";

// Fetch the 3 curated deals for "Today's Best Picks"
const apexDeals = await Promise.all([
  buildDealCardData("p_1"),
  buildDealCardData("p_2"),
  buildDealCardData("p_3")
]);

const pickContexts = [
  { category: "Best Audio Deal", reason: "Historic low. Lowest price in 14 months." },
  { category: "Best Gaming Deal", reason: "High demand. 80% claimed across merchants." },
  { category: "Best Phone Deal", reason: "Rare discount. Combined with exclusive HDFC cashback." }
];
---

<AppShell title="DealsHub India - The AI Shopping Intelligence Platform">
  <div class="w-full">
    
    {/* HERO SECTION */}
    <section class="w-full bg-gradient-to-b from-background to-muted/10 border-b border-border/40 pb-12 pt-20 px-6">
      <div class="max-w-4xl mx-auto text-center space-y-6">
        <Badge variant="aiDecision" class="mx-auto mb-4 bg-primary/10 text-primary hover:bg-primary/20 border-primary/20 backdrop-blur-md px-3 py-1">
          <Sparkles className="w-3.5 h-3.5 mr-2 inline" /> DealsHub AI Engine Active
        </Badge>
        <Heading level={1} class="text-4xl md:text-6xl font-extrabold tracking-tight leading-tight">
          Make smarter <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-blue-500">buying decisions.</span>
        </Heading>
        <Text class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed">
          The financial decision engine for Indian e-commerce. We analyze historical data, predict price drops, and score merchant trust so you never overpay.
        </Text>
        
        {/* AI SEARCH & INTENTS */}
        <div class="max-w-2xl mx-auto mt-10 space-y-4">
          <div class="relative">
            <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none">
              <Search className="h-5 w-5 text-muted-foreground" />
            </div>
            <input 
              type="text" 
              placeholder="What are you looking to buy? (e.g., Best phone under 30k)" 
              class="w-full h-14 pl-12 pr-4 rounded-xl bg-background border-2 border-muted focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all outline-none text-foreground shadow-sm text-base md:text-lg"
            />
            <button class="absolute right-2 top-2 bottom-2 bg-foreground text-background px-6 rounded-lg font-semibold text-sm hover:scale-[1.02] active:scale-[0.98] transition-transform">
              Analyze
            </button>
          </div>
          
          <div class="flex flex-wrap justify-center gap-2 pt-2">
            {['Buying a phone', 'Building a PC', 'Upgrading my setup', 'Home appliances', 'Grocery runs'].map(intent => (
              <a href="#" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-muted/40 hover:bg-muted text-xs font-medium text-muted-foreground hover:text-foreground transition-colors border border-border/50">
                <Target className="w-3 h-3" /> {intent}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* AI MARKET BRIEF & TRUST METRICS */}
    <section class="border-b border-border/40 bg-muted/5">
      <div class="max-w-7xl mx-auto px-6 py-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 divide-y md:divide-y-0 md:divide-x divide-border/40">
          
          <div class="space-y-3 pt-4 md:pt-0 md:pr-6">
            <div class="flex items-center justify-between">
              <Text size="sm" weight="semibold" class="uppercase tracking-wider text-muted-foreground flex items-center gap-2"><Activity className="w-4 h-4 text-primary" /> Market Brief</Text>
              <Badge variant="neutral" class="text-[10px]">Live</Badge>
            </div>
            <ul class="space-y-2 text-sm">
              <li class="flex gap-2 items-start"><TrendingUp className="w-4 h-4 text-success shrink-0 mt-0.5" /> <span>Laptops heating up (Pre-sale buildup)</span></li>
              <li class="flex gap-2 items-start"><TrendingDown className="w-4 h-4 text-primary shrink-0 mt-0.5" /> <span>Summer appliances cooling down</span></li>
            </ul>
          </div>
          
          <div class="space-y-3 pt-4 md:pt-0 md:px-6">
            <Text size="sm" weight="semibold" class="uppercase tracking-wider text-muted-foreground flex items-center gap-2"><Clock className="w-4 h-4 text-primary" /> Daily Intelligence</Text>
            <ul class="space-y-2 text-sm">
              <li class="flex gap-2 items-start"><span class="font-bold text-foreground">1,240</span> <span>Historic lows detected today</span></li>
              <li class="flex gap-2 items-start"><span class="font-bold text-foreground">342</span> <span>High-value deals expiring in 2h</span></li>
            </ul>
          </div>

          <div class="space-y-3 pt-4 md:pt-0 md:px-6 lg:col-span-2">
            <Text size="sm" weight="semibold" class="uppercase tracking-wider text-muted-foreground flex items-center gap-2"><ShieldCheck className="w-4 h-4 text-primary" /> Platform Trust</Text>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-background rounded-lg p-3 border border-border/50 shadow-sm">
                <Text size="xs" color="muted">Deals Analyzed (24h)</Text>
                <Heading level={4} class="text-xl">142,890</Heading>
              </div>
              <div class="bg-background rounded-lg p-3 border border-border/50 shadow-sm">
                <Text size="xs" color="muted">Fake Discounts Flagged</Text>
                <Heading level={4} class="text-xl text-primary">12,405</Heading>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    {/* OPPORTUNITY ENGINE */}
    <OpportunityEngine />

    {/* CURATED BEST PICKS */}
    <section class="max-w-7xl mx-auto px-6 py-16 space-y-8">
      <div class="flex flex-col gap-2">
        <Heading level={2} class="text-2xl font-bold tracking-tight">
          AI Curated Recommendations
        </Heading>
        <Text color="muted" class="max-w-3xl text-sm">
          We processed over 100,000 active deals today. These three items represent the highest mathematical confidence scores for value, trust, and pricing history.
        </Text>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {apexDeals.map((deal, idx) => (
          <div class="flex flex-col gap-3">
            <div class="flex flex-col bg-muted/20 border border-border/50 p-3 rounded-t-xl rounded-b-sm border-b-0 space-y-1">
              <Text size="xs" weight="bold" class="uppercase tracking-wider text-primary">{pickContexts[idx].category}</Text>
              <Text size="sm" class="text-muted-foreground leading-tight">{pickContexts[idx].reason}</Text>
            </div>
            <div class="-mt-3">
              <LivingDealCard deal={deal} />
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</AppShell>
