---
export const prerender = false;
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import StructuredData from "../components/StructuredData.astro";
import HomeHero from "../components/home/HomeHero.astro";
import CategoryStrip from "../components/home/CategoryStrip.astro";
import HomeDealCard from "../components/ActiveDealCard.astro";
import CommunityJoinSection from "../components/home/CommunityJoinSection.astro";
import SiteFooter from "../components/ActiveFooter.astro";

// Fetch static deals for SSR / SEO
const deals = await getCollection("deals");
deals.sort((a, b) => {
  const da = a.data.date instanceof Date ? a.data.date.getTime() : 0;
  const db = b.data.date instanceof Date ? b.data.date.getTime() : 0;
  return db - da;
});
---

<BaseLayout title="DealsHubIndia.in — Best Deals &amp; Offers in India Today">
  <SiteHeader />

  <main id="main-content">
    {/* ===== HERO ===== */}
    <div class="l-container">
      <HomeHero />
    </div>

    {/* ===== CATEGORY FILTER STRIP ===== */}
    <CategoryStrip />

    {/* ===== DEAL FEED ===== */}
    <div class="l-container">
      <section class="deals-section" aria-labelledby="deals-heading">
        <div class="deals-section__header">
          <h2 class="section-label" id="deals-heading">Latest Drops</h2>
          <span class="section-count" id="deals-count" aria-live="polite"></span>
        </div>

        {/* No-results state (shown by JS when search/filter yields nothing) */}
        <div id="no-search-results" class="no-results" style="display:none" role="status">
          <p>No deals match your filter. Try another category or clear the search.</p>
        </div>

        {/* Live deal grid — hydrated client-side */}
        <div id="deals-grid" class="deals-grid" aria-label="Live deals">
          <div class="deal-skeleton"></div>
          <div class="deal-skeleton"></div>
          <div class="deal-skeleton"></div>
          <div class="deal-skeleton"></div>
        </div>

        {/* SSR content for search engines (visually hidden, semantically present) */}
        {deals.length > 0 && (
          <div class="seo-deals" aria-hidden="true" tabindex="-1">
            {deals.map(deal => (
              <HomeDealCard
                title={deal.data.title}
                price={deal.data.price}
                originalPrice={deal.data.originalPrice}
                link={deal.data.link}
                category={deal.data.category}
                isLoot={deal.data.isLoot}
                merchant={deal.data.platform}
                image={deal.data.image}
              />
            ))}
          </div>
        )}
      </section>

      {/* ===== COMMUNITY ===== */}
      <CommunityJoinSection />
    </div>
  </main>

  <SiteFooter />
  <FloatingWhatsApp />
  <StructuredData deals={deals} />
</BaseLayout>

{/* Client-side live data fetching, rendering, search & category filter logic */}
<script is:inline>
  (function () {
    const grid = document.getElementById("deals-grid");
    const countEl = document.getElementById("deals-count");
    const noResults = document.getElementById("no-search-results");
    let allWrappers = [];

    // Title and Text Cleanup Helper
    function cleanTitle(str) {
      if (!str) return "";
      let val = str;
      // Remove raw hashtag tails
      val = val.replace(/#\w+/gi, "");
      // Remove "sale -" common raw prefixes/delimiters
      val = val.replace(/sale\s*-/gi, "");
      // Remove whitespace
      val = val.replace(/\s+/g, " ").trim();
      return val;
    }

    // Price Sanitizer to avoid double ₹₹ symbols and verify raw inputs
    function cleanUrl(url) { if (!url) return ""; let val = String(url).trim(); return val.replace(/t\.me\/DealsHubIndiaa/gi, "t.me/DealsHubIndia"); } function cleanPriceString(pStr) {
      if (!pStr) return "";
      let cleaned = String(pStr).replace(/[₹\s]/g, "").trim();
      return cleaned;
    }

    function renderCard(deal) {
      const cleanPrice = cleanPriceString(deal.price);
      const cleanOriginal = deal.originalPrice ? cleanPriceString(deal.originalPrice) : "";

      const priceStr = cleanPrice ? "₹" + cleanPrice : "Check Price";
      const origStr = cleanOriginal
        ? `<span class="hd-card__price-orig">₹${cleanOriginal}</span>`
        : "";

      const link = cleanUrl(deal.link || deal.url || "#");
      const cat = deal.category || "deal";
      const catLabel = cat.toUpperCase();
      const isLoot = String(deal.isLoot) === "true";
      
      const pricePlain = cleanPrice.replace(/[^0-9]/g, "");
      const originalPlain = cleanOriginal.replace(/[^0-9]/g, "");
      
      const sellingNum = parseFloat(pricePlain) || 0;
      const originalNum = parseFloat(originalPlain) || 0;
      let discountPill = "";
      if (originalNum > 0 && sellingNum > 0 && originalNum > sellingNum) {
        const pct = Math.round(((originalNum - sellingNum) / originalNum) * 100);
        if (pct > 10) {
          discountPill = `<span class="hd-card__discount-pill">${pct}% OFF</span>`;
        }
      }

      const imgHtml = deal.image 
        ? `<div class="hd-card__image-container"><img src="${deal.image}" alt="" loading="lazy" class="hd-card__image" /></div>` 
        : "";

      const cleanedTitleText = cleanTitle(deal.title || "");

      return `<div class="deal-card-wrapper"
          data-title="${cleanedTitleText.toLowerCase().replace(/"/g, "&quot;")}"
          data-category="${cat}"
          data-price="${pricePlain}"
          data-is-loot="${isLoot}">
        <div class="home-deal-card${isLoot ? " home-deal-card--loot" : ""}">
          <div class="hd-card__header">
            <div class="hd-card__merchant-tag">
              <span class="hd-card__merchant-badge">${(deal.platform || "STORE").toUpperCase()}</span>
              <span class="hd-card__cat-badge">${catLabel}</span>
            </div>
            <span class="hd-card__time">LIVE</span>
          </div>
          <div class="hd-card__content">
            ${imgHtml}
            <div class="hd-card__details">
              <h3 class="hd-card__title">
                <a href="${link}" target="_blank" rel="noopener noreferrer">${cleanedTitleText}</a>
              </h3>
              <div class="hd-card__price-row">
                <span class="hd-card__price">${priceStr}</span>
                ${origStr}
                ${discountPill}
              </div>
            </div>
          </div>
          <div class="hd-card__actions">
            <a href="${link}" target="_blank" rel="noopener noreferrer" class="hd-card__cta-btn">
              <span>View Deal</span>
            </a>
            <button class="hd-card__share-btn deal-share-btn" data-title="${cleanedTitleText}" data-url="${link}" type="button">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>
              </svg>
            </button>
          </div>
        </div>
      </div>`;
    }

    // Deduplication logic to avoid rendering duplicate items
    function deduplicateDeals(dealsList) {
      const seen = new Set();
      return dealsList.filter(item => {
        // Unique key based on link/url and cleaned title
        const titleKey = cleanTitle(item.title || "").toLowerCase().replace(/\s+/g, "");
        const linkKey = (item.link || item.url || "").trim();
        const dedupeKey = titleKey + "|" + linkKey;
        if (seen.has(dedupeKey)) {
          return false;
        }
        seen.add(dedupeKey);
        return true;
      });
    }

    async function loadDeals() {
      try {
        const res = await fetch("/api/deals");
        const data = await res.json();
        const list = Array.isArray(data) ? data : (data.deals || []);

        const uniqueList = deduplicateDeals(list);

        if (!uniqueList.length) {
          grid.innerHTML = "<p class=\"feed-empty\">No live drops right now. Check back soon!</p>";
          return;
        }

        grid.innerHTML = uniqueList.map(renderCard).join("");
        allWrappers = Array.from(grid.querySelectorAll(".deal-card-wrapper"));

        if (countEl) {
          countEl.textContent = uniqueList.length + " deals";
        }
      } catch (err) {
        console.error("[DealsFeed]", err);
        grid.innerHTML = "<p class=\"feed-empty\">Could not refresh feed. Try reloading.</p>";
      }
    }

    loadDeals();

    // Event listener for search events
    window.addEventListener("deals-search", (e) => {
      const query = (e.detail.query || "").toLowerCase().trim();
      let visible = 0;
      allWrappers.forEach(w => {
        const title = w.getAttribute("data-title") || "";
        const show = !query || title.includes(query);
        w.classList.toggle("is-hidden", !show);
        if (show) visible++;
      });
      if (noResults) noResults.style.display = (query && visible === 0) ? "block" : "none";
    });

    // Event listener for categories
    window.addEventListener("deals-category", (e) => {
      const cat = e.detail.category;
      let visible = 0;
      allWrappers.forEach(w => {
        const itemCat = w.getAttribute("data-category") || "";
        const itemPrice = parseInt(w.getAttribute("data-price") || "0", 10);
        const itemIsLoot = w.getAttribute("data-is-loot") === "true";

        let show = false;
        if (cat === "all") show = true;
        else if (cat === "tech" && itemCat === "tech") show = true;
        else if (cat === "fashion" && itemCat === "fashion") show = true;
        else if (cat === "home" && itemCat === "home") show = true;
        else if (cat === "under-99" && itemPrice > 0 && itemPrice < 99) show = true;
        else if (cat === "loots" && itemIsLoot) show = true;

        w.classList.toggle("is-hidden", !show);
        if (show) visible++;
      });
      if (noResults) noResults.style.display = (visible === 0) ? "block" : "none";
    });
  })();
</script>

<style>
  .deals-section {
    padding-top: var(--spacing-3);
  }

  .deals-section__header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: var(--spacing-2);
  }

  .section-label {
    font-size: 16px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.2px;
    color: var(--text-primary);
    margin: 0;
  }

  .section-count {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-secondary);
    background-color: var(--surface-color-hover);
    border: 1px solid var(--border-color);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .deals-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  @media (min-width: 600px) {
    .deals-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .deals-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .seo-deals {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  #main-content {
    padding-bottom: var(--spacing-5);
  }
</style>
