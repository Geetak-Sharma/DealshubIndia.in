---
export const prerender = false;
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import StructuredData from '../components/StructuredData.astro';
import LiveStatBar from '../components/home/LiveStatBar.astro';
import HomeDealCard from '../components/home/HomeDealCard.astro';
import CommunityJoinSection from '../components/home/CommunityJoinSection.astro';
import SiteFooter from '../components/SiteFooter.astro';

// Fetch static deals for SSR / SEO
const deals = await getCollection('deals');
deals.sort((a, b) => {
  const da = a.data.date instanceof Date ? a.data.date.getTime() : 0;
  const db = b.data.date instanceof Date ? b.data.date.getTime() : 0;
  return db - da;
});
---

<BaseLayout title="DealshubIndia.in — Best Deals & Offers in India Today">
  <StickyHeader />

  <main id="main-content">

    <!-- ===== HERO ===== -->
    <section class="home-hero" aria-labelledby="hero-heading">
      <div class="l-container hero-inner">
        <div class="hero-stat">
          <LiveStatBar />
        </div>
        <h1 class="hero-heading" id="hero-heading">
          Best Deals &amp; Offers<br />
          <span class="hero-heading__accent">in India</span>
        </h1>
        <p class="hero-sub">
          Handpicked price drops from Amazon, Flipkart &amp; more — verified by our community since 2018.
        </p>
      </div>
    </section>

    <!-- ===== DEAL FEED ===== -->
    <div class="l-container">
      <section class="deals-section" aria-labelledby="deals-heading">

        <div class="deals-section__header">
          <h2 class="section-label" id="deals-heading">Latest Drops</h2>
          <span class="section-count" id="deals-count" aria-live="polite"></span>
        </div>

        <!-- No-results state (shown by JS when search/filter yields nothing) -->
        <div id="no-search-results" class="no-results" style="display:none" role="status">
          <p>No deals match your filter. Try another category or clear the search.</p>
        </div>

        <!-- Live deal grid — hydrated client-side -->
        <div id="deals-grid" class="deals-grid" aria-label="Live deals">
          <!-- Loading skeleton -->
          <div class="deal-skeleton"></div>
          <div class="deal-skeleton"></div>
          <div class="deal-skeleton"></div>
          <div class="deal-skeleton"></div>
          <div class="deal-skeleton"></div>
          <div class="deal-skeleton"></div>
        </div>

        <!-- SSR content for search engines (visually hidden, semantically present) -->
        {deals.length > 0 && (
          <div class="seo-deals" aria-hidden="true" tabindex="-1">
            {deals.map(deal => (
              <HomeDealCard
                title={deal.data.title}
                price={deal.data.price}
                originalPrice={deal.data.originalPrice}
                link={deal.data.link}
                category={deal.data.category}
                isLoot={deal.data.isLoot}
              />
            ))}
          </div>
        )}
      </section>

      <!-- ===== COMMUNITY ===== -->
      <CommunityJoinSection />
    </div>
  </main>

  <!-- ===== FOOTER ===== -->
  <SiteFooter />

  <FloatingWhatsApp />
  <StructuredData deals={deals} />
</BaseLayout>

<!-- Deal feed fetch + filter logic -->
<script is:inline>
  (function () {
    const grid = document.getElementById('deals-grid');
    const countEl = document.getElementById('deals-count');
    const noResults = document.getElementById('no-search-results');
    let allWrappers = [];

    /* ---- Render deal card ---- */
    function renderCard(deal) {
      const priceStr = deal.price && deal.price !== 'Check Price'
        ? '&#8377;' + deal.price
        : 'Check Price';
      const origStr = deal.originalPrice
        ? `<span class="dc__price-orig">&#8377;${deal.originalPrice}</span>`
        : '';
      const link = deal.link || deal.url || '#';
      const cat = deal.category || 'deal';
      const catLabel = cat.charAt(0).toUpperCase() + cat.slice(1);
      const isLoot = String(deal.isLoot) === 'true';
      const pricePlain = deal.price ? String(deal.price).replace(/[^0-9]/g, '') : '0';

      return `<div class="deal-card-wrapper"
          data-title="${(deal.title || '').toLowerCase().replace(/"/g, '&quot;')}"
          data-category="${cat}"
          data-price="${pricePlain}"
          data-is-loot="${isLoot}">
        <div class="dc">
          <span class="dc__badge${isLoot ? ' dc__badge--loot' : ''}">${catLabel}</span>
          <h3 class="dc__title">${deal.title || ''}</h3>
          <div class="dc__price-row">
            <span class="dc__price">${priceStr}</span>
            ${origStr}
          </div>
          <a href="${link}" target="_blank" rel="noopener noreferrer" class="dc__cta">View Deal</a>
        </div>
      </div>`;
    }

    /* ---- Load deals ---- */
    async function loadDeals() {
      try {
        const res = await fetch('/api/deals');
        const data = await res.json();
        const list = Array.isArray(data) ? data : (data.deals || []);

        if (!list.length) {
          grid.innerHTML = '<p class="feed-empty">No live deals at the moment. Check back soon!</p>';
          return;
        }

        grid.innerHTML = list.map(renderCard).join('');
        allWrappers = Array.from(grid.querySelectorAll('.deal-card-wrapper'));

        if (countEl) {
          countEl.textContent = list.length + ' deals';
        }
      } catch (err) {
        console.error('[DealsFeed]', err);
        grid.innerHTML = '<p class="feed-empty">Could not load deals. Please refresh the page.</p>';
      }
    }

    loadDeals();

    /* ---- Search filter ---- */
    window.addEventListener('deals-search', (e) => {
      const query = (e.detail.query || '').toLowerCase().trim();
      let visible = 0;
      allWrappers.forEach(w => {
        const title = w.getAttribute('data-title') || '';
        const show = !query || title.includes(query);
        w.classList.toggle('is-hidden', !show);
        if (show) visible++;
      });
      if (noResults) noResults.style.display = (query && visible === 0) ? 'block' : 'none';
    });

    /* ---- Category filter ---- */
    window.addEventListener('deals-category', (e) => {
      const cat = e.detail.category;
      let visible = 0;
      allWrappers.forEach(w => {
        const itemCat = w.getAttribute('data-category') || '';
        const itemPrice = parseInt(w.getAttribute('data-price') || '0', 10);
        const itemIsLoot = w.getAttribute('data-is-loot') === 'true';

        let show = false;
        if (cat === 'all') show = true;
        else if (cat === 'tech' && itemCat === 'tech') show = true;
        else if (cat === 'fashion' && itemCat === 'fashion') show = true;
        else if (cat === 'home' && itemCat === 'home') show = true;
        else if (cat === 'under-99' && itemPrice > 0 && itemPrice < 99) show = true;
        else if (cat === 'loots' && itemIsLoot) show = true;

        w.classList.toggle('is-hidden', !show);
        if (show) visible++;
      });

      if (noResults) noResults.style.display = (visible === 0) ? 'block' : 'none';
    });
  })();
</script>

<style>
  /* ===== HERO ===== */
  .home-hero {
    padding: var(--spacing-5) 0 var(--spacing-4);
    border-bottom: 1px solid var(--border-color);
    margin-bottom: var(--spacing-4);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-2);
  }

  .hero-stat {
    margin-bottom: 4px;
  }

  .hero-heading {
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    font-weight: 900;
    line-height: 1.15;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.5px;
  }

  .hero-heading__accent {
    color: var(--primary-color);
  }

  .hero-sub {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.55;
    max-width: 520px;
    margin: 0;
  }

  /* ===== DEAL FEED ===== */
  .deals-section {
    padding-top: var(--spacing-2);
  }

  .deals-section__header {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: var(--spacing-3);
  }

  .section-label {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0;
  }

  .section-count {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--surface-color-hover);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    padding: 1px 9px;
  }

  /* ===== DEAL GRID ===== */
  .deals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
    min-height: 200px;
  }

  @media (max-width: 480px) {
    .deals-grid {
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }
  }

  /* ===== SEO DEALS (hidden from users) ===== */
  .seo-deals {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ===== MAIN ===== */
  #main-content {
    padding-bottom: var(--spacing-6);
  }
</style>
