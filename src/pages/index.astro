---
export const prerender = false;
import fs from 'node:fs/promises';
import { getCollection } from 'astro:content';
import { TelegramDataStore } from '../lib/telegramStore.js';
import { extractCoupon, extractBankOffer, extractVariants, getBudgetTier } from '../lib/dealNormalizer.js';
import Layout from '../layouts/Layout.astro';
import LootTicker from '../components/LootTicker.astro';
import Header from '../components/Header.astro';
import EditorialHero from '../components/EditorialHero.astro';
import EditorialDealCard from '../components/EditorialDealCard.astro';
import BlogCard from '../components/BlogCard.astro';
import Footer from '../components/Footer.astro';

// 1. Fetch content collection deals
let contentDeals: any[] = [];
try {
  contentDeals = await getCollection('deals');
} catch (e) {
  console.warn('[Home] Content deals error:', e);
}

// 2. Fetch fresh deals from telegram_posts.json (via TelegramDataStore)
let rawDeals: any[] = [];
try {
  const storeData = TelegramDataStore.load();
  if (storeData && Array.isArray(storeData.posts) && storeData.posts.length > 0) {
    rawDeals = storeData.posts;
  } else {
    const tgURL = new URL('../data/telegram_posts.json', import.meta.url);
    const tgData = await fs.readFile(tgURL, 'utf-8');
    const parsed = JSON.parse(tgData);
    rawDeals = parsed.posts || [];
  }
} catch (e) {
  console.warn('[Home] Could not load telegram_posts.json, trying deals_cache.json fallback:', e);
  try {
    const cacheURL = new URL('../data/deals_cache.json', import.meta.url);
    const cacheData = await fs.readFile(cacheURL, 'utf-8');
    const parsed = JSON.parse(cacheData);
    rawDeals = parsed.deals || [];
  } catch (err) {
    console.warn('[Home] Could not load deals_cache.json fallback:', err);
  }
}

// Ensure deals are sorted by timestamp descending (newest first)
rawDeals.sort((a: any, b: any) => (b.timestamp || 0) - (a.timestamp || 0));

// 3. Normalize deals with proper merchant, price, and clean product title extraction
const normalizedDeals = rawDeals
  .map((item: any) => {
    let rawTitle = (item.title || "").replace(/[\u200e\u200f\u200b\uFEFF]/g, "").trim();
    let merchant = item.platform || "Amazon";

    // Clean title: remove emojis, hashtags, spam suffixes, store prefixes
    let title = rawTitle
      .replace(/^[\p{Emoji}\s]+/gu, "")
      .replace(/#\w+/gi, "")
      .replace(/^(?:amazon|flipkart|myntra|ajio|croma|meesho)\s*[:|\-–]\s*/i, "")
      .replace(/sale\s*-/gi, "")
      .replace(/cashback card on all online transactions-?/gi, "")
      .replace(/for under 99 deals join-?.*/gi, "")
      .replace(/under 99 deals join-?.*/gi, "")
      .replace(/_______________________________.*/gi, "")
      .replace(/Master Link\s*:?.*/gi, "")
      .replace(/\s*\.?\s*Apply\s*(?:₹\s*\d+|\d+%)\s*Off\s*Coupon.*$/i, "")
      .replace(/\s*(?:@|at\s*|Rs\.?\s*|₹)\s*[0-9,]+\s*$/i, "")
      .replace(/[:\.\-\s|–]+$/, "")
      .trim();

    if (title.includes("\n")) {
      title = title.split("\n")[0].trim();
    }

    // Smart merchant detection
    const fullText = `${item.checkoutUrl || ''} ${item.url || ''} ${rawTitle} ${item.text || ''}`.toLowerCase();
    if (fullText.includes("amazon") || fullText.includes("amazn") || fullText.includes("amzn")) merchant = "Amazon";
    else if (fullText.includes("flipkart") || fullText.includes("fkrt")) merchant = "Flipkart";
    else if (fullText.includes("myntra") || fullText.includes("myntr")) merchant = "Myntra";
    else if (fullText.includes("ajio") || fullText.includes("ajiio")) merchant = "Ajio";
    else if (fullText.includes("croma")) merchant = "Croma";
    else if (fullText.includes("meesho")) merchant = "Meesho";
    else if (fullText.includes("tatacliq")) merchant = "Tata CLiQ";
    else if (merchant === "Deal") merchant = "Amazon";

    // Price extraction: match @123, at 123, ₹123, Rs. 123
    let price = item.price;
    const priceMatch = rawTitle.match(/(?:@|at\s*|₹|Rs\.?\s*)([0-9,]+)/i);
    if ((!price || price === "Check Price") && priceMatch) {
      price = priceMatch[1].replace(/,/g, "");
    } else if (!price || price === "Check Price") {
      price = item.priceNum && item.priceNum > 0 ? String(item.priceNum) : "Check Price";
    }

    // Discount extraction: match 34% Off, etc.
    let discount = item.discount || "";
    if (!discount) {
      const discountMatch = rawTitle.match(/(\d+)%\s*(?:off|discount|coupon)/i) || (item.text || "").match(/(\d+)%\s*(?:off|discount|coupon)/i);
      if (discountMatch) {
        discount = `${discountMatch[1]}%`;
      }
    }

    const numPrice = parseFloat(String(price).replace(/[^0-9.]/g, "")) || 0;
    const discPct = parseInt(discount) || 0;
    let originalPrice = item.originalPrice;
    if (!originalPrice && numPrice > 0 && discPct > 0 && discPct < 100) {
      originalPrice = String(Math.round(numPrice / (1 - discPct / 100)));
    }

    // Category detection
    let category = item.category || "General";
    const lowerCheck = `${rawTitle} ${item.text || ''} ${category}`.toLowerCase();
    if (lowerCheck.match(/laptop|phone|smartphone|smartwatch|earbuds|headphones|mouse|keyboard|cpu|gpu|storage|ram|gadget|charger|geyser|fan|electronics|heater|cooler/)) {
      category = "Tech";
    } else if (lowerCheck.match(/shirt|jeans|clothing|shoes|t-shirt|kurta|dress|jacket|pants|sneakers|apparel|footwear/)) {
      category = "Fashion";
    } else if (lowerCheck.match(/bedsheet|cooker|bottle|kitchen|home|curtain|mop|light|decor|pillow|pan|induction/)) {
      category = "Home";
    } else if (item.isLoot) {
      category = "Loot";
    }

    // 4 Visual Format Upgrades: Coupon, Bank Offer, Variants & Budget Tagging
    const couponText = extractCoupon(rawTitle, item.text);
    const bankOffer = extractBankOffer(rawTitle, item.text);
    const variants = extractVariants(item, item.checkoutUrl || item.url);
    const budgetTier = getBudgetTier(numPrice);

    return {
      id: item.id || `deal-${Math.random().toString(36).substring(7)}`,
      title,
      price,
      numPrice,
      originalPrice: originalPrice || (item.originalPriceNum ? String(item.originalPriceNum) : ""),
      discount,
      discPct,
      link: item.checkoutUrl || item.url || "#",
      image: item.image || "",
      merchant,
      category,
      isLoot: Boolean(item.isLoot || lowerCheck.includes("loot") || discPct >= 60 || budgetTier === 'under99'),
      date: item.timestamp ? new Date(item.timestamp) : new Date(),
      couponText,
      bankOffer,
      variants,
      budgetTier,
    };
  })
  .filter((d: any) =>
    d.title &&
    d.title.length >= 6 &&
    !d.title.toLowerCase().startsWith("apply ") &&
    d.image &&
    typeof d.image === "string" &&
    d.image.startsWith("http") &&
    !d.image.includes("example.com") &&
    !d.image.includes("Telegram_logo") &&
    d.numPrice > 0
  );

// Helper to ensure deal images are valid, real URLs
const isValidDealImage = (img: any): boolean => {
  return Boolean(
    img &&
    typeof img === "string" &&
    img.startsWith("http") &&
    !img.includes("example.com") &&
    !img.includes("Telegram_logo")
  );
};

// Map content collection deals
const mappedContentDeals = contentDeals
  .map((d: any) => {
    const numPrice = parseFloat(String(d.data.price).replace(/[^0-9.]/g, "")) || 0;
    const numOriginal = parseFloat(String(d.data.originalPrice || "").replace(/[^0-9.]/g, "")) || 0;
    let discount = "";
    let discPct = 0;
    if (numOriginal > numPrice && numPrice > 0) {
      discPct = Math.round(((numOriginal - numPrice) / numOriginal) * 100);
      discount = `${discPct}%`;
    }

    return {
      id: d.id,
      title: d.data.title,
      price: d.data.price,
      numPrice,
      originalPrice: d.data.originalPrice || "",
      discount,
      discPct,
      link: d.data.link,
      image: d.data.image,
      merchant: "Amazon",
      category: d.data.category || "Tech",
      isLoot: d.data.isLoot,
      date: d.data.date,
      budgetTier: getBudgetTier(numPrice),
    };
  })
  .filter((d: any) =>
    d.title &&
    isValidDealImage(d.image) &&
    d.numPrice > 0
  );

// Combine deals: fresh live telegram deals first
const allDeals = [...normalizedDeals, ...mappedContentDeals];

// Curate top 8 Handpicked Drops for Today's Live Deals (2 rows = 8 deals):
// Ensure ANY deal curated for the homepage MUST have a valid, verified image
const editorialDeals = [...allDeals]
  .filter((d: any) => isValidDealImage(d.image))
  .sort((a, b) => {
    const timeA = new Date(a.date).getTime() || 0;
    const timeB = new Date(b.date).getTime() || 0;
    // Always prioritize the freshest deals posted today (newest first)
    return timeB - timeA;
  })
  .slice(0, 8);

// 4. Fetch curated top featured field guides & shopping hacks
let featuredGuides: any[] = [];
try {
  const rawPosts = await getCollection('blog');
  
  const curatedDefinitions = [
    {
      slug: 'amazon-prime-day-vs-flipkart-goat-sale-2026',
      badge: 'SALE PLAYBOOK',
      readingTime: '5 min read',
    },
    {
      slug: 'sbi-cashback-credit-card',
      badge: '5% CASHBACK HACK',
      readingTime: '4 min read',
    },
    {
      slug: 'how-to-spot-fake-sales',
      badge: 'FIELD MANUAL',
      readingTime: '5 min read',
    },
  ];

  featuredGuides = curatedDefinitions
    .map((curated) => {
      const post = rawPosts.find((p) => {
        const cleanId = p.id.replace(/\.md$/, '').replace(/\\/g, '/');
        return cleanId === curated.slug || cleanId.endsWith(curated.slug);
      });
      if (!post) return null;

      return {
        ...post,
        readingTime: curated.readingTime,
        editorialBadge: curated.badge,
        cleanUrl: `/blog/${post.id.replace(/\.md$/, '').replace(/\\/g, '/')}`,
      };
    })
    .filter(Boolean);

  // Fallback if any missing
  if (featuredGuides.length < 3) {
    const existingIds = new Set(featuredGuides.map((g) => g.id));
    const remaining = rawPosts
      .filter((p) => !existingIds.has(p.id))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    for (const post of remaining) {
      if (featuredGuides.length >= 3) break;
      const wordCount = post.body ? post.body.trim().split(/\s+/).length : 800;
      const readingMinutes = Math.max(3, Math.ceil(wordCount / 220));
      featuredGuides.push({
        ...post,
        readingTime: `${readingMinutes} min read`,
        editorialBadge: 'EDITORIAL GUIDE',
        cleanUrl: `/blog/${post.id.replace(/\.md$/, '').replace(/\\/g, '/')}`,
      });
    }
  }
} catch (e) {
  console.warn('[Home] Blog fetch error:', e);
}

const pageTitle = "DealsHub India — Hand-Verified Curated Deals & Price Errors";
const pageDescription = "Bespoke editorial deal intelligence. Automated scrapers track 200+ drops daily across Amazon & Flipkart. We filter out the noise and publish lowest-ever price drops.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  includeHeader={true}
  includeFooter={true}
  deals={editorialDeals}
  activePath="/"
>
  <!-- 1. Top Announcement Marquee -->
  

  <!-- 2. Sticky Glass Header -->
  

  <main id="main-content" class="w-full">
    
    <!-- 3. Editorial Hero Removed -->

    <!-- Section 1 (TOP): Curated Shopping Guides & Sale Playbooks (/blog) -->
    

    <!-- Section 2 (DIRECTLY NEXT/BELOW): Today's Live Deals (2 rows = 8 deals) -->
    <section id="deals" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 border-t border-white/10">
      
      <!-- Clean Editorial Section Header -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 pb-4 border-b border-white/10">
        <div>
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono font-bold uppercase tracking-wider mb-2">
            <span>EDITORIAL SHORTLIST</span>
          </div>
          <div class="flex items-center gap-3">
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-100 tracking-tight">Today's Live Deals</h2>
            <span class="pulse-indicator"></span>
          </div>
          <p class="text-xs sm:text-sm text-slate-300 mt-1.5 font-normal">
            Slashed MRP vs verified deal price. Hand-filtered from 200+ raw daily drops.
          </p>
        </div>

        <div class="shrink-0">
          <a
            href="/livedeals"
            class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-[#1A202C] hover:bg-[#222938] border border-white/10 hover:border-emerald-500/50 text-slate-200 hover:text-emerald-300 text-xs sm:text-sm font-bold transition-all shadow-sm group"
          >
            <span>Browse All 200+ Live Deals →</span>
          </a>
        </div>
      </div>

      <!-- Curated Drops 2-Row Grid (Clean Horizontal Cards on Desktop) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
        {editorialDeals.map((deal, idx) => (
          <EditorialDealCard
            id={deal.id}
            title={deal.title}
            price={deal.price}
            originalPrice={deal.originalPrice}
            discount={deal.discount}
            link={deal.link}
            image={deal.image}
            merchant={deal.merchant}
            category={deal.category}
            isLoot={deal.isLoot}
            date={deal.date}
            index={idx}
            couponText={deal.couponText}
            bankOffer={deal.bankOffer}
            variants={deal.variants}
            budgetTier={deal.budgetTier}
          />
        ))}
      </div>

      <!-- Live Stream Banner removed -->

    </section>

    {featuredGuides.length > 0 && (
      <section id="shopping-guides" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 border-t border-white/10">
        
        <!-- Clean Wirecutter Editorial Header -->
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 pb-4 border-b border-white/10">
          <div>
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono font-bold uppercase tracking-wider mb-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>EDITOR'S FIELD GUIDES &amp; SHOPPING HACKS</span>
            </div>
            <div class="flex items-center gap-3">
              <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-100 tracking-tight">
                📚 Curated Shopping Guides &amp; Sale Playbooks
              </h2>
            </div>
            <p class="text-xs sm:text-sm text-slate-300 mt-1.5 font-normal max-w-2xl">
              Wire-tested shopping strategies, card cashback stacking, and price-error playbooks from DealsHub editors. Tested before you buy.
            </p>
          </div>

          <div class="shrink-0">
            <a
              href="/blog"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#1A202C] hover:bg-[#222938] border border-white/10 hover:border-emerald-500/50 text-slate-200 hover:text-emerald-300 text-xs sm:text-sm font-bold transition-all shadow-sm group"
            >
              <span>Explore All Guides &amp; Insights (/blog)</span>
              <span class="text-emerald-400 group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>
        </div>

        <!-- 3 Featured Field Guide Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {featuredGuides.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              author={post.data.author || "DealsHub Editorial"}
              image={post.data.image}
              url={post.cleanUrl}
              category={post.data.category}
              readingTime={post.readingTime}
              editorialBadge={post.editorialBadge}
            />
          ))}
        </div>
      </section>
    )}

  </main>

  <!-- 7. Master Clean Footer -->
  
</Layout>

