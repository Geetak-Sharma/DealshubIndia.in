---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
---

<Layout title="Affiliate Link Engine — Personal Station" description="Private affiliate tool" includeHeader={false} includeFooter={false}>

    <!-- Top Minimal Header -->
    <header class="border-b border-white/5 py-3 px-4 sm:px-8 bg-[#090c12]/90 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-lg bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center font-bold text-emerald-400 text-xs">DH</div>
        <span class="font-black text-sm tracking-tight text-white">DealsHub <span class="text-emerald-400 font-mono text-xs px-1.5 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20">AFFILIATOR</span></span>
      </div>
      <div class="flex items-center gap-2 text-xs font-mono text-slate-400">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="hidden sm:inline">100% Client-Side Engine</span>
      </div>
    </header>

    <!-- Main Tool Container -->
    <main class="flex-1 max-w-2xl"w-full mx-auto px-4 py-6 sm:py-10 flex flex-col justify-center">
      <div class="glass rounded-3xl p-5 sm:p-8 shadow-2xl relative overflow-hidden">
        <div class="mb-6">
          <h1 class="text-xl sm:text-2xl font-black text-white tracking-tight flex items-center gap-2">
            Instant Link Affiliator
          </h1>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">
            Convert any Amazon, Flipkart, or product url into your personal affiliate link automatically.
          </p>
        </div>

        <!-- Input Area -->
        <div class="relative mb-4">
          <label for="raw-input" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5 font-mono">
            Input URL or Raw Deal Text
          </label>
          <textarea
            id="raw-input"
            rows="3"
            placeholder="Paste link here (e.g. https://www.amazon.in/dp/B0BD9BF14B... or full message)"
            class="w-full glass-input rounded-2xl p-3.5 text-xs sm:text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none transition-all font-mono resize-none"></textarea>
          <div class="flex items-center justify-between mt-2">
            <button id="paste-btn" type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 text-xs font-semibold border border-white/10 transition-colors active:scale-95">
              <span>📓</span> Paste Clipboard
            </button>
            <button id="clear-btn" type="button" class="text-xs text-slate-400 hover:text-rose-400 transition-colors">Clear</button>
          </div>
        </div>

        <!-- Mandatory Tag Config -->
        <div class="mb-6 p-3 rounded-2xl bg-white/[0.03] border border-white/5">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 text-xs font-mono text-slate-300 font-semibold">
              <span>☙️</span> Amazon Mandatory Tag:
              <span class="text-emerald-400 font-bold" id="active-tag-display">earnKaro09e_103755-21</span>
            </div>
            <button type="button" class="text-xs text-emerald-400 hover:underline font-mono" id="edit-tag-toggle">Edit</button>
          </div>
          <div id="tag-edit-row" class="hidden mt-3 pt-3 border-t border-white/5 flex gap-2">
            <input
              type="text"
              id="custom-tag-input"
              value="earnkaro09e_103755-21"
              class="flex-1 glass-input rounded-xl px-3 py-1.5 text-x{ text-slate-100 font-mono focus:outline-none"
              placeholder="e.g. earnkaro09e_103755-21"
            />
            <button id="save-tag-btn" type="button" class="px-3 py-1.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold rounded-xl transition-colors">Save</button>
          </div>
        </div>

        <!-- Output Area -->
        <div id="output-card" class="transition-all duration-300">
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 font-mono flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span> Generated Affiliate Link
            </span>
            <span id="platform-pill" class="text-[11px] font-bold font-mono px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-300 border border-amber-500/20">Amazon</span>
          </div>
          <div class="relative mb-4">
            <input
              type="text"
              id="output-url"
              readonly
              value=""
              class="w-full glass-input rounded-2xl p-3.5 pr-20 text-xs sm:text-sm font-mono text-emerald-300 border-emerald-500/30 focus:outline-none select-all"
            />
            <button
              id="copy-inline-btn"
              type="button"
              class="absolute right-2 top-2 bottom-2 px-3 rounded-xl bg-emerald-500/20 hover:bg-emerald-500 text-emerald-300 hover:text-slate-950 border border-emerald-500/40 text-xs font-bold transition-all active:scale-95 flex items-center gap-1"
            >
              <span>📓</span> Copy
            </button>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <button
              id="whatsapp-share-btn"
              type="button"
              class="w-full py-3.5 px-4 rounded-2xl bg-[#25D366] hover:bg-[#20ba59] text-slate-950 font-black text-xs sm:text-sm flex items-center justify-center gap-2 transition-all shadow-lg shadow-[#25D366]/20 active:scale-98">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.010-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
              <span>Share on WhatsApp</span>
            </button>
            <button
              id="test-open-btn"
              type="button"
              class="w-full py-3.5 px-4 rounded-2xl bg-white/10 hover:bg-white/15 text-white font-bold text-xs sm:text-sm flex items-center justify-center gap-2 border border-white/10 transition-all active:scale-98">
              <span>↗</span><span>Open in New Tab</span>
            </button>
          </div>
        </div>
        <div id="toast" class="hidden fixed bottom-6 right-6 px-4 py-2.5 rounded-2xl bg-emerald-500 text-slate-950 font-bold text-xs shadow-2xl flex items-center gap-2 z-50 transition-all">
          <span>✓</span><span id="toast-msg">Copied to clipboard!</span>
        </div>
      </div>
      <div class="mt-6 text-center text-xs text-slate-500 font-mono">
        Private Utility | 100% Client-Side Engine | Hidden Route
      </div>
    </main>
    <footer class="py-3 text-center text-[11px] text-slate-600 font-mono">DealsHub Personal Station</footer>

    <script is:inline>
      (function() {
        const DEFAULT_AMAZON_TAG = "earnKaro09e_103755-21";
        let amazonTag = localStorage.getItem("dh_aff_amazon_tag") || DEFAULT_AMAZON_TAG;

        const rawInput = document.getElementById("raw-input");
        const outputUrl = document.getElementById("output-url");
        const platformPill = document.getElementById("platform-pill");
        const pasteBtn = document.getElementById("paste-btn");
        const clearBtn = document.getElementById("clear-btn");
        const copyInlineBtn = document.getElementById("copy-inline-btn");
        const whatsappBtn = document.getElementById("whatsapp-share-btn");
        const testOpenBtn = document.getElementById("test-open-btn");
        const activeTagDisplay = document.getElementById("active-tag-display");
        const editTagToggle = document.getElementById("edit-tag-toggle");
        const tagEditRow = document.getElementById("tag-edit-row");
        const customTagInput = document.getElementById("custom-tag-input");
        const saveTagBtn = document.getElementById("save-tag-btn");
        const toast = document.getElementById("toast");
        const toastMsg = document.getElementById("toast-msg");

        activeTagDisplay.textContent = amazonTag;
        customTagInput.value = amazonTag;

        function showToast(msg) {
          toastMsg.textContent = msg;
          toast.classList.remove("hidden");
          setTimeout(() => toast.classList.add("hidden"), 2200);
        }

        editTagToggle.addEventListener("click", () => {
          tagEditRow.classList.toggle("hidden");
        });

        saveTagBtn.addEventListener("click", () => {
          const val = customTagInput.value.trim();
          if (val) {
            amazonTag = val;
            localStorage.setItem("dh_aff_amazon_tag", amazonTag);
            activeTagDisplay.textContent = amazonTag;
            tagEditRow.classList.add("hidden");
            processInput();
            showToast("Affiliate Tag Saved!");
          }
        });

        function extractUrl(text) {
          if (!text) return "";
          const m = text.match(/https?:\/\/[^\ss\"\'\<\>]+/i);
          return m ? m[0] : text.trim();
        }

        function affiliateUrl(input) {
          const target = extractUrl(input);
          if (!target || !target.startsWith("http")) {
            return { url: target, platform: "Unknown" };
          }

          try {
            const parsed = new URL(target);
            const host = parsed.hostname.toLowerCase();

            if (host.includes("amazon.") || host.includes("amzn.") || host.includes("amazn.")) {
              const stripKeys = ["tag", "ascsubtag", "linkCode", "ref", "ref_", "creative", "creativeASIN"];
              stripKeys.forEach((k) => parsed.searchParams.delete(k));
              parsed.searchParams.set("tag", amazonTag);
              return { url: parsed.toString(), platform: "Amazon" };
            }

            if (host.includes("flipkart.") || host.includes("fkrt.it") || host.includes("fkrt.co")) {
              parsed.searchParams.set("affid", "earnKaro09");
              return { url: parsed.toString(), platform: "Flipkart" };
            }

            if (host.includes("myntra.")) {
              return { url: parsed.toString(), platform: "Myntra" };
            }

            if (host.includes("ajio.")) {
              return { url: parsed.toString(), platform: "Ajio" };
            }

            return { url: target, platform: "Direct URL" };
          } catch (e) {
            return { url: target, platform: "Raw Link" };
          }
        }

        function processInput() {
          const val = rawInput.value.trim();
          if (!val) {
            outputUrl.value = "";
            platformPill.textContent = "Waiting for link";
            return;
          }

          const res = affiliateUrl(val);
          outputUrl.value = res.url;
          platformPill.textContent = res.platform;
        }

        rawInput.addEventListener("input", processInput);

        pasteBtn.addEventListener("click", async () => {
          try {
            const text = await navigator.clipboard.readText();
            if (text) {
              rawInput.value = text;
              processInput();
              showToast("Pasted from Clipboard!");
            }
          } catch (e) {
            rawInput.focus();
          }
        });

        clearBtn.addEventListener("click", () => {
          rawInput.value = "";
          outputUrl.value = "";
          platformPill.textContent = "Cleared";
          rawInput.focus();
        });

        copyInlineBtn.addEventListener("click", async () => {
          const url = outputUrl.value.trim();
          if (url) {
            await navigator.clipboard.writeText(url);
            showToast("Affiliate Link Copied!");
          }
        });

        whatsappBtn.addEventListener("click", () => {
          const url = outputUrl.value.trim();
          if (url) {
            const waText = encodeURIComponent("\' Check out this deal:\n" + url);
            window.open("https://api.whatsapp.com/send?text=" + waText, "_blank");
          }
        });

        testOpenBtn.addEventListener("click", () => {
          const url = outputUrl.value.trim();
          if (url) {
            window.open(url, "_blank");
          }
        });

        rawInput.value = 'https://www.amazon.in/dp/B0BD9BF14B?th=1&psc=1&ck';
        processInput();
      })();
    </script>
  
</Layout>
