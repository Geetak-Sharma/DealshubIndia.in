---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
---

<Layout title="Affiliate Link Engine — Personal Station" description="Private affiliate tool" includeHeader={false} includeFooter={false}>
<style is:global>
  #aff-main textarea,
  #aff-main input {
    background-color: #0c1017 !important;
    color: #34d399 !important;
    border-color: rgba(255, 255, 255, 0.12) !important;
  }
  #aff-main textarea:focus,
  #aff-main input:focus {
    border-color: #10b981 !important;
    box-shadow: 0 0 0 1px #10b981 !important;
  }
  #aff-main textarea::placeholder {
    color: #475569 !important;
  }
</style>

<div id="aff-main" class="min-h-screen bg-[#07090e] text-slate-100 flex flex-col justify-between selection:bg-emerald-500 selection:text-slate-950 font-sans">

    <!-- Top Minimal Header -->
    <header class="border-b border-white/5 py-3.5 px-4 sm:px-8 bg-[#090c12]/95 backdrop-blur-md flex items-center justify-between sticky top-0 z-40">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-emerald-500/20 to-teal-500/10 border border-emerald-500/30 flex items-center justify-center font-black text-emerald-400 text-xs shadow-lg shadow-emerald-500/10">DH</div>
        <div class="flex items-center gap-2">
          <span class="font-black text-sm tracking-tight text-white">DealsHub</span>
          <span class="text-emerald-400 font-mono text-[11px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 tracking-wider">AFFILIATOR PRO</span>
        </div>
      </div>
      <div class="flex items-center gap-3 text-xs font-mono text-slate-400">
        <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-300">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="hidden sm:inline font-semibold">ASIN Canonical Resolver</span>
        </div>
      </div>
    </header>

    <!-- Main Tool Container -->
    <main class="flex-1 max-w-2xl w-full mx-auto px-4 py-8 sm:py-12 flex flex-col justify-center">
      <div class="rounded-3xl p-6 sm:p-8 bg-[#0c1017] border border-white/10 shadow-2xl relative overflow-hidden">
        
        <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-white/5 pb-4">
          <div>
            <h1 class="text-xl sm:text-2xl font-black text-white tracking-tight flex items-center gap-2">
              Affiliate Link Generator
            </h1>
            <p class="text-xs text-slate-400 mt-1">
              Strips tracker clutter, extracts ASIN & injects your mandatory affiliate credentials.
            </p>
          </div>
          <div id="unshorten-status" class="hidden text-[11px] font-mono px-2.5 py-1 rounded-lg bg-amber-500/10 text-amber-300 border border-amber-500/20 items-center gap-1.5 self-start sm:self-auto">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
            <span>Resolving shortlink...</span>
          </div>
        </div>

        <!-- Input Area -->
        <div class="relative mb-4">
          <div class="flex items-center justify-between mb-1.5">
            <label for="raw-input" class="block text-xs font-bold uppercase tracking-wider text-slate-400 font-mono">
              Paste Any Product Link or Full Post
            </label>
            <span class="text-[11px] text-slate-500 font-mono">Auto-detects Amazon & Flipkart</span>
          </div>
          
          <textarea
            id="raw-input"
            rows="3"
            placeholder="Paste any link (e.g. amzn.to/..., amazon.in/dp/..., flipkart.com, or raw message)"
            class="w-full rounded-2xl p-3.5 text-xs sm:text-sm text-emerald-300 placeholder:text-slate-600 focus:outline-none transition-all font-mono resize-none border border-white/10 focus:border-emerald-500 shadow-inner"></textarea>
          
          <div class="flex items-center justify-between mt-2.5">
            <button id="paste-btn" type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 text-xs font-semibold border border-white/10 transition-all active:scale-95">
              <span>📋</span> Paste Clipboard
            </button>
            <button id="clear-btn" type="button" class="text-xs font-mono text-slate-400 hover:text-rose-400 transition-colors">Clear</button>
          </div>
        </div>

        <!-- Credentials Settings Accordion -->
        <div class="mb-6 rounded-2xl bg-white/[0.02] border border-white/5 overflow-hidden">
          <div class="p-3.5 flex items-center justify-between cursor-pointer select-none" id="tag-toggle-head">
            <div class="flex items-center gap-2.5 text-xs font-mono text-slate-300">
              <span class="text-emerald-400">🏷️</span>
              <span>Amazon Tag:</span>
              <span class="text-emerald-400 font-bold bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20 font-mono" id="active-tag-display">earnkaro09e_103755-21</span>
            </div>
            <button type="button" class="text-xs text-slate-400 hover:text-emerald-400 font-mono transition-colors" id="edit-tag-toggle">Configure</button>
          </div>
          
          <div id="tag-edit-row" class="hidden p-3.5 pt-0 border-t border-white/5 space-y-3">
            <div>
              <label class="block text-[11px] font-mono text-slate-400 mb-1">Amazon Associates Tag</label>
              <div class="flex gap-2">
                <input
                  type="text"
                  id="custom-tag-input"
                  value="earnkaro09e_103755-21"
                  class="flex-1 rounded-xl px-3 py-1.5 text-xs text-emerald-300 font-mono focus:outline-none border border-white/10"
                  placeholder="e.g. earnkaro09e_103755-21"
                />
                <button id="save-tag-btn" type="button" class="px-3.5 py-1.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-black rounded-xl transition-all active:scale-95">Save</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Output Area -->
        <div id="output-card" class="transition-all duration-300">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 font-mono flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Canonical Affiliate Link
            </span>
            <div class="flex items-center gap-2">
              <span id="asin-pill" class="hidden text-[11px] font-bold font-mono px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/20"></span>
              <span id="platform-pill" class="text-[11px] font-bold font-mono px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-300 border border-amber-500/20">Amazon</span>
            </div>
          </div>

          <div class="relative mb-4">
            <input
              type="text"
              id="output-url"
              readonly
              value=""
              class="w-full rounded-2xl p-3.5 pr-24 text-xs sm:text-sm font-mono text-emerald-300 border border-emerald-500/30 bg-[#0c1017] focus:outline-none select-all shadow-inner"
            />
            <button
              id="copy-inline-btn"
              type="button"
              class="absolute right-2 top-2 bottom-2 px-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-black transition-all active:scale-95 flex items-center gap-1 shadow-md shadow-emerald-500/20"
            >
              <span>📋</span> Copy
            </button>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <button
              id="whatsapp-share-btn"
              type="button"
              class="w-full py-3.5 px-4 rounded-2xl bg-[#25D366] hover:bg-[#20ba59] text-slate-950 font-black text-xs sm:text-sm flex items-center justify-center gap-2 transition-all shadow-lg shadow-[#25D366]/20 active:scale-98">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.010-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
              <span>Share on WhatsApp</span>
            </button>
            <button
              id="test-open-btn"
              type="button"
              class="w-full py-3.5 px-4 rounded-2xl bg-white/10 hover:bg-white/15 text-white font-bold text-xs sm:text-sm flex items-center justify-center gap-2 border border-white/10 transition-all active:scale-98">
              <span>↗</span><span>Open in New Tab</span>
            </button>
          </div>
        </div>

        <!-- Toast Notification -->
        <div id="toast" class="hidden fixed bottom-6 right-6 px-4 py-2.5 rounded-2xl bg-emerald-500 text-slate-950 font-black text-xs shadow-2xl flex items-center gap-2 z-50 transition-all border border-emerald-400">
          <span>✓</span><span id="toast-msg">Copied to clipboard!</span>
        </div>
      </div>

      <!-- Info badges -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-[11px] text-slate-500 font-mono">
        <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Clean ASIN Extraction</span>
        <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Unshorten amzn.to / fkrt.it</span>
        <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Strip Tracker Bloat</span>
      </div>
    </main>

    <footer class="py-3 text-center text-[11px] text-slate-600 font-mono border-t border-white/5">
      DealsHub Personal Station &bull; Private Internal Utility
    </footer>

    <script is:inline>
      (function() {
        const DEFAULT_AMAZON_TAG = "earnkaro09e_103755-21";
        const DEFAULT_FLIPKART_AFFID = "earnkaro09";
        
        let amazonTag = localStorage.getItem("dh_aff_amazon_tag") || DEFAULT_AMAZON_TAG;

        const rawInput = document.getElementById("raw-input");
        const outputUrl = document.getElementById("output-url");
        const platformPill = document.getElementById("platform-pill");
        const asinPill = document.getElementById("asin-pill");
        const pasteBtn = document.getElementById("paste-btn");
        const clearBtn = document.getElementById("clear-btn");
        const copyInlineBtn = document.getElementById("copy-inline-btn");
        const whatsappBtn = document.getElementById("whatsapp-share-btn");
        const testOpenBtn = document.getElementById("test-open-btn");
        const activeTagDisplay = document.getElementById("active-tag-display");
        const editTagToggle = document.getElementById("edit-tag-toggle");
        const tagEditRow = document.getElementById("tag-edit-row");
        const customTagInput = document.getElementById("custom-tag-input");
        const saveTagBtn = document.getElementById("save-tag-btn");
        const unshortenStatus = document.getElementById("unshorten-status");
        const toast = document.getElementById("toast");
        const toastMsg = document.getElementById("toast-msg");

        activeTagDisplay.textContent = amazonTag;
        customTagInput.value = amazonTag;

        function showToast(msg) {
          toastMsg.textContent = msg;
          toast.classList.remove("hidden");
          setTimeout(() => toast.classList.add("hidden"), 2200);
        }

        editTagToggle.addEventListener("click", () => {
          tagEditRow.classList.toggle("hidden");
        });

        saveTagBtn.addEventListener("click", () => {
          const val = customTagInput.value.trim();
          if (val) {
            amazonTag = val;
            localStorage.setItem("dh_aff_amazon_tag", amazonTag);
            activeTagDisplay.textContent = amazonTag;
            tagEditRow.classList.add("hidden");
            processInput();
            showToast("Affiliate Tag Saved!");
          }
        });

        function extractUrl(text) {
          if (!text) return "";
          const m = text.match(/https?:\/\/[^\s"'<>]+/i);
          return m ? m[0] : text.trim();
        }

        function isShortLink(urlStr) {
          if (!urlStr) return false;
          const u = urlStr.toLowerCase();
          return u.includes("amzn.to") || u.includes("amazn.lt") || u.includes("amzn.in") ||
                 u.includes("fkrt.it") || u.includes("fkrt.co") || u.includes("fkrt.cc") ||
                 u.includes("bit.ly") || u.includes("tinyurl.com") || u.includes("dl.flipkart.com");
        }

        function transformAffiliate(rawUrl) {
          if (!rawUrl || !rawUrl.startsWith("http")) {
            return { url: rawUrl, platform: "Unknown", asin: null };
          }

          try {
            const parsed = new URL(rawUrl);
            const host = parsed.hostname.toLowerCase();
            const fullPath = parsed.pathname + parsed.search;

            // 1. Amazon
            if (host.includes("amazon.") || host.includes("amzn.") || host.includes("amazn.")) {
              const asinMatch = fullPath.match(/(?:\/dp\/|\/gp\/product\/|\/gp\/aw\/d\/|\/o\/ASIN\/|ASIN\/)([B0-9A-Z]{10})/i) ||
                                fullPath.match(/\/([B0-9A-Z]{10})(?:[/?#]|$)/i);
              
              const asin = asinMatch ? asinMatch[1].toUpperCase() : null;
              const domain = host.includes("amazon.in") || host.includes("amzn.in") ? "https://www.amazon.in" : parsed.origin;

              if (asin) {
                const params = new URLSearchParams();
                if (parsed.searchParams.get("th") === "1") params.set("th", "1");
                if (parsed.searchParams.get("psc") === "1") params.set("psc", "1");
                if (parsed.searchParams.has("ck")) params.set("ck", "");
                params.set("tag", amazonTag);

                const qs = params.toString() ? "?" + params.toString() : "?tag=" + amazonTag;
                return {
                  url: domain + "/dp/" + asin + qs,
                  platform: "Amazon",
                  asin: asin
                };
              } else {
                const stripList = ["ascsubtag", "linkCode", "ref", "ref_", "creative", "creativeASIN", "pf_rd_r", "pf_rd_p", "pd_rd_r", "pd_rd_w", "pd_rd_wg", "qid", "sr", "keywords"];
                stripList.forEach(k => parsed.searchParams.delete(k));
                parsed.searchParams.set("tag", amazonTag);
                return { url: parsed.toString(), platform: "Amazon", asin: null };
              }
            }

            // 2. Flipkart
            if (host.includes("flipkart.") || host.includes("fkrt.")) {
              const pid = parsed.searchParams.get("pid");
              const lid = parsed.searchParams.get("lid");
              if (parsed.pathname.includes("/p/")) {
                const cleanParams = new URLSearchParams();
                if (pid) cleanParams.set("pid", pid);
                if (lid) cleanParams.set("lid", lid);
                cleanParams.set("affid", DEFAULT_FLIPKART_AFFID);
                const qs = cleanParams.toString() ? "?" + cleanParams.toString() : "";
                return {
                  url: "https://www.flipkart.com" + parsed.pathname + qs,
                  platform: "Flipkart",
                  asin: pid
                };
              } else {
                parsed.searchParams.set("affid", DEFAULT_FLIPKART_AFFID);
                return { url: parsed.toString(), platform: "Flipkart", asin: null };
              }
            }

            // 3. Myntra / Ajio
            if (host.includes("myntra.")) return { url: rawUrl, platform: "Myntra", asin: null };
            if (host.includes("ajio.")) return { url: rawUrl, platform: "Ajio", asin: null };

            return { url: rawUrl, platform: "Direct URL", asin: null };
          } catch(e) {
            return { url: rawUrl, platform: "Raw Link", asin: null };
          }
        }

        let debounceTimer = null;
        async function processInput() {
          const text = rawInput.value.trim();
          if (!text) {
            outputUrl.value = "";
            platformPill.textContent = "Waiting for link";
            asinPill.classList.add("hidden");
            return;
          }

          let url = extractUrl(text);
          if (!url) {
            outputUrl.value = "";
            platformPill.textContent = "No valid URL found";
            asinPill.classList.add("hidden");
            return;
          }

          if (!url.startsWith("http://") && !url.startsWith("https://")) {
            url = "https://" + url;
          }

          // Check if shortlink needs backend unshortening
          if (isShortLink(url)) {
            unshortenStatus.classList.remove("hidden");
            unshortenStatus.classList.add("flex");
            platformPill.textContent = "Resolving...";

            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(async () => {
              try {
                const res = await fetch("/api/unshorten?url=" + encodeURIComponent(url));
                const data = await res.json();
                if (data && data.resolvedUrl) {
                  url = data.resolvedUrl;
                }
              } catch(e) {
                console.error("Unshorten failed:", e);
              } finally {
                unshortenStatus.classList.add("hidden");
                unshortenStatus.classList.remove("flex");
                applyAffiliate(url);
              }
            }, 300);
            return;
          }

          applyAffiliate(url);
        }

        function applyAffiliate(targetUrl) {
          const res = transformAffiliate(targetUrl);
          outputUrl.value = res.url;
          platformPill.textContent = res.platform;
          if (res.asin) {
            asinPill.textContent = "ASIN: " + res.asin;
            asinPill.classList.remove("hidden");
          } else {
            asinPill.classList.add("hidden");
          }
        }

        rawInput.addEventListener("input", processInput);

        pasteBtn.addEventListener("click", async () => {
          try {
            const text = await navigator.clipboard.readText();
            if (text) {
              rawInput.value = text;
              processInput();
              showToast("Pasted from Clipboard!");
            }
          } catch (e) {
            rawInput.focus();
          }
        });

        clearBtn.addEventListener("click", () => {
          rawInput.value = "";
          outputUrl.value = "";
          platformPill.textContent = "Cleared";
          asinPill.classList.add("hidden");
          rawInput.focus();
        });

        copyInlineBtn.addEventListener("click", async () => {
          const url = outputUrl.value.trim();
          if (url) {
            await navigator.clipboard.writeText(url);
            showToast("Affiliate Link Copied!");
          }
        });

        whatsappBtn.addEventListener("click", () => {
          const url = outputUrl.value.trim();
          if (url) {
            const waText = encodeURIComponent(url);
            window.open("https://api.whatsapp.com/send?text=" + waText, "_blank");
          }
        });

        testOpenBtn.addEventListener("click", () => {
          const url = outputUrl.value.trim();
          if (url) {
            window.open(url, "_blank");
          }
        });

        // Initialize default sample
        rawInput.value = 'https://www.amazon.in/dp/B0BD9BF14B?th=1&psc=1&ck';
        processInput();
      })();
    </script>
</div>
</Layout>
