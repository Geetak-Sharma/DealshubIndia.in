---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { TelegramDataStore } from '../../lib/telegramStore.js';
import { extractCoupon, extractBankOffer, getBudgetTier } from '../../lib/dealNormalizer.js';
import fs from 'node:fs/promises';

const { id } = Astro.params;

let deal: any = null;
try {
  const storeData = TelegramDataStore.load();
  if (storeData && Array.isArray(storeData.posts)) {
    deal = storeData.posts.find((d: any) => d.id === id || String(d.id) === String(id));
  }
  if (!deal) {
    const candidatePaths = [
      new URL('../../data/telegram_posts.json', import.meta.url),
      new URL('../../../src/data/telegram_posts.json', import.meta.url)
    ];
    for (const url of candidatePaths) {
      try {
        const tgData = await fs.readFile(url, 'utf-8');
        const parsed = JSON.parse(tgData);
        deal = (parsed.posts || []).find((d: any) => d.id === id || String(d.id) === String(id));
        if (deal) break;
      } catch (_) {}
    }
  }
} catch (e) {
  console.error('[Deal Route] Fetch failed for ID ' + id, e);
}

const directUrl = deal?.checkoutUrl || deal?.url || deal?.link || ('/?dealId=' + id);
const dealTitle = deal?.title || 'Verified Loot Deal';
const dealPrice = deal?.price ? (String(deal.price).startsWith('₹') ? deal.price : `₹${deal.price}`) : '';
const originalPrice = deal?.originalPrice ? (String(deal.originalPrice).startsWith('₹') ? deal.originalPrice : `₹${deal.originalPrice}`) : '';
const merchant = deal?.merchant || 'Amazon';
const couponText = extractCoupon(dealTitle, deal?.text);
const bankOffer = extractBankOffer(dealTitle, deal?.text);
const budgetTier = deal?.numPrice ? getBudgetTier(deal.numPrice) : null;

const numPrice = parseFloat(String(deal?.price || '0').replace(/[^0-9.]/g, '')) || 0;
const numOriginal = parseFloat(String(deal?.originalPrice || '0').replace(/[^0-9.]/g, '')) || 0;
const discountPercent = deal?.discount || (numOriginal > numPrice && numPrice > 0 ? Math.round(((numOriginal - numPrice) / numOriginal) * 100) : 0);

const title = deal ? `${dealTitle} - ${dealPrice}` : 'DealshubIndia.in: Best Loot Deals';
const description = deal ? `Get ${dealTitle} for ${dealPrice}. Verified by DealsHub India.` : 'Discover the latest loot deals and offers in India.';

// Safe image proxy
const displayImage = deal?.image && deal.image.includes('telesco.pe')
  ? '/api/image-proxy?url=' + encodeURIComponent(deal.image)
  : (deal?.image || null);
---

<Layout title={title} description={description} ogTitle={title} image={deal?.image} includeHeader={true} includeFooter={false}>
  <div class="min-h-[ calc(100vh - 56px) ] flex items-center justify-center p-4 sm:p-6 bg-radial from-[#131b2c] via-[#0d111a] to-[#07090e] text-slate-100 font-sans relative overflow-hidden">
    <div class="ajsolute -top-32 left-1/2 -translate-x-1/2"w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 left-1/2 -translate-x-1/2 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-lg w-full p-6 sm:p-8 rounded-3xl border border-white/10 bg-[#0f141f]/90 backdrop-blur-2xl text-center shadow-[0_20px_50px_rgba(0,0,0,0.6)] relative z-10">
      <div class="flex items-center justify-between gap-2 mb-5 pb-3.5 border-b border-white/5">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full"w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>Verified Active Deal</span>
        </div>

        <div class="inline-flex items-center gap-1 text-xs font-mono text-slate-400 bg-white/5 px-2.5 py-1 rounded-lg border border-white/5">
          <span>⟌?</span>
          <span class="font-semibold text-slate-200">{merchant}</span>
        </div>
      </div>

      <div class="mb-5 p-3 rounded-2xl bg-amber-500/10 border border-amber-500/25 flex items-center justify-between text-left gap-3">
        <div class="flex items-center gap-2">
          <span class="text-xl">⚡</span>
          <div class="leading-tight">
            <div class="text-xs font-bold text-amber-300">Fast Selling Deal / Loot Drop</div>
            <div class="text-[11px] text-amber-200/80">Prices may surge or stock may run out soon!</div>
          </div>
        </div>
        <div class="shrink-0 text-right font-mono text-xs font-black text-amber-300 bg-amber-500/20 px-2 py-1 rounded-lg border border-amber-400/30" id="countdown-badge">
          02:59
        </div>
      </div>

      {deal && (
        <div class="p-4 rounded-2xl border border-white/10 bg-[#141a29]/80 text-left mb-6 group transition-all hover:border-emerald-500/30">
          <div class="flex items-start gap-3.5">
            {displayImage && (
              <div class="w-20 h-20 bg-white rounded-xl p-1.5 border border-white/10 shrink-0 flex items-center justify-center overflow-hidden">
                <img
                  src={displayImage}
                  alt={dealTitle}
                  class="max-h-full max-w-full object-contain"
                  loading="eager"
                  referrerpolicy="no-referrer"
                />
              </div>
            )}

            <div class="min-w-0 flex-1">
              <h1 class="text-sm sm:text-base font-bold text-slate-100 leading-snug line-clamp-2 mb-2 group-hover:text-emerald-300 transition-colors">
                {dealTitle}
              </h1>

              <div class="flex items-baseline gap-2 flex-wrap font-mono">
                {dealPrice && <span class="text-xl sm:text-2xl font-black text-emerald-300">{dealPrice}</span>}
                {originalPrice && <span class="text-xs sm:text-sm text-slate-400 line-through">{originalPrice}</span>}
                {discountPercent > 0 && (
                  <span class="px-2 py-0.5 rounded-md text-[11px] font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30">
                    {discountPercent}% OFF
                </span>
                )}
              </div>
            </div>
          </div>

          {couponText && (
            <div class="mt-3 p-2.5 rounded-xl bg-amber-400/10 border border-amber-400/30 flex items-center gap-2 text-xs text-amber-200">
              <span class="text-base leading-none">✂️</span>
              <span class="leading-tight text-[11px]">
                <strong class="text-amber-300">Action:</strong> Tick <span class="underline font-semibold text-white">&quot;{couponText}&quot;</span> on {merchant} before checkout.
              </span>
            </div>
          )}

          {bankOffer && (
            <div class="mt-2 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-blue-500/15 border border-blue-500/30 text-blue-300 text-xs font-medium">
              <span>💳</span>
              <span class="line-clamp-1">{bankOffer}</span>
            </div>
          )}
        </div>
      )}

      <a
        id="continue-btn"
        href={directUrl}
        class="relative group/btn w-full flex items-center justify-center gap-2 px-6 py-4 rounded-2xl bg-gradient-to-r from-emerald-500 via-emerald-400 to-teal-400 hover:from-emerald-400 hover:to-teal-300 text-slate-950 font-black text-base shadow-lg shadow-emerald-500/25 hover:shadow-emerald-500/40 transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]"
      >
        <span>Continue to Store</span>
        <span class="text-lg leading-none transition-transform group-hover/btn:translate-x-1 group-hover/btn:-translate-y-0.5">↗</span>
      </a>

      <div class="mt-5">
        <div class="flex items-center justify-between text-xs text-slate-400 mb-1.5 font-medium">
          <span id="redirect-status-text">Redirecting to official store link...</span>
          <span class="font-mono text-emerald-400 font-bold" id="redirect-timer-text">2.5s</span>
        </div>
        <div class="w-full h-1.5 bg-white/10 rounded-full overflow-hidden">
          <div id="redirect-progress-bar" class="h-full bg-gradient-to-r from-emerald-500 to-teal-400 transition-all duration-100 ease-linear w-0"></div>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-around text-[11px] text-slate-400 font-medium">
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          <span>Verified Merchant</span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-amber-400 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          <span>Instant Activation</span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-blue-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m9.17 14.83-4.24 4.24"/></svg>
          <span>100% Direct Link</span>
        </span>
      </div>
    </div>
  </div>

  <script define:vars={{ directUrl }}>
    (function() {
      let timeLeft = 2.5;
      const totalTime = 2.5;
      const timerText = document.getElementById("redirect-timer-text");
      const progressBar = document.getElementById("redirect-progress-bar");
      const countdownBadge = document.getElementById("countdown-badge");

      let dealSeconds = 179;
      setInterval(() => {
        if (dealSeconds > 0) {
          dealSeconds--;
          const m = String(Math.floor(dealSeconds / 60)).padStart(2, "0");
          const s = String(dealSeconds % 60).padStart(2, "0");
          if (countdownBadge) countdownBadge.textContent = m + ":" + s;
        }
      }, 1000);

      const step = 0.1;
      const timer = setInterval(() => {
        timeLeft -= step;
        if (timeLeft <= 0) {
          clearInterval(timer);
          if (progressBar) progressBar.style.width = "100%";
          if (timerText) timerText.textContent = "Redirecting...";
          window.location.href = directUrl;
        } else {
          const percent = ((totalTime - timeLeft) / totalTime) * 100;
          if (progressBar) progressBar.style.width = percent + "%";
          if (timerText) timerText.textContent = timeLeft.toFixed(1) + "s";
        }
      }, 100);

      const btn = document.getElementById("continue-btn");
      if (btn) {
        btn.addEventListener("click", () => {
          clearInterval(timer);
        });
      }
    })();
  </script>
</Layout>
