---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { TelegramDataStore } from '../../lib/telegramStore.js';
import fs from 'node:fs/promises';

const { id } = Astro.params;

let deal: any = null;
try {
  const storeData = TelegramDataStore.load();
  if (storeData && Array.isArray(storeData.posts)) {
    deal = storeData.posts.find((d: any) => d.id === id || String(d.id) === String(id));
  }
  if (!deal) {
    const tgURL = new URL('../../data/telegram_posts.json', import.meta.url);
    const tgData = await fs.readFile(tgURL, 'utf-8');
    const parsed = JSON.parse(tgData);
    deal = (parsed.posts || []).find((d: any) => d.id === id || String(d.id) === String(id));
  }
} catch (e) {
  try {
    const cacheURL = new URL('../../data/telegram_posts.json', import.meta.url);
    const cacheData = await fs.readFile(cacheURL, 'utf-8');
    const parsed = JSON.parse(cacheData); const deals = parsed.posts || parsed.deals || [];
    deal = (deals || []).find((d: any) => d.id === id || String(d.id) === String(id));
  } catch (err: any) {
    console.error('[Deal Route] Fetch failed for ID ' + id, err?.message);
  }
}

const directUrl = deal?.checkoutUrl || deal?.url || deal?.link || ('/?dealId=' + id);
const dealTitle = deal?.title || 'Loot Deal';
const dealPrice = deal?.price || '';
const title = deal ? (dealTitle + ' - ' + dealPrice) : 'DealshubIndia.in: Best Loot Deals';
const description = deal ? ('Get ' + dealTitle + ' for ' + dealPrice + '. Verified by DealsHub India.') : 'Discover the latest loot deals and offers in India.';
---

<Layout title={title} description={description} ogTitle={title} image={deal?.image}>
  <div class="min-h-screen flex items-center justify-center p-4 bg-[#F8F9FA] text-gray-900 font-sans">
    <div class="max-w-md w-full notion-card p-6 rounded-xl border border-gray-200 bg-white text-center shadow-sm">
      <div class="w-10 h-10 mx-auto mb-3 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-lg">⚡</div>
      <h2 class="text-lg font-bold text-gray-900 mb-1">Redirecting to Deal...</h2>
      <p class="text-xs text-gray-500 mb-5">Taking you directly to the verified store link. One moment please!</p>
      
      {deal && (
        <div class="flex items-center gap-3 p-3 rounded-lg border border-gray-100 bg-gray-50/50 text-left mb-5">
          {deal.image && (
            <img src={deal.image} alt={deal.title} class="w-14 h-14 object-contain rounded bg-white p-1 border border-gray-200 shrink-0" />
          )}
          <div class="min-w-0">
            <h3 class="text-xs font-semibold text-gray-900 truncate">{deal.title}</h3>
            <span class="text-sm font-bold text-emerald-600 font-mono">{deal.price || ''}</span>
          </div>
        </div>
      )}
      
      <a href={directUrl} class="inline-flex items-center justify-center w-full px-4 py-2.5 bg-gray-900 hover:bg-black text-white text-xs font-medium rounded-lg transition-colors">
        Continue to Store ↗
      </a>
    </div>
  </div>

  <script define:vars={{ directUrl }}>
    setTimeout(() => {
      window.location.href = directUrl;
    }, 150);
  </script>
</Layout>
