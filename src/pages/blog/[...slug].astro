---
export const prerender = true;
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SectionBlock from '../../components/SectionBlock.astro';
import DealCard from '../../components/deals/DealCard.astro';
import { getNormalizedDeals } from '../../lib/content.ts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '').replace(/\\/g, '/') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const ogImage = typeof post.data.image === "object" ? post.data.image.src : (post.data.image || "https://dealshubindia.in/og-image.png");

// Related Deals Logic using Normalization Layer
const blogCat = post.data.category ? post.data.category.toLowerCase() : 'all';
let relatedDeals = getNormalizedDeals(3, 0, blogCat === 'tech' ? 'tech' : blogCat === 'fashion' ? 'fashion' : 'all').deals;
if (relatedDeals.length < 3) {
  const fallbackDeals = getNormalizedDeals(3, 0, 'all').deals;
  const existingIds = new Set(relatedDeals.map(d => d.id));
  const additional = fallbackDeals.filter(d => !existingIds.has(d.id));
  relatedDeals = [...relatedDeals, ...additional].slice(0, 3);
}
---

<Layout 
  title={`${post.data.title} | Dealshub Blog`} 
  description={post.data.description}
  image={ogImage}
  ogType="article"
>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const shareBtn = document.getElementById('nativeShareBtn');
      const tooltip = document.getElementById('copyTooltip');
      if (shareBtn) {
        shareBtn.addEventListener('click', async () => {
          const title = shareBtn.getAttribute('data-title');
          const url = shareBtn.getAttribute('data-url');
          if (navigator.share) {
            try {
              await navigator.share({
                title: title,
                url: url
              });
            } catch (err) {
              console.error('Error sharing: ', err);
            }
          } else {
            try {
              await navigator.clipboard.writeText(url);
              if (tooltip) {
                tooltip.classList.add('show');
                setTimeout(() => {
                  tooltip.classList.remove('show');
                }, 2000);
              }
            } catch (err) {
              console.error('Failed to copy link: ', err);
            }
          }
        });
      }
    });
  </script>

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "image": ogImage,
    "datePublished": post.data.pubDate.toISOString(),
    "author": {
      "@type": "Person",
      "name": post.data.author,
      "url": "https://dealshubindia.in/about"
    },
    "publisher": {
      "@type": "Organization",
      "name": "DealsHub India",
      "logo": {
        "@type": "ImageObject",
        "url": "https://dealshubindia.in/favicon.svg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://dealshubindia.in/blog/${post.id}`
    }
  })} />

  
  <main class="post-layout">
    <div class="l-container">
      <!-- Blog Sub-Menu Bar -->
      <div class="blog-sub-menu glass-panel">
        <div class="sub-menu-left">
          <a href="/blog" class="back-to-blog-btn">
            <span class="arrow">←</span>
            <span>Back to Blog</span>
          </a>
        </div>
        <div class="sub-menu-right">
          <span class="sub-meta-item category">{post.data.category}</span>
          <span class="sub-meta-sep mobile-hide">•</span>
          <span class="sub-meta-item author mobile-hide">By {post.data.author || 'DealsHub Team'}</span>
          <span class="sub-meta-sep mobile-hide">•</span>
          <span class="sub-meta-item date mobile-hide">{post.data.pubDate.toLocaleDateString('en-IN', { dateStyle: 'long' })}</span>
          <span class="sub-meta-sep">•</span>
          <div class="sub-menu-share">
            <button class="share-btn" id="nativeShareBtn" title="Share" data-title={post.data.title} data-url={`https://dealshubindia.in/blog/${post.id}`}>
              <svg viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92c0-1.61-1.31-2.92-2.92-2.92z"/></svg>
              <span class="copy-tooltip" id="copyTooltip">Link Copied!</span>
            </button>
          </div>
        </div>
      </div>

      <article class="post-content glass-panel">
        <div class="post-header">
          <h1 class="post-title">{post.data.title}</h1>
        </div>

        {post.data.image && (
          <div class="post-featured-image">
            {typeof post.data.image === "object" ? ( <Image src={post.data.image} alt={post.data.title} class="fade-in" width={1200} height={630} loading="eager" fetchpriority="high" /> ) : ( <img src={post.data.image} alt={post.data.title} class="fade-in" width="1200" height="630" loading="eager" fetchpriority="high" /> )}
          </div>
        )}

        <div class="prose" id="blog-body">
          <Content />
        </div>

        <!-- Global Community CTA Box (Liquid Glassmorphism) -->
        <div class="global-community-cta u-mt-6">
          <div class="cta-header">
             <span class="cta-badge">🔔 Community Alert</span>
             <h3>Join the DealsHub India Community!</h3>
          </div>
          <p>Never miss an online pricing error or flash sale again! Join our highly active communities on Telegram and WhatsApp:</p>
          <div class="centered-button-wrapper side-by-side">
            <a href="https://t.me/DealsHubIndiaa" class="dealshub-pill-button btn-telegram" target="_blank" rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.2-.08-.06-.19-.04-.27-.02-.11.02-1.89 1.19-5.33 3.52-.5.35-.96.52-1.37.51-.45-.01-1.32-.26-1.97-.47-.8-.26-1.43-.4-1.37-.85.03-.23.35-.47.97-.71 3.79-1.65 6.32-2.74 7.57-3.27 3.6-1.5 4.35-1.76 4.84-1.77.11 0 .35.03.5.16.13.12.17.28.18.39.01.1-.01.2-.02.31z"/></svg>
              Join Telegram
            </a>
            <a href="https://whatsapp.com/channel/0029Vb81sJqGk1FxL7t9lW0h" class="dealshub-pill-button btn-whatsapp" target="_blank" rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M16.75 13.96c-.28-.15-1.63-.8-1.88-.9-.25-.09-.43-.14-.62.14-.18.27-.71.9-8.7 1.08-.16.18-.32.2-.59.05-.28-.15-1.16-.43-2.21-1.37-.82-.73-1.37-1.63-1.53-1.9-.16-.27-.02-.42.12-.56.12-.12.28-.32.42-.48.14-.16.18-.27.28-.46.09-.18.05-.34-.02-.48-.07-.14-.62-1.49-.85-2.04-.22-.53-.45-.46-.62-.47-.16-.01-.34-.01-.52-.01-.18 0-.48.07-.73.34-.25.27-.96.94-.96 2.29 0 1.35.98 2.66 1.12 2.85.14.18 1.94 2.96 4.7 4.15.66.28 1.17.45 1.57.58.66.21 1.26.18 1.73.11.53-.08 1.63-.66 1.86-1.31.23-.64.23-1.19.16-1.31-.07-.12-.25-.18-.53-.33zM12 2C6.48 2 2 6.48 2 12c0 2.17.7 4.19 1.94 5.86L2.05 24l6.3-1.65C9.87 23.41 10.91 23.6 12 23.6c5.52 0 10-4.48 10-10S17.52 2 12 2z"/></svg>
              Join WhatsApp
            </a>
          </div>
        </div>

        <div class="post-footer u-mt-6">
          <div class="post-tags">
            {post.data.tags.map((tag) => (
              <span class="post-tag">#{tag}</span>
            ))}
          </div>
        </div>
      </article>


      {relatedDeals.length > 0 && (
        <div class="u-mt-6 content-deals-wrapper">
          <SectionBlock title="Snag These Deals While Reading" icon="💎">
            <div class="compact-deal-list">
               {relatedDeals.map((deal) => (
                 <DealCard 
                   title={deal.title}
                   image={deal.image}
                   price={deal.price}
                   originalPrice={deal.originalPrice}
                   url={deal.url}
                   platform={deal.merchant}
                   isLoot={deal.isLoot}
                   timestamp={deal.timestamp}
                   insightBadge="Pairs well with this guide"
                 />
               ))}
            </div>
          </SectionBlock>
        </div>
      )}

    </div>
  </main>

  <script is:inline>
    // Automatically make all external links open in new tabs
    (function() {
      const container = document.getElementById('blog-body');
      if (!container) return;
      
      const links = container.getElementsByTagName('a');
      const currentHost = window.location.host;
      
      for (let link of links) {
        if (link.host && link.host !== currentHost) {
          link.setAttribute('target', '_blank');
          link.setAttribute('rel', 'noopener noreferrer');
        }
      }

      // Automatically fold Table of Contents for all blog articles
      const headings = container.getElementsByTagName('h2');
      let tocHeading = null;
      for (let h of headings) {
        if (h.textContent.toLowerCase().includes('table of contents')) {
          tocHeading = h;
          break;
        }
      }
      
      if (tocHeading) {
        let sibling = tocHeading.nextElementSibling;
        while (sibling && sibling.tagName !== 'UL' && sibling.tagName !== 'OL' && sibling.tagName !== 'H2') {
          sibling = sibling.nextElementSibling;
        }
        
        if (sibling && (sibling.tagName === 'UL' || sibling.tagName === 'OL')) {
          const details = document.createElement('details');
          details.className = 'toc-details glass-panel';
          details.style.margin = '1.5rem 0';
          details.style.padding = '1.2rem';
          details.style.borderRadius = '12px';
          details.style.border = '1px solid rgba(255, 255, 255, 0.08)';
          details.style.background = 'rgba(255, 255, 255, 0.02)';
          
          const summary = document.createElement('summary');
          summary.textContent = 'Table of Contents (Click to Expand)';
          summary.style.cursor = 'pointer';
          summary.style.fontWeight = '700';
          summary.style.color = '#22C55E';
          summary.style.outline = 'none';
          
          details.appendChild(summary);
          
          const listClone = sibling.cloneNode(true);
          details.appendChild(listClone);
          
          tocHeading.parentNode.insertBefore(details, tocHeading);
          tocHeading.parentNode.removeChild(tocHeading);
          sibling.parentNode.removeChild(sibling);
        }
      }
    })();
  </script>
</Layout>

<style is:global>
  /* Global Community CTA (Liquid Glass design) */
  .global-community-cta {
    padding: 1.8rem 2rem;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-left-width: 4px;
    border-left-color: #22C55E;
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.04) 0%, rgba(11, 14, 20, 0.9) 100%) !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(16px);
    margin: 2rem 0;
  }
  .global-community-cta h3 {
    margin: 0 !important;
    font-size: 1.45rem !important;
    font-weight: 800;
    color: var(--text-primary);
  }
  .global-community-cta p {
    color: var(--text-secondary);
    margin: 12px 0 20px !important;
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .cta-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cta-badge {
    background: rgba(34, 197, 94, 0.15);
    color: #22C55E;
    align-self: flex-start;
    padding: 3px 10px;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  /* Centered CTA Pill Buttons */
  .centered-button-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin: 1.2rem 0;
    width: 100%;
    flex-wrap: wrap;
  }
  .dealshub-pill-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 28px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none !important;
    color: #ffffff !important;
    position: relative;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  
  /* Liquid shine sweep effect */
  .dealshub-pill-button::before {
    content: '';
    position: absolute;
    top: 0;
    left: -150%;
    width: 120%;
    height: 100%;
    background: linear-gradient(
      120deg,
      transparent,
      rgba(255, 255, 255, 0.16),
      transparent
    );
    transition: all 0.6s ease;
  }
  .dealshub-pill-button:hover::before {
    left: 150%;
  }
  .dealshub-pill-button:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
  }
  .dealshub-pill-button.btn-proxy {
    background: linear-gradient(135deg, #22C55E 0%, #15803D 100%);
  }
  .dealshub-pill-button.btn-proxy:hover {
    box-shadow: 0 0 25px rgba(34, 197, 94, 0.5);
    border-color: rgba(34, 197, 94, 0.4);
  }
  .dealshub-pill-button.btn-telegram {
    background: linear-gradient(135deg, #0076b6 0%, #004b75 100%);
  }
  .dealshub-pill-button.btn-telegram:hover {
    box-shadow: 0 0 25px rgba(0, 136, 204, 0.5);
    border-color: rgba(0, 136, 204, 0.4);
  }
  .dealshub-pill-button.btn-whatsapp {
    background: linear-gradient(135deg, #007b5e 0%, #004d3b 100%);
  }
  .dealshub-pill-button.btn-whatsapp:hover {
    box-shadow: 0 0 25px rgba(34, 197, 94, 0.5);
    border-color: rgba(34, 197, 94, 0.4);
  }
  .dealshub-pill-button svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
    display: inline-block;
  }

  /* Proxy Connection Guide Grid */
  .proxy-guide-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 20px;
    margin: 1.5rem 0;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.5rem;
  }
  @media (max-width: 768px) {
    .proxy-guide-grid {
      grid-template-columns: 1fr;
    }
  }
  .proxy-guide-steps h3, .proxy-guide-params h3 {
    margin-top: 0 !important;
    font-size: 1.25rem !important;
    color: var(--text-primary);
    border-bottom: 2px solid rgba(34, 197, 94, 0.2);
    padding-bottom: 8px;
    margin-bottom: 12px !important;
  }
  .proxy-guide-steps ol {
    padding-left: 1.25rem;
    margin: 0;
  }
  .proxy-guide-steps li {
    margin-bottom: 8px;
    color: var(--text-secondary);
  }
  .param-box {
    display: flex;
    flex-direction: column;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 10px 12px;
    border-radius: 8px;
    margin-bottom: 10px;
  }
  .param-box:last-child {
    margin-bottom: 0;
  }
  .param-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 2px;
  }
  .param-value {
    font-size: 0.95rem;
    color: #22C55E;
    font-weight: 600;
    word-break: break-all;
  }
  .font-mono {
    font-family: monospace;
    font-size: 0.85rem;
  }
  
  .toc-details summary {
    font-size: 1.1rem;
    user-select: none;
    transition: color 0.2s ease;
  }
  .toc-details summary:hover {
    color: #4ade80;
  }
  .toc-details[open] summary {
    margin-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 8px;
  }

  /* Compact Deals inside Blog */
  .content-deals-wrapper { margin-bottom: 2rem; margin-top: 3rem; }
  .compact-deal-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    width: 100%;
  }
  .compact-deal-list .deal-card {
    height: auto !important;
    min-height: 380px;
  }
  .compact-deal-list .deal-card__img-wrap {
    aspect-ratio: 4/3;
    max-height: 180px;
  }
  @media (max-width: 900px) { .compact-deal-list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .compact-deal-list { grid-template-columns: 1fr; } }

    /* Table styling */
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.95rem;
    line-height: 1.5;
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .prose th, .prose td {
    padding: 12px 16px;
    text-align: left;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    min-width: 140px; /* Prevents columns from shrinking to unreadable widths on mobile */
  }
  .prose th {
    background: rgba(34, 197, 94, 0.1);
    color: var(--text-primary);
    font-weight: 700;
  }
  .prose tr:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .prose {
    color: var(--text-secondary);
    line-height: 1.8;
    font-size: 1.1rem;
  }

  .prose h2 {
    color: var(--text-primary);
    font-size: 1.75rem;
    font-weight: 800;
    margin: 2rem 0 1rem;
  }

  .prose h3 {
    color: var(--text-primary);
    font-size: 1.4rem;
    font-weight: 700;
    margin: 1.5rem 0 0.75rem;
  }

  .prose p {
    margin-bottom: 1.25rem;
  }

  .prose ul, .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose strong {
    color: var(--text-primary);
    font-weight: 700;
  }

  .prose a {
    color: #22C55E;
    text-decoration: underline;
    font-weight: 600;
  }

  .prose .c-btn {
    color: white !important;
    text-decoration: none !important;
  }

  .prose blockquote {
    border-left: 4px solid #22C55E;
    padding-left: 1.5rem;
    font-style: italic;
    margin: 2rem 0;
    background: rgba(34, 197, 94, 0.05);
    padding: 1rem 1.5rem;
    border-radius: 0 12px 12px 0;
  }
</style>

<style>
  .post-layout {
    padding-bottom: 4rem;
  }

  .post-layout .l-container {
    overflow: visible;
  }

  :global(html), :global(body) {
    overflow-x: clip !important;
  }

  .blog-sub-menu {
    position: sticky;
    top: 12px; /* Close to the top of screen after main header scrolls away */
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: 16px;
    margin: 0 auto 1.5rem auto;
    max-width: 900px;
    background: rgba(17, 24, 39, 0.85); /* Translucent dark glass */
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-sizing: border-box;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
    transition: background-color 0.3s ease;
  }

  .sub-menu-share {
    display: flex;
    align-items: center;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 0;
    position: relative;
  }

  .share-btn svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .share-btn:hover {
    color: #22C55E;
    background: rgba(34, 197, 94, 0.15);
    border-color: rgba(34, 197, 94, 0.4);
    box-shadow: 0 0 12px rgba(34, 197, 94, 0.25);
    transform: translateY(-1px);
  }

  .copy-tooltip {
    position: absolute;
    bottom: 125%;
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: rgba(0, 0, 0, 0.9);
    color: #fff;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: all 0.2s ease;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .copy-tooltip.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .sub-menu-left {
    display: flex;
    align-items: center;
  }

  .sub-menu-right {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .sub-meta-item.category {
    color: #22C55E;
