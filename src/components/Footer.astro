---
import BrandLogo from './BrandLogo.astro';
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-[#10131A] border-t border-white/10 text-slate-400 text-sm mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-12 pb-12 border-b border-white/10">
      
      <!-- Brand & Summary Column (2 cols on lg) -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-2.5 group focus:outline-none" aria-label="DealsHub India Home">
          <div class="flex-shrink-0 group-hover:scale-105 transition-transform duration-200">
            <BrandLogo size={28} gradientId="ftr-brand-logo-grad" />
          </div>
          <div class="flex items-center">
            <span class="font-extrabold text-xl tracking-tight text-slate-100 group-hover:text-emerald-400 transition-colors">DealsHub</span>
            <span class="text-emerald-600 font-extrabold text-xl">.in</span>
          </div>
        </a>

        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-sm">
          India’s trusted loot alerts and price-drop hunter since 2018. Hand-picking genuine discounts across Amazon, Flipkart, Myntra, and Blinkit with zero retail fluff.
        </p>

        <!-- Dual Community Channels in footer -->
        <div class="pt-2 flex flex-wrap items-center gap-2.5">
          <a
            href="https://whatsapp.com/channel/0029Vb81sJqGk1FxL7t9lW0h"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[#25D366]/15 hover:bg-[#25D366]/25 border border-[#25D366]/30 text-emerald-400 text-xs font-semibold transition-all"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            <span>WhatsApp</span>
          </a>
          <a
            href="https://t.me/DealsHubIndiaa"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[#0088cc]/15 hover:bg-[#0088cc]/25 border border-[#0088cc]/30 text-[#38bdf8] text-xs font-semibold transition-all"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .4z"/>
            </svg>
            <span>Telegram</span>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-slate-100 uppercase tracking-wider">Quick Navigation</h4>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li><a href="/" class="hover:text-emerald-400 transition-colors">Today's Deals</a></li>
          <li><a href="/#stores" class="hover:text-emerald-400 transition-colors">Store Drops</a></li>
          <li><a href="/blog" class="hover:text-emerald-400 transition-colors">Shopping Guides & Blog</a></li>
          <li><a href="/about" class="hover:text-emerald-400 transition-colors">About Us</a></li>
          <li><a href="/tools/flipkart-review-analyzer" class="hover:text-emerald-400 transition-colors">Review Analyzer Tool</a></li>
        </ul>
      </div>

      <!-- Categories & Popular Stores -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-slate-100 uppercase tracking-wider">Popular Stores</h4>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li><a href="/?store=amazon" class="hover:text-emerald-400 transition-colors">Amazon India Deals</a></li>
          <li><a href="/?store=flipkart" class="hover:text-emerald-400 transition-colors">Flipkart GOAT Deals</a></li>
          <li><a href="/?filter=loot" class="hover:text-emerald-400 transition-colors">90% Off Loot Deals</a></li>
          <li><a href="/?filter=under99" class="hover:text-emerald-400 transition-colors">Under ₹99 Loots</a></li>
          <li><a href="/quick-commerce" class="hover:text-emerald-400 transition-colors">Quick Commerce (Blinkit/Zepto)</a></li>
        </ul>
      </div>

      <!-- Legal & Policies -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-slate-100 uppercase tracking-wider">Transparency & Legal</h4>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li><a href="/disclosure" class="hover:text-emerald-400 transition-colors">Affiliate Disclosure</a></li>
          <li><a href="/dmca" class="hover:text-emerald-400 transition-colors">DMCA Policy</a></li>
          <li><a href="/contact" class="hover:text-emerald-400 transition-colors">Contact Support</a></li>
          <li><a href="/feed.xml" class="hover:text-emerald-400 transition-colors">RSS Deal Feed</a></li>
        </ul>
      </div>

    </div>

    <!-- Mandatory Affiliate Disclosure Notice -->
    <div class="py-6 border-b border-white/10 text-[11px] sm:text-xs text-slate-400 leading-relaxed space-y-2">
      <p>
        <strong class="text-slate-300">Affiliate Disclosure:</strong> DealsHub India is a participant in affiliate advertising programs including the Amazon Associates Program, Flipkart Affiliate Program, and other merchant networks designed to provide a means for sites to earn referral fees by advertising and linking to official e-commerce platforms. As an affiliate, we earn from qualifying purchases at <span class="text-emerald-400 font-medium">absolutely no extra cost to you</span>.
      </p>
      <p>
        Prices, coupons, and product availability are accurate as of the time of posting and are subject to real-time merchant changes. We do not sell any products directly; all transactions take place on merchant portals.
      </p>
    </div>

    <!-- Copyright & Disclaimer -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>© {currentYear} DealsHub India. All rights reserved. Handpicked with ❤️ in India.</p>
      <div class="flex items-center gap-4">
        <a href="/disclosure" class="hover:text-white transition-colors">Disclosure</a>
        <span>•</span>
        <a href="/dmca" class="hover:text-white transition-colors">DMCA</a>
        <span>•</span>
        <a href="/contact" class="hover:text-white transition-colors">Contact</a>
      </div>
    </div>

  </div>
</footer>


