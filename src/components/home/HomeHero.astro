---
// HomeHero.astro - Compact Search-first Home Hero for DealsHub India
import LiveStatBar from "./LiveStatBar.astro";
---

<section class="home-hero" aria-labelledby="hero-heading">
  <div class="home-hero__inner">
    <div class="home-hero__badge">
      <LiveStatBar />
    </div>

    <h1 class="home-hero__title" id="hero-heading">
      India&apos;s Smartest Live <br />
      <span class="home-hero__title-accent">Loot &amp; Deals Feed</span>
    </h1>

    <p class="home-hero__description">
      Hand-picked, community-verified online shopping discounts from Amazon, Flipkart, Myntra &amp; more.
    </p>

    {/* Search Input trigger button on mobile / full desktop inline search */}
    <div class="home-hero__search-box">
      <div class="hero-search-wrapper">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="hero-search-icon">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input 
          type="text" 
          id="hero-deals-search" 
          class="hero-search-input" 
          placeholder="Search loots (e.g. SSD, Shoes, Phone)..."
          aria-label="Search live deals feed"
          autocomplete="off"
        />
        <button id="hero-deals-search-btn" class="hero-search-btn" type="button">
          Search
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  function setupHeroSearch() {
    const heroInput = document.getElementById("hero-deals-search") as HTMLInputElement;
    const headerInput = document.getElementById("deals-search") as HTMLInputElement;

    if (!heroInput) return;

    // Sync input typing from Hero search with the global header Search state
    heroInput.addEventListener("input", (e) => {
      const val = (e.target as HTMLInputElement).value;
      if (headerInput) {
        headerInput.value = val;
        // Dispatch search event so results dynamically filter
        window.dispatchEvent(new CustomEvent("deals-search", { detail: { query: val.trim() } }));
      }
    });

    heroInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        const val = heroInput.value.trim();
        window.dispatchEvent(new CustomEvent("deals-search", { detail: { query: val } }));
      }
    });

    const searchBtn = document.getElementById("hero-deals-search-btn");
    searchBtn?.addEventListener("click", () => {
      const val = heroInput.value.trim();
      window.dispatchEvent(new CustomEvent("deals-search", { detail: { query: val } }));
    });
  }

  setupHeroSearch();
  document.addEventListener("astro:after-swap", setupHeroSearch);
</script>

<style>
  .home-hero {
    padding: var(--spacing-3) 0 var(--spacing-2);
    text-align: left;
  }

  .home-hero__inner {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .home-hero__title {
    font-size: clamp(24px, 7vw, 36px);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.8px;
    color: var(--text-primary);
    margin: 0;
  }

  .home-hero__title-accent {
    color: var(--primary-color);
  }

  .home-hero__description {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .home-hero__search-box {
    margin-top: 4px;
    width: 100%;
  }

  .hero-search-wrapper {
    display: flex;
    align-items: center;
    background-color: var(--surface-color-hover);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    height: 48px;
    padding: 0 4px 0 12px;
    gap: 8px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .hero-search-wrapper:focus-within {
    border-color: var(--primary-color);
    box-shadow: 0 0 12px rgba(34, 197, 94, 0.15);
  }

  .hero-search-icon {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .hero-search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-primary);
    width: 100%;
  }

  .hero-search-btn {
    height: 38px;
    padding: 0 16px;
    background-color: var(--primary-color);
    color: #ffffff;
    font-size: 13px;
    font-weight: 800;
    border-radius: var(--radius-sm);
    border: none;
    cursor: pointer;
    transition: filter 0.15s ease;
  }

  .hero-search-btn:hover {
    filter: brightness(1.08);
  }

  @media (min-width: 768px) {
    .home-hero {
      padding: var(--spacing-4) 0 var(--spacing-3);
    }
  }
</style>
