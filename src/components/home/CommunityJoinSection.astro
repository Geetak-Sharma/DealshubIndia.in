---

<section class="cjs" aria-labelledby="cjs-heading">
  <div class="cjs__header">
    <h2 class="cjs__heading" id="cjs-heading">Stay in the Loop</h2>
    <p class="cjs__sub">Get alerts before deals sell out. Join on your preferred platform.</p>
  </div>

  <div class="cjs__grid">
    {networks.map(n => (
      <a 
        href={n.href} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="cjs__card"
        style={`--network-color: ${n.color}`}
        aria-label={`${n.cta} on ${n.name}`}
      >
        <div class="cjs__icon" set:html={n.icon} />
        <div class="cjs__info">
          <span class="cjs__name">{n.name}</span>
          <span class="cjs__benefit">{n.benefit}</span>
        </div>
        <span class="cjs__cta">{n.cta} →</span>
      </a>
    ))}
  </div>
</section>

<style>
  .cjs {
    margin-top: var(--spacing-5);
    padding-top: var(--spacing-4);
    border-top: 1px solid var(--border-color);
  }

  .cjs__header {
    margin-bottom: var(--spacing-3);
  }

  .cjs__heading {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 4px 0;
  }

  .cjs__sub {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 0;
  }

  .cjs__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }

  @media (min-width: 480px) {
    .cjs__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .cjs__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .cjs__card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
    position: relative;
  }

  .cjs__card:hover {
    border-color: var(--network-color);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--network-color) 15%, transparent);
    transform: translateY(-2px);
  }

  .cjs__icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--network-color);
    background: color-mix(in srgb, var(--network-color) 10%, transparent);
  }

  .cjs__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .cjs__name {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .cjs__benefit {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 900px) {
    .cjs__benefit {
      white-space: normal;
    }
  }

  .cjs__cta {
    font-size: 12px;
    font-weight: 700;
    color: var(--network-color);
    white-space: nowrap;
    flex-shrink: 0;
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  .cjs__card:hover .cjs__cta {
    opacity: 1;
  }
</style>
