---
// HomeDealCard — used for SSR SEO rendering of static .md deals
// Hidden from users visually, rendered for search engines
interface Props {
  title: string;
  price: string;
  originalPrice?: string;
  link: string;
  category: string;
  isLoot?: boolean;
}

const { title, price, originalPrice, link, category, isLoot = false } = Astro.props;
const displayCategory = category.charAt(0).toUpperCase() + category.slice(1);
---

<div class:list={["hdc", { "hdc--loot": isLoot }]}>
  <div class="hdc__meta">
    <span class:list={["hdc__badge", { "hdc__badge--loot": isLoot }]}>
      {displayCategory}
    </span>
  </div>
  <h3 class="hdc__title">{title}</h3>
  <div class="hdc__price-row">
    <span class="hdc__price">₹{price}</span>
    {originalPrice && (
      <span class="hdc__price-orig">₹{originalPrice}</span>
    )}
  </div>
  <a href={link} target="_blank" rel="noopener noreferrer" class="hdc__cta">
    View Deal
  </a>
</div>

<style>
  .hdc {
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: var(--spacing-2);
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: box-shadow 0.18s ease, transform 0.18s ease;
  }

  .hdc:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .hdc__meta {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .hdc__badge {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: var(--surface-color-hover);
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    display: inline-block;
  }

  .hdc__badge--loot {
    background: rgba(34, 197, 94, 0.08);
    color: #16a34a;
    border-color: rgba(34, 197, 94, 0.2);
  }

  [data-theme='dark'] .hdc__badge--loot {
    color: #4ade80;
    background: rgba(34, 197, 94, 0.12);
  }

  .hdc__title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .hdc__price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 2px;
  }

  .hdc__price {
    font-size: 15px;
    font-weight: 800;
    color: var(--primary-color);
  }

  .hdc__price-orig {
    font-size: 12px;
    color: var(--text-muted);
    text-decoration: line-through;
  }

  .hdc__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 9px 16px;
    background: var(--primary-color);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    border-radius: var(--radius-sm);
    text-decoration: none;
    margin-top: auto;
    transition: filter 0.15s ease;
  }

  .hdc__cta:hover {
    filter: brightness(1.1);
  }
</style>
