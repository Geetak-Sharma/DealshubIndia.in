---
interface Props {
  memberCount?: string;
  totalSaved?: string;
}

const {
  memberCount = "15,000+",
  totalSaved = "₹2.5 Cr+"
} = Astro.props;
---

<section class="relative pt-12 pb-16 sm:pt-16 sm:pb-24 overflow-hidden">
  <!-- Subtle Ambient Glows -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-emerald-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute top-0 right-1/4 w-80 h-80 bg-teal-500/5 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
    
    <!-- Real-time Status Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/80 border border-emerald-500/30 text-emerald-400 text-xs sm:text-sm font-medium mb-6 shadow-lg shadow-emerald-950/30">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span class="text-slate-200">Live Deal Engine Active</span>
      <span class="text-emerald-500/40">•</span>
      <span class="text-emerald-400 font-semibold">Updated Every 60s</span>
    </div>

    <!-- Clean Headline -->
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.15] mb-5 max-w-4xl mx-auto">
      The Internet's Biggest Loot Drops, <br class="hidden sm:inline" />
      <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-emerald-400 bg-clip-text text-transparent">
        Verified 24/7
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-8 sm:mb-10 font-normal leading-relaxed">
      Secret pricing glitches, ₹1 flash sales, and up to 90% off deals across Amazon, Flipkart & Myntra before they expire.
    </p>

    <!-- Actions Container: High-Visibility CTA & Sleek Search Input -->
    <div class="flex flex-col items-center gap-5 max-w-xl mx-auto mb-12 sm:mb-16">
      <!-- Primary High-Visibility CTA Button with Subtle Emerald Glow -->
      <a
        href="/livedeals"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-2xl bg-gradient-to-r from-emerald-400 via-teal-400 to-emerald-400 hover:from-emerald-300 hover:to-teal-300 text-slate-950 font-black text-base shadow-xl shadow-emerald-500/25 hover:shadow-emerald-500/40 transition-all duration-200 hover:scale-[1.02] active:scale-[0.98]"
      >
        <span>⚡ Browse 200+ Live Deals →</span>
      </a>

      <!-- Sleek, Unobtrusive Search Input -->
      <form action="/livedeals" method="GET" class="w-full" id="hero-search-form">
        <div class="relative flex items-center bg-slate-900/80 border border-white/10 hover:border-white/20 focus-within:border-emerald-500/60 focus-within:ring-2 focus-within:ring-emerald-500/20 rounded-2xl shadow-xl backdrop-blur-xl transition-all p-1.5 sm:p-2">
          <div class="pl-3.5 pr-2 text-slate-400 flex items-center">
            <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>

          <input
            type="search"
            name="q"
            id="hero-search-input"
            autocomplete="off"
            spellcheck="false"
            placeholder="Search Amazon, Flipkart, Myntra deals..."
            class="w-full bg-transparent text-white placeholder-slate-400 text-sm sm:text-base px-2 py-1.5 sm:py-2 focus:outline-none"
          />

          <button
            type="submit"
            class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs sm:text-sm transition-all border border-white/5 shrink-0"
          >
            Search
          </button>
        </div>
      </form>
    </div>

    <!-- Social Proof & Trust Counter Badges -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 max-w-3xl mx-auto pt-6 border-t border-white/5">
      <div class="p-3.5 rounded-2xl bg-slate-900/40 border border-white/5 text-center">
        <div class="text-xl sm:text-2xl font-extrabold text-emerald-400">{memberCount}</div>
        <div class="text-xs text-slate-400 font-medium mt-0.5">Telegram VIPs</div>
      </div>
      <div class="p-3.5 rounded-2xl bg-slate-900/40 border border-white/5 text-center">
        <div class="text-xl sm:text-2xl font-extrabold text-teal-400">{totalSaved}</div>
        <div class="text-xs text-slate-400 font-medium mt-0.5">Estimated User Savings</div>
      </div>
      <div class="p-3.5 rounded-2xl bg-slate-900/40 border border-white/5 text-center">
        <div class="text-xl sm:text-2xl font-extrabold text-blue-400">100%</div>
        <div class="text-xs text-slate-400 font-medium mt-0.5">Verified Merchants</div>
      </div>
      <div class="p-3.5 rounded-2xl bg-slate-900/40 border border-white/5 text-center">
        <div class="text-xl sm:text-2xl font-extrabold text-amber-400">⚡ Instant</div>
        <div class="text-xs text-slate-400 font-medium mt-0.5">Price Glitch Alerts</div>
      </div>
    </div>

  </div>
</section>

<script is:inline>
  (function() {
    function setupHeroSearch() {
      const form = document.getElementById("hero-search-form");
      const input = document.getElementById("hero-search-input");
      if (form && input) {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          const q = input.value.trim();
          if (q) {
            window.location.href = `/livedeals?q=${encodeURIComponent(q)}`;
          } else {
            window.location.href = "/livedeals";
          }
        });
      }

      // Handle focusSearch parameter if redirected from another page
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get("focusSearch") === "1" && input) {
        setTimeout(() => {
          input.focus();
          input.scrollIntoView({ behavior: "smooth", block: "center" });
        }, 150);
      }
    }

    setupHeroSearch();
    document.addEventListener("astro:after-swap", setupHeroSearch);
  })();
</script>
