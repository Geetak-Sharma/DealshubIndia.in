    <a href="/settings" class="sidebar__link">
       <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.1a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
      <span>Settings</span>
    </a>
  </nav>

  <div class="sidebar__footer">
    <a
      href="https://whatsapp.com/channel/0029Va8sOrp4SpkEQKVElV1i"
      target="_blank"
      rel="noopener noreferrer"
      class="sidebar__join-btn"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
      Join WhatsApp Channel
    </a>
  </div>
</aside>

<script is:inline>
  function initNav() {
    const hamburger = document.getElementById('nav-hamburger');
    const sidebar   = document.getElementById('nav-sidebar');
    const overlay   = document.getElementById('nav-overlay');
    const closeBtn  = document.getElementById('nav-close');
    if (!hamburger || !sidebar) return;

    function openMenu() {
      if (typeof navigator !== 'undefined' && navigator.vibrate) navigator.vibrate(50);
      sidebar.classList.add('is-open');
      overlay.classList.add('is-open');
      hamburger.setAttribute('aria-expanded', 'true');
      sidebar.setAttribute('aria-hidden', 'false');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      if (typeof navigator !== 'undefined' && navigator.vibrate) navigator.vibrate(50);
      sidebar.classList.remove('is-open');
      overlay.classList.remove('is-open');
      hamburger.setAttribute('aria-expanded', 'false');
      sidebar.setAttribute('aria-hidden', 'true');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    hamburger.addEventListener('click', openMenu);

    if (closeBtn)  closeBtn.addEventListener('click', closeMenu);
    if (overlay)   overlay.addEventListener('click', closeMenu);

    // Close on Esc
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });

    const path = window.location.pathname;
    document.querySelectorAll('.nav__link, .sidebar__link').forEach(link => {
      const href = link.getAttribute('href');
      const isActive = href === '/'
        ? path === '/' || path === ''
        : path.startsWith(href);
      if (isActive) link.classList.add('is-active');
      else link.classList.remove('is-active');
    });

    // Add Mouse Tracker to Nav
    const navNode = document.querySelector('.nav');
    if (navNode) {
       navNode.addEventListener('mousemove', (e) => {
         const rect = navNode.getBoundingClientRect();
         navNode.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
         navNode.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
       });
       
       window.addEventListener('open-command-palette', () => navNode.classList.add('search-active'));
       window.addEventListener('close-command-palette', () => navNode.classList.remove('search-active'));
    }
  }

  document.addEventListener('astro:page-load', initNav);
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 200;
    background-color: hsla(189, 80%, 2%, 0.65);
    background-image: radial-gradient(
      600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(139, 92, 246, 0.1),
      transparent 80%
    );
    backdrop-filter: blur(32px) saturate(2.5) brightness(0.9);
    -webkit-backdrop-filter: blur(32px) saturate(2.5) brightness(0.9);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    box-shadow: 0 1px 0px rgba(255,255,255,0.03) inset;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    transition: backdrop-filter 0.3s ease, background-color 0.3s ease, -webkit-backdrop-filter 0.3s ease;
    padding-top: 0px;
    display: flex;
    flex-direction: column;
  }
  
  .nav.search-active {
    backdrop-filter: blur(64px) saturate(2.5) brightness(0.7);
    -webkit-backdrop-filter: blur(64px) saturate(2.5) brightness(0.7);
    background-color: hsla(189, 80%, 2%, 0.85); /* Slightly darker focus backdrop */
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 24px;
    height: 60px;
    width: 100%;
    margin-bottom: 0px; /* Separation from feed handled by container page layout */
  }

  /* Remove old search styles */
  .nav__search-row-mobile, 
  .nav__full-search-bar {
    display: none;
  }
  
  .nav__full-search-bar:active {
    transform: scale(0.98);
    background: rgba(255, 255, 255, 0.08);
  }

  .nav__full-search-text {
    color: var(--text-tertiary);
    font-size: 14px;
    font-weight: 500;
  }

  /* ===== BRAND ===== */
  .nav__brand {
    position: relative;
    z-index: 210;
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
    background: transparent;
  }

  .nav__logo {
    display: flex;
    align-items: center;
    font-size: 1.2rem;
    font-weight: 900;
    color: var(--text-primary);
    letter-spacing: -0.4px;
    white-space: nowrap;
    line-height: 1;
  }

  .nav__accent-neon {
    color: #39FF14;
    text-shadow: 0 0 10px rgba(57, 255, 20, 0.2);
  }

  /* Status badges removed in favor of TelegramFeed Status Strip */
  .nav__status-badge, .nav__status-indicator {
    display: none;
  }

  /* ===== DESKTOP NAV LINKS ===== */
  .nav__links {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .nav__links {
      display: none;
    }
  }

  .nav__link {
    position: relative;
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.2px;
    text-transform: none;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all 0.15s cubic-bezier(0.2, 0.8, 0.2, 1);
    white-space: nowrap;
  }

  .nav__link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-1px);
  }

  .nav__link.is-active {
    color: #39FF14;
    background: rgba(57, 255, 20, 0.06);
    box-shadow: 0 0 15px rgba(57, 255, 20, 0.1);
  }

  /* Quick Commerce nav link — orange accent */
  .nav__link--qc {
    color: rgba(252, 128, 25, 0.7);
  }
  .nav__link--qc:hover {
    color: #FC8019;
    background: rgba(252, 128, 25, 0.08);
  }
  .nav__link--qc.is-active {
    color: #FC8019;
    background: rgba(252, 128, 25, 0.10);
    box-shadow: 0 0 15px rgba(252, 128, 25, 0.15);
  }

  /* Sidebar QC link + badge */
  .sidebar__link--qc {
    color: rgba(252, 128, 25, 0.75) !important;
  }
  .sidebar__link--qc:hover {
    color: #FC8019 !important;
    background: rgba(252, 128, 25, 0.07) !important;
  }
  .sidebar__qc-badge {
    margin-left: auto;
    padding: 2px 7px;
    background: rgba(252, 128, 25, 0.12);
    border: 1px solid rgba(252, 128, 25, 0.25);
    border-radius: 99px;
    font-size: 8px;
    font-weight: 800;
    color: #FC8019;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  /* ===== SEARCH / CMD+K TRIGGER ===== */
  .nav__search {
    flex: 1;
    min-width: 180px;
    max-width: 380px;
    padding-left: 16px;
  }

  .nav__cmd-trigger {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 9px 16px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 12px;
    color: rgba(255, 255, 255, 0.65);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: left;
    white-space: nowrap;
    font-family: inherit;
  }

  .nav__cmd-trigger:hover {
    background: rgba(255, 255, 255, 0.11);
    border-color: rgba(57, 255, 20, 0.45);
    color: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 20px rgba(57, 255, 20, 0.12);
  }

  .nav__cmd-label {
    flex: 1; 
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav__cmd-kbd {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    font-size: 10px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.75);
    font-family: inherit;
    flex-shrink: 0;
    letter-spacing: 0.3px;
  }

  /* ===== RIGHT AREA & CONTROL CLUSTER ===== */
  .nav__right {
    display: flex;
    align-items: center;
  }

  .nav__control-cluster {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 100%;
  }

  .nav__join-btn-icon {

    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: rgba(34, 197, 94, 0.05); /* very subtle so neon pop feels profound */
    border: 1px solid rgba(34, 197, 94, 0.2);
    transition: all 0.2s ease;
    cursor: pointer;
    filter: drop-shadow(0 0 8px rgba(37, 211, 102, 0.2));
  }
  
  .nav__join-btn-icon:hover {
    background: rgba(34, 197, 94, 0.15);
    border-color: rgba(34, 197, 94, 0.5);
    transform: scale(1.1);
    box-shadow: 0 4px 18px rgba(34, 197, 94, 0.35);
  }


  /* ===== LIVE PILL ===== */
  .nav__live-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px 1px 8px; /* Matching exact padding with status-badge */
    border-radius: 9999px;
    background: rgba(57, 255, 20, 0.1);
    border: 1px solid rgba(57, 255, 20, 0.2);
    color: #39FF14;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.5px;
    line-height: 1; /* Match baseline height */
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 0 10px rgba(74, 222, 128, 0.4);
    animation: lootPulseGlow 3.5s ease-in-out infinite;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav__live-pill:hover {
    background: rgba(57, 255, 20, 0.18);
    border-color: rgba(57, 255, 20, 0.6);
    box-shadow: 0 0 20px rgba(74, 222, 128, 0.6);
  }

  .live-dot {
    width: 6px;
    height: 6px;
    background: #22C55E;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    animation: liveDotPing 1.8s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes liveDotPing {
    0%   { transform: scale(1);    box-shadow: 0 0 0 0   rgba(34, 197, 94, 0.8); }
    60%  { transform: scale(1.15); box-shadow: 0 0 0 6px rgba(34, 197, 94, 0); }
    100% { transform: scale(1);    box-shadow: 0 0 0 0   rgba(34, 197, 94, 0); }
