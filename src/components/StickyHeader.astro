---
import BrandLogo from './BrandLogo.astro';
---

<header class="nav" transition:persist>
  <div class="nav__inner">

    <!-- Logo -->
    <a href="/" class="nav__brand" aria-label="DealsHub India Home">
      <BrandLogo size={30} gradientId="header-logo-grad" />
      <span class="nav__logo">DealsHub<span class="nav__accent-neon">India</span></span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="nav__links" aria-label="Main navigation">
      <a href="/" class="nav__link" data-navlink="home">Deals</a>
      <a href="/livedeals" class="nav__link" data-navlink="livedeals">Live Deals</a>
      <a href="/quick-commerce" class="nav__link nav__link--qc" data-navlink="quick-commerce">🍕 Quick Commerce</a>
      <a href="/blog" class="nav__link" data-navlink="blog">Blog</a>
      <a href="/about" class="nav__link" data-navlink="about">About</a>
      <a href="/contact" class="nav__link" data-navlink="contact">Contact</a>
    </nav>

    <!-- Desktop Search Trigger (CMD+K) -->
    <div class="nav__search">
      <button
        class="nav__cmd-trigger"
        id="nav-search-trigger"
        aria-label="Search deals (Ctrl+K)"
        onclick="window.dispatchEvent(new CustomEvent('open-command-palette'))"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <span class="nav__cmd-label">Search deals, categories…</span>
        <kbd class="nav__cmd-kbd">Ctrl K</kbd>
      </button>
    </div>

    <!-- Right Area -->
    <div class="nav__right">
      <div class="nav__control-cluster">
        <a
          href="https://whatsapp.com/channel/0029Va8sOrp4SpkEQKVElV1i"
          target="_blank"
          rel="noopener noreferrer"
          class="nav__join-btn-icon pulse-button"
          aria-label="Join WhatsApp Channel"
          onclick="if(navigator.vibrate) navigator.vibrate(50);"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#22C55E"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        </a>

        <!-- Hamburger Button -->
        <button class="nav__hamburger" id="nav-hamburger" aria-label="Open menu" aria-expanded="false">
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>
      </div>
    </div>

  </div>

</header>

<!-- Mobile Sidebar Overlay -->
<div class="nav__overlay" id="nav-overlay" aria-hidden="true"></div>

<!-- Mobile Sidebar -->
