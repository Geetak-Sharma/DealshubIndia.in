---
interface Props {
  variant?: 'default' | 'success' | 'warning' | 'destructive' | 'outline' | 'aiDecision' | 'neutral';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const variantClasses = {
  default: 'bg-primary text-primary-foreground hover:bg-primary/80 border-transparent',
  success: 'bg-success text-white hover:bg-success/80 border-transparent',
  warning: 'bg-warning text-white hover:bg-warning/80 border-transparent',
  destructive: 'bg-destructive text-destructive-foreground hover:bg-destructive/80 border-transparent',
  outline: 'text-foreground border-border hover:bg-accent hover:text-accent-foreground',
  aiDecision: 'bg-primary/10 text-primary border-primary/20',
  neutral: 'bg-muted text-muted-foreground border-transparent'
};
---
<span class:list={[
  'inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2',
  variantClasses[variant],
  className
]}>
  <slot />
</span>
