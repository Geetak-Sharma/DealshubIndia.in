---
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "@/utils/cn";

const cardVariants = cva(
  "rounded-[var(--radius)] border bg-card text-card-foreground shadow-sm",
  {
    variants: {
      padding: { none: "", sm: "p-3", default: "p-4", lg: "p-6" },
      interactive: {
        true: "transition-transform hover:-translate-y-1 hover:shadow-md cursor-pointer",
        false: "",
      },
    },
    defaultVariants: { padding: "default", interactive: false },
  }
);

interface Props extends VariantProps<typeof cardVariants> {
  class?: string;
  [key: string]: any;
}

const { padding, interactive, class: className, ...rest } = Astro.props;
---
<div class={cn(cardVariants({ padding, interactive }), className)} {...rest}>
  <slot />
</div>
