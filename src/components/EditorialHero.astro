---
interface Props {
  memberCount?: string;
  totalSaved?: string;
}

const {
  memberCount = "15,000+",
  totalSaved = "₹2.5 Cr+",
} = Astro.props;
---

<section class="relative pt-6 sm:pt-10 pb-8 sm:pb-10 overflow-hidden">
  <!-- Subtle ambient editorial backdrop -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-center">
      
      <!-- ================= LEFT COLUMN: EDITORIAL IDENTITY & SEARCH ================= -->
      <div class="lg:col-span-7 xl:col-span-8 flex flex-col justify-center">
        <!-- Crisp Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-[1.14] mb-3">
          Curated Deals &amp; Shopping Guides. <br class="hidden sm:inline" />
          <span class="text-slate-100 underline decoration-emerald-500/60 decoration-4 underline-offset-8">Hand-verified, zero fluff.</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-normal mb-6 max-w-2xl">
          Our automated scrapers track 200+ drops daily across Amazon and Flipkart. We filter out the noise and publish only genuine, lowest-ever price drops.
        </p>

        <!-- Quick Search Bar Integrated Cleanly -->
        <form action="/livedeals" method="GET" class="w-full max-w-xl" id="hero-editorial-search">
          <div class="relative flex items-center bg-slate-900/90 border border-slate-800 hover:border-slate-700 focus-within:border-emerald-500/70 focus-within:ring-2 focus-within:ring-emerald-500/20 rounded-xl transition-all p-1.5 shadow-sm">
            <div class="pl-3 pr-2 text-slate-400 flex items-center">
              <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>

            <input
              type="search"
              name="q"
              id="hero-editorial-search-input"
              autocomplete="off"
              spellcheck="false"
              placeholder="Search 200+ live deals by brand, product, or store..."
              class="w-full bg-transparent text-white placeholder-slate-500 text-xs sm:text-sm px-2 py-1.5 focus:outline-none"
            />

            <button
              type="submit"
              class="px-3.5 py-1.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs sm:text-sm transition-all shrink-0"
            >
              Search ↵
            </button>
          </div>

          <!-- Fast shortcut chips -->
          <div class="flex items-center gap-2 mt-2.5 flex-wrap text-[11px] text-slate-400 font-mono">
            <span class="text-slate-400">Quick jump:</span>
            <a href="/blog" class="inline-flex items-center gap-1 text-emerald-400 hover:text-emerald-300 font-bold underline decoration-emerald-500/40 hover:decoration-emerald-400 transition-colors"><span>📚 Sale Guides</span></a>
            <span>•</span>
            <a href="/livedeals?q=Amazon" class="hover:text-amber-400 underline decoration-slate-700 hover:decoration-amber-400 transition-colors">#Amazon</a>
            <span>•</span>
            <a href="/livedeals?q=Flipkart" class="hover:text-blue-400 underline decoration-slate-700 hover:decoration-blue-400 transition-colors">#Flipkart</a>
            <span>•</span>
            <a href="/livedeals?q=Loot" class="hover:text-rose-400 underline decoration-slate-700 hover:decoration-rose-400 transition-colors">#PriceGlitch</a>
            <span>•</span>
            <a href="/livedeals?q=Tech" class="hover:text-emerald-400 underline decoration-slate-700 hover:decoration-emerald-400 transition-colors">#Electronics</a>
            <span>•</span>
            <a href="/livedeals?q=99" class="hover:text-yellow-400 underline decoration-slate-700 hover:decoration-yellow-400 transition-colors">#Under999</a>
          </div>
        </form>
      </div>

      <!-- ================= RIGHT COLUMN: DUAL COMMUNITY HUB / WHATSAPP & TELEGRAM ALERT BOX ================= -->
      <div class="lg:col-span-5 xl:col-span-4">
        <div class="bg-slate-900/90 border border-slate-800 hover:border-slate-700/80 rounded-2xl p-5 sm:p-6 transition-all shadow-xl shadow-black/40">
          <div class="flex items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-[#25D366] to-[#0088cc] flex items-center justify-center text-white shrink-0 shadow-sm shadow-emerald-500/20">
                <span class="text-sm font-bold">⚡</span>
              </div>
              <div>
                <div class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-400">⚡ INSTANT PRICE DROP CHANNELS</div>
                <div class="flex items-center gap-1.5 text-[11px] text-slate-400">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span>115k+ Deal Hunters</span>
                </div>
              </div>
            </div>
            <span class="font-mono text-[10px] text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded-full font-bold whitespace-nowrap">100% Free · Real-time</span>
          </div>

          <p class="text-xs sm:text-sm text-slate-300 mb-4 leading-relaxed font-normal">
            Never miss a ₹1 drop or price glitch. Pick your preferred platform for instant alerts.
          </p>

          <!-- TWO Equal High-Converting Buttons -->
          <div class="flex flex-col gap-2.5">
            <!-- 1. WhatsApp Channel -->
            <a
              href="https://whatsapp.com/channel/0029Vb81sJqGk1FxL7t9lW0h"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-between px-4 py-2.5 rounded-xl bg-[#25D366] hover:bg-[#20bd5a] text-slate-950 font-bold text-xs sm:text-sm shadow-md shadow-[#25D366]/20 transition-all hover:scale-[1.01] active:scale-[0.98] group"
            >
              <div class="flex items-center gap-2.5">
                <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
                <span>Join WhatsApp Channel</span>
              </div>
              <span class="text-[11px] font-bold bg-black/15 text-slate-950 px-2 py-0.5 rounded-full whitespace-nowrap">100k+ Followers ↗</span>
            </a>

            <!-- 2. Telegram Channel -->
            <a
              href="https://t.me/DealsHubIndia"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-between px-4 py-2.5 rounded-xl bg-[#0088cc] hover:bg-[#0077b5] text-white font-bold text-xs sm:text-sm shadow-md shadow-[#0088cc]/25 transition-all hover:scale-[1.01] active:scale-[0.98] group"
            >
              <div class="flex items-center gap-2.5">
                <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .4z"/>
                </svg>
                <span>Join Telegram Channel</span>
              </div>
              <span class="text-[11px] font-bold bg-white/20 text-white px-2 py-0.5 rounded-full whitespace-nowrap">15k+ Hunters ↗</span>
            </a>
          </div>

          <div class="mt-3 flex items-center justify-between text-[11px] text-slate-400 font-mono">
            <span>⚡ Muteable alerts</span>
            <span>•</span>
            <span>Zero spam</span>
            <span>•</span>
            <span>1-click exit</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
