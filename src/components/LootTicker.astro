---
export interface Props {
  badgeText?: string;
}

const {
  badgeText = "BETA PREVIEW",
} = Astro.props;
---

<aside
  id="beta-announcement-ticker"
  aria-label="DealsHub Beta Announcement"
  class="w-full bg-[#151922] border-b border-white/10 text-white text-xs py-1.5 sm:py-2 px-3 sm:px-4 lg:px-6 relative z-40 select-none shadow-sm backdrop-blur-md"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-2 sm:gap-4 relative">
    <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
      <span class="relative flex h-2 w-2 shrink-0" aria-hidden="true">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400 shadow-[0_0_8px_#34d399]"></span>
      </span>

      <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
        {badgeText}
      </span>
    </div>

    <div class="flex items-center justify-center text-center px-2 min-w-0 flex-1">
      <p class="text-xs sm:text-sm text-slate-300 font-medium truncate sm:whitespace-normal">
        <span class="text-amber-300 font-semibold">⚡ Notice:</span>
        <span class="text-slate-100 ml-1 font-semibold">This site is currently in beta.</span>
        <span class="hidden md:inline text-slate-400 ml-1.5">We are actively fine-tuning live loot feeds, filters, and smart tools.</span>
      </p>
    </div>

    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <a
        href="https://whatsapp.com/channel/0029Vb81sJqGk1FxL7t9lW0h"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl bg-[#25D366]/15 hover:bg-[#25D366] text-[#25D366] hover:text-slate-950 border border-[#25D366]/30 transition-all text-xs font-bold shadow-sm group shrink-0"
        title="Join DealsHub WhatsApp Alerts"
      >
        <span class="hidden sm:inline">WhatsApp</span>
      </a>
      <a
        href="https://t.me/DealsHubIndiaa"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl bg-[#0088cc]/15 hover:bg-[#0088cc] text-sky-400 hover:text-white border border-[#0088cc]/30 transition-all text-xs font-bold shadow-sm group shrink-0"
        title="Join DealsHub Telegram Channel"
      >
        <span class="hidden sm:inline">Telegram</span>
      </a>
    </div>
  </div>
</aside>
