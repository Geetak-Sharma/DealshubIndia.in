---
interface Props {
  id?: string;
  title: string;
  price: string | number;
  originalPrice?: string | number;
  discount?: string | number;
  link?: string;
  url?: string;
  image?: string;
  merchant?: string;
  platform?: string;
  category?: string;
  isLoot?: boolean;
  date?: string | Date;
  timestamp?: number | string | Date;
  index?: number;
  couponText?: string;
  bankOffer?: string;
  variants?: Array<{ title: string; url: string; price?: string }>;
  budgetTier?: string;
  [key: string]: any;
}

const {
  id,
  title,
  price,
  originalPrice,
  discount,
  link,
  url,
  image,
  merchant,
  platform,
  category = "General",
  isLoot = false,
  date,
  timestamp,
  index = 0,
  couponText,
  bankOffer,
  variants = [],
  budgetTier,
} = Astro.props;

const targetLink = link || url || "#";
const targetMerchant = merchant || platform || "Amazon";
const targetDate = date || timestamp;

// Clean up title
const cleanedTitle = title
  ? title
      .replace(/[\u200e\u200f\u200b\uFEFF]/g, "")
      .replace(/^[\p{Emoji}\s]+/gu, "")
      .replace(/#\w+/gi, "")
      .replace(/^(?:amazon|flipkart|myntra|ajio|croma|meesho)\s*[:|\-–]\s*/i, "")
      .replace(/sale\s*-/gi, "")
      .replace(/cashback card on all online transactions-?/gi, "")
      .replace(/for under 99 deals join-?.*/gi, "")
      .replace(/under 99 deals join-?.*/gi, "")
      .replace(/_______________________________.*/gi, "")
      .replace(/Master Link\s*:?.*/gi, "")
      .replace(/^%?\s*(?:off|discount)\s*[:|\-–]?\s*/i, "")
      .replace(/^[\d]+%\s*(?:off|discount)\s*[:|\-–]?\s*/i, "")
      .replace(/\s*@\s*₹?[0-9,]+/gi, "")
      .replace(/Apply\s*(?:₹\s*\d+|\d+%)\s*coupon/gi, "")
      .replace(/\s*\.?\s*Apply\s*(?:₹\s*\d+|\d+%)\s*Off\s*Coupon.*$/i, "")
      .replace(/\s*(?:@|at\s*|Rs\.?\s*|₹)\s*[0-9,]+\s*$/i, "")
      .replace(/[:\.\-\s|–]+$/, "")
      .trim()
  : "Handpicked Loot Deal";

// Format prices
const numPrice = typeof price === "number" ? price : (parseFloat(String(price || "0").replace(/[^0-9.]/g, "")) || 0);
const numOriginal = typeof originalPrice === "number" ? originalPrice : (parseFloat(String(originalPrice || "0").replace(/[^0-9.]/g, "")) || 0);
let discountPercent = discount ? String(discount).replace(/[^0-9]/g, "") : "";
if (!discountPercent && numOriginal > numPrice && numPrice > 0) {
  discountPercent = String(Math.round(((numOriginal - numPrice) / numOriginal) * 100));
}
const savingsAmount = numOriginal > numPrice ? numOriginal - numPrice : 0;

// Merchant badge styling (Dark Pastel)
let merchantBadgeBg = "bg-amber-500/15 text-amber-200 border-amber-400/30";
let merchantLabel = "Amazon";
const merchantLower = targetMerchant.toLowerCase();
if (merchantLower.includes("flipkart") || merchantLower.includes("fkrt")) {
  merchantLabel = "Flipkart";
  merchantBadgeBg = "bg-blue-500/15 text-blue-200 border-blue-400/30";
} else if (merchantLower.includes("myntra")) {
  merchantLabel = "Myntra";
  merchantBadgeBg = "bg-rose-500/15 text-rose-200 border-rose-400/30";
} else if (merchantLower.includes("ajio")) {
  merchantLabel = "Ajio";
  merchantBadgeBg = "bg-purple-500/15 text-purple-200 border-purple-400/30";
} else if (merchantLower.includes("meesho")) {
  merchantLabel = "Meesho";
  merchantBadgeBg = "bg-fuchsia-500/15 text-fuchsia-200 border-fuchsia-400/30";
}

// Time calculation
let timeAgo = "Active";
if (targetDate) {
  const d = new Date(targetDate);
  if (!isNaN(d.getTime())) {
    const diffMins = Math.floor((Date.now() - d.getTime()) / (1000 * 60));
    if (diffMins < 5) timeAgo = "Just now";
    else if (diffMins < 60) timeAgo = `${diffMins}m ago`;
    else {
      const diffHours = Math.floor(diffMins / 60);
      if (diffHours < 24) timeAgo = `${diffHours}h ago`;
      else timeAgo = `${Math.floor(diffHours / 24)}d ago`;
    }
  }
}

// 1-Click WhatsApp Share text format
const priceDisplay = numPrice > 0 ? `₹${numPrice.toLocaleString("en-IN")}` : (price ? `₹${price}` : "Check Price");
const mrpDisplay = numOriginal > numPrice ? `₹${numOriginal.toLocaleString("en-IN")}` : "";

let whatsappMsg = `🔥 *${cleanedTitle}*\n`;
whatsappMsg += `💰 *Deal Price:* ${priceDisplay}\n`;
if (mrpDisplay && discountPercent) {
  whatsappMsg += `🏷️ *Discount:* ${discountPercent}% OFF (MRP: ${mrpDisplay})\n`;
}
whatsappMsg += `⚡ *Store:* ${merchantLabel}\n`;
whatsappMsg += `👉 *Grab Deal:*\n${targetLink}\n\n📢 DealsHub India`;

const whatsappShareUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(whatsappMsg)}`;

// Image handling
const displayImage = image && typeof image === 'string' && image.startsWith('http') && !image.includes("Telegram_logo") && !image.includes("example.com") ? image : null;
const safeImageUrl = displayImage
  ? (displayImage.includes('telesco.pe') ? '/api/image-proxy?url=' + encodeURIComponent(displayImage) : displayImage)
  : null;
const fallbackImage = `data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="300" height="300" viewBox="0 0 300 300"><rect width="300" height="300" fill="%23f8fafc"/><circle cx="150" cy="120" r="36" fill="%23e2e8f0"/><text x="150" y="128" dominant-baseline="middle" text-anchor="middle" font-size="24">🛍️</text><text x="150" y="185" dominant-baseline="middle" text-anchor="middle" font-family="sans-serif" font-size="12" font-weight="bold" fill="%2310b981">Verified Drop</text><text x="150" y="208" dominant-baseline="middle" text-anchor="middle" font-family="sans-serif" font-size="11" fill="%2364748b">${merchantLabel}</text></svg>`;
---

<article
  class="notion-card group flex flex-col justify-between p-3.5 sm:p-4 rounded-xl relative"
  data-id={id}
  data-merchant={merchantLower}
  data-price={numPrice}
>
  <div>
    <!-- Top Metadata Bar: Store Pill & Time -->
    <div class="flex items-center justify-between gap-2 mb-2.5">
      <span class:list={["inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-bold border", merchantBadgeBg]}>
        <span>{merchantLabel}</span>
      </span>

      <div class="flex items-center gap-1.5 font-mono text-[11px] text-slate-400">
        {budgetTier === 'under99' ? (
          <span class="text-rose-300 font-bold bg-rose-500/20 border border-rose-400/30 px-1.5 py-0.5 rounded text-[10px]">⚡ Under ₹99</span>
        ) : (
          <span>{timeAgo}</span>
        )}
      </div>
    </div>

    <!-- Product Image Frame -->
    <a
      href={targetLink}
      target="_blank"
      rel="noopener noreferrer sponsored"
      class="block w-full h-36 bg-white/95 hover:bg-white rounded-lg p-2.5 mb-3 border border-white/10 transition-colors flex items-center justify-center overflow-hidden"
    >
      <img
        src={safeImageUrl || fallbackImage}
        alt={cleanedTitle}
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        class="max-h-32 max-w-full object-contain mix-blend-multiply group-hover:scale-105 transition-transform duration-200"
        onerror={`this.onerror=null;this.src='${fallbackImage}';`}
      />
    </a>

    <!-- Product Title -->
    <a href={targetLink} target="_blank" rel="noopener noreferrer sponsored" class="block group/title">
      <h3 class="font-medium text-slate-100 text-xs sm:text-sm leading-snug line-clamp-2 group-hover/title:text-emerald-300 transition-colors">
        {cleanedTitle}
      </h3>
    </a>

    <!-- Coupon or Bank Offer Highlight if available -->
    {couponText && (
      <div class="mt-2 text-[10px] font-mono font-medium text-amber-200 bg-amber-500/15 border border-amber-400/30 rounded px-1.5 py-0.5 line-clamp-1">
        ✂️ {couponText}
      </div>
    )}
  </div>

  <!-- Bottom Price & Actions Row -->
  <div class="pt-3 border-t border-white/10 mt-3 flex items-center justify-between gap-2">
    <div class="font-mono flex items-baseline gap-1.5">
      <span class="text-base sm:text-lg font-bold text-emerald-300">{priceDisplay}</span>
      {mrpDisplay && (
        <span class="text-xs text-slate-400 line-through">{mrpDisplay}</span>
      )}
      {discountPercent && (
        <span class="text-[10px] font-bold text-emerald-200 bg-emerald-500/20 px-1.5 py-0.5 rounded border border-emerald-400/40">
          {discountPercent}% OFF
        </span>
      )}
    </div>

    <div class="flex items-center gap-1.5 shrink-0">
      <!-- WhatsApp share -->
      <a
        href={whatsappShareUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share deal on WhatsApp"
        class="p-1.5 rounded-md hover:bg-white/10 text-slate-400 hover:text-emerald-300 transition-colors"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
      </a>

      <!-- Direct Outbound Grab Button -->
      <a
        href={targetLink}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="px-3 py-1 bg-emerald-400/20 hover:bg-emerald-400/30 border border-emerald-400/40 text-emerald-200 text-xs font-semibold rounded-md transition-all shadow-sm flex items-center gap-1"
      >
        <span>Grab</span>
        <span class="text-emerald-400 text-[11px]">↗</span>
      </a>
    </div>
  </div>
</article>

