---
// src/components/MobileDock.astro
// Fixed glass bottom navigation for mobile viewports (sm:hidden)
---

<nav
  class="fixed bottom-0 left-0 right-0 z-50 sm:hidden bg-white/95 backdrop-blur-2xl border-t border-gray-200 px-3 py-2 pb-[max(env(safe-area-inset-bottom),0.65rem)] shadow-[0_-4px_20px_rgba(0,0,0,0.06)] transition-transform duration-300"
  id="mobile-nav-dock"
  aria-label="Mobile Navigation"
>
  <div class="grid grid-cols-4 items-center max-w-md mx-auto gap-1">
    
    <!-- 1. Home -->
    <a
      href="/"
      id="dock-tab-home"
      class="dock-item flex flex-col items-center justify-center py-1 px-2 rounded-xl text-gray-500 hover:text-emerald-600 active:scale-95 transition-all group"
      aria-label="Home"
    >
      <div class="w-6 h-6 flex items-center justify-center text-current group-hover:scale-110 transition-transform">
        <svg class="w-5 h-5 fill-none stroke-current stroke-[2.2]" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
      </div>
      <span class="text-[10px] font-bold tracking-tight mt-0.5">Home</span>
    </a>

    <!-- 2. Live Deals -->
    <a
      href="/livedeals"
      id="dock-tab-deals"
      class="dock-item flex flex-col items-center justify-center py-1 px-2 rounded-xl text-gray-500 hover:text-emerald-600 active:scale-95 transition-all group relative"
      aria-label="Live Deals"
    >
      <div class="w-6 h-6 flex items-center justify-center text-current group-hover:scale-110 transition-transform relative">
        <span class="text-base leading-none">⚡</span>
        <span class="absolute -top-1 -right-1 flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
      </div>
      <span class="text-[10px] font-bold tracking-tight mt-0.5">Live Deals</span>
    </a>

    <!-- 3. Search -->
    <button
      type="button"
      id="dock-tab-search"
      class="dock-item flex flex-col items-center justify-center py-1 px-2 rounded-xl text-gray-500 hover:text-emerald-600 active:scale-95 transition-all group"
      aria-label="Search deals"
    >
      <div class="w-6 h-6 flex items-center justify-center text-current group-hover:scale-110 transition-transform">
        <svg class="w-5 h-5 fill-none stroke-current stroke-[2.2]" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <path stroke-linecap="round" d="m21 21-4.35-4.35"/>
        </svg>
      </div>
      <span class="text-[10px] font-bold tracking-tight mt-0.5">Search</span>
    </button>

    <!-- 4. Alerts Button (Opens quick WhatsApp & Telegram action sheet) -->
    <button
      type="button"
      id="dock-tab-alerts"
      class="flex flex-col items-center justify-center py-1 px-2 rounded-xl text-emerald-400 hover:text-emerald-300 active:scale-95 transition-all relative group"
      aria-label="Instant Price Drop Alerts"
      aria-haspopup="dialog"
      aria-expanded="false"
    >
      <div class="relative flex items-center justify-center w-7 h-7 rounded-xl bg-gradient-to-tr from-[#25D366] via-emerald-500 to-[#0088cc] text-slate-950 font-black shadow-md shadow-emerald-500/25 group-hover:scale-105 transition-transform">
        <span class="animate-ping absolute inset-0 rounded-xl bg-emerald-400 opacity-40"></span>
        <svg class="w-4 h-4 fill-none stroke-slate-950 stroke-[2.4] relative z-10" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0M3.124 7.5A8.969 8.969 0 015.292 3m13.416 0a8.969 8.969 0 012.168 4.5" />
        </svg>
      </div>
      <span class="text-[9px] font-black uppercase text-emerald-400 tracking-tight mt-0.5">Alerts</span>
    </button>

  </div>
</nav>

<!-- Mobile Alerts Drawer / Action Sheet -->
<div
  id="mobile-alerts-sheet"
  class="fixed inset-x-0 bottom-0 z-[60] sm:hidden translate-y-full transition-transform duration-300 ease-out pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-label="Instant Deal Alerts"
>
  <!-- Backdrop -->
  <div id="mobile-alerts-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-none"></div>

  <!-- Sheet Container -->
  <div class="relative bg-slate-900 border-t border-emerald-500/30 rounded-t-3xl p-5 pb-8 shadow-2xl shadow-black pointer-events-auto space-y-4 max-w-md mx-auto">
    <div class="flex items-center justify-between border-b border-white/10 pb-3">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <h3 class="text-sm font-bold text-white uppercase tracking-wider font-mono">⚡ Instant Deal Alerts</h3>
      </div>
      <button
        type="button"
        id="close-alerts-sheet"
        class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center text-xs font-bold transition-colors"
        aria-label="Close alerts menu"
      >
        ✕
      </button>
    </div>

    <p class="text-xs text-slate-300 leading-relaxed">
      Never miss a ₹1 flash drop or price glitch. Choose your preferred platform for real-time notifications:
    </p>

    <div class="space-y-2.5">
      <!-- WhatsApp Option -->
      <a
        href="https://whatsapp.com/channel/0029Vb81sJqGk1FxL7t9lW0h"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between p-3 rounded-xl bg-[#25D366] hover:bg-[#20bd5a] text-slate-950 font-bold text-sm shadow-md transition-all active:scale-[0.98]"
      >
        <div class="flex items-center gap-2.5">
          <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          <span>Join WhatsApp Channel</span>
        </div>
        <span class="text-[11px] bg-black/15 text-slate-950 font-bold px-2 py-0.5 rounded-full">Free ↗</span>
      </a>

      <!-- Telegram Option -->
      <a
        href="https://t.me/DealsHubIndiaa"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between p-3 rounded-xl bg-[#0088cc] hover:bg-[#0077b5] text-white font-bold text-sm shadow-md transition-all active:scale-[0.98]"
      >
        <div class="flex items-center gap-2.5">
          <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .4z"/>
          </svg>
          <span>Join Telegram Channel</span>
        </div>
        <span class="text-[11px] bg-white/20 text-white font-bold px-2 py-0.5 rounded-full">Free ↗</span>
      </a>
    </div>

    <div class="text-[11px] text-slate-400 text-center pt-1 font-mono">
      <span>100% Free • Mute or Exit Anytime</span>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    function setupMobileDock() {
      const searchBtn = document.getElementById("dock-tab-search");
      const dealsBtn = document.getElementById("dock-tab-deals") || document.getElementById("dock-tab-loots");
      const homeBtn = document.getElementById("dock-tab-home");
      const alertsBtn = document.getElementById("dock-tab-alerts");
      const alertsSheet = document.getElementById("mobile-alerts-sheet");
      const alertsBackdrop = document.getElementById("mobile-alerts-backdrop");
      const closeAlertsBtn = document.getElementById("close-alerts-sheet");

      // Highlight active tab
      const pathname = window.location.pathname;
      if (homeBtn && (pathname === "/" || pathname === "")) {
        homeBtn.classList.add("text-emerald-400");
        homeBtn.classList.remove("text-slate-400");
      } else if (homeBtn) {
        homeBtn.classList.remove("text-emerald-400");
        homeBtn.classList.add("text-slate-400");
      }

      if (dealsBtn && (pathname === "/livedeals" || pathname.startsWith("/livedeals"))) {
        dealsBtn.classList.add("text-emerald-400");
        dealsBtn.classList.remove("text-slate-400");
      } else if (dealsBtn) {
        dealsBtn.classList.remove("text-emerald-400");
        dealsBtn.classList.add("text-slate-400");
      }

      // Alerts Drawer toggling
      function openAlerts() {
        if (navigator.vibrate) navigator.vibrate(30);
        if (alertsSheet && alertsBackdrop) {
          alertsSheet.classList.remove("translate-y-full", "pointer-events-none");
          alertsSheet.classList.add("translate-y-0", "pointer-events-auto");
          alertsBackdrop.classList.remove("opacity-0", "pointer-events-none");
          alertsBackdrop.classList.add("opacity-100", "pointer-events-auto");
          if (alertsBtn) alertsBtn.setAttribute("aria-expanded", "true");
        }
      }

      function closeAlerts() {
        if (alertsSheet && alertsBackdrop) {
          alertsSheet.classList.remove("translate-y-0", "pointer-events-auto");
          alertsSheet.classList.add("translate-y-full", "pointer-events-none");
          alertsBackdrop.classList.remove("opacity-100", "pointer-events-auto");
          alertsBackdrop.classList.add("opacity-0", "pointer-events-none");
          if (alertsBtn) alertsBtn.setAttribute("aria-expanded", "false");
        }
      }

      if (alertsBtn && !alertsBtn.dataset.hasListener) {
        alertsBtn.dataset.hasListener = "true";
        alertsBtn.addEventListener("click", (e) => {
          e.preventDefault();
          const isExpanded = alertsBtn.getAttribute("aria-expanded") === "true";
          if (isExpanded) {
            closeAlerts();
          } else {
            openAlerts();
          }
        });
      }

      if (closeAlertsBtn && !closeAlertsBtn.dataset.hasListener) {
        closeAlertsBtn.dataset.hasListener = "true";
        closeAlertsBtn.addEventListener("click", closeAlerts);
      }

      if (alertsBackdrop && !alertsBackdrop.dataset.hasListener) {
        alertsBackdrop.dataset.hasListener = "true";
        alertsBackdrop.addEventListener("click", closeAlerts);
      }

      // Close drawer on any alert link click
      if (alertsSheet) {
        alertsSheet.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            setTimeout(closeAlerts, 150);
          });
        });
      }

      // 1. Search button click handler
      if (searchBtn && !searchBtn.dataset.hasListener) {
        searchBtn.dataset.hasListener = "true";
        searchBtn.addEventListener("click", () => {
          if (navigator.vibrate) navigator.vibrate(30);

          const liveSearch = document.getElementById("live-search-input");
          const heroInput = document.getElementById("hero-search-input");
          const targetInput = liveSearch || heroInput;

          if (targetInput) {
            targetInput.focus();
            targetInput.scrollIntoView({ behavior: "smooth", block: "center" });
          } else {
            window.dispatchEvent(new CustomEvent("open-command-palette"));
            window.dispatchEvent(new CustomEvent("open-search-palette"));
            if (window.location.pathname !== "/livedeals") {
              window.location.href = "/livedeals?focusSearch=1";
            }
          }
        });
      }

      // 2. Live Deals button click handler
      if (dealsBtn && !dealsBtn.dataset.hasListener) {
        dealsBtn.dataset.hasListener = "true";
        dealsBtn.addEventListener("click", (e) => {
          if (navigator.vibrate) navigator.vibrate(30);

          if (window.location.pathname === "/livedeals" || window.location.pathname.startsWith("/livedeals")) {
            if (window.scrollY > 100) {
              e.preventDefault();
              window.scrollTo({ top: 0, behavior: "smooth" });
            }
          }
        });
      }

      // 3. Home button click handler
      if (homeBtn && !homeBtn.dataset.hasListener) {
        homeBtn.dataset.hasListener = "true";
        homeBtn.addEventListener("click", (e) => {
          if (window.location.pathname === "/" || window.location.pathname === "") {
            if (window.scrollY > 100) {
              e.preventDefault();
              window.scrollTo({ top: 0, behavior: "smooth" });
            }
          }
        });
      }
    }

    setupMobileDock();
    document.addEventListener("astro:after-swap", setupMobileDock);
    document.addEventListener("astro:page-load", setupMobileDock);
  })();
</script>
