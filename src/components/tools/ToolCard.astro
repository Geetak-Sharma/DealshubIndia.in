---
interface Props {
  title: string;
  description: string;
  href: string;
  isLive: boolean;
  icon: string;
}

const { title, description, href, isLive, icon } = Astro.props;
---

<div class={`flex flex-col justify-between p-5 bg-[#181D27] border rounded-xl transition-all duration-300 ${isLive ? 'border-white/10 hover:shadow-md hover:border-emerald-500/20 group' : 'border-white/5 bg-[#141820]/40'}`}>
  <div class="space-y-3">
    
    <div class="flex items-center justify-between">
      <span class="text-2xl" aria-hidden="true">{icon}</span>
      <span class={`text-[9px] font-extrabold tracking-wider uppercase px-2.5 py-0.5 rounded-full ${isLive ? 'bg-emerald-50 dark:bg-emerald-950/20 text-emerald-600 dark:text-emerald-400' : 'bg-slate-100 dark:bg-slate-850 text-slate-400 dark:text-slate-500'}`}>
        {isLive ? 'LIVE' : 'SOON'}
      </span>
    </div>

    <div class="space-y-1">
      <h3 class="text-xs font-black text-slate-100 uppercase tracking-tight">
        {title}
      </h3>
      <p class="text-[11px] text-slate-400 leading-relaxed font-medium">
        {description}
      </p>
    </div>

  </div>

  <div class="mt-4 pt-3 border-t border-white/10">
    {isLive ? (
      <a 
        href={href} 
        class="flex items-center justify-center w-full py-2 px-4 bg-emerald-400/20 hover:bg-emerald-400/30 text-emerald-200 border border-emerald-400/30 font-extrabold text-[10px] tracking-wider rounded-lg shadow-sm uppercase text-center transition-all"
      >
        Launch Tool →
      </a>
    ) : (
      <span 
        class="flex items-center justify-center w-full py-2 px-4 text-[10px] font-extrabold tracking-wider rounded-lg border border-dashed border-slate-200 dark:border-slate-800 text-slate-400 dark:text-slate-500 uppercase text-center select-none bg-slate-50/50 dark:bg-slate-900/10"
      >
        Under Development
      </span>
    )}
  </div>

</div>
