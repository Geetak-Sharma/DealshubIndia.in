---
import BrandLogo from './BrandLogo.astro';
---

<header class="sticky top-0 z-50 w-full bg-white/95 dark:bg-slate-900/95 backdrop-blur border-b border-slate-200 dark:border-slate-800 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    
    {/* Left Identity */}
    <a href="/" class="flex items-center gap-2.5 group decoration-transparent" aria-label="DealsHub India Home">
      <BrandLogo size={28} gradientId="logo-grad" />
      <span class="text-lg font-black tracking-tight text-slate-800 dark:text-slate-100 uppercase">
        DealsHub<span class="text-emerald-600">India</span>
      </span>
    </a>

    {/* Center Nav */}
    <nav class="hidden md:flex items-center gap-8 text-xs font-bold tracking-wider text-slate-500 dark:text-slate-400 uppercase">
      <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Deals</a>
      <a href="/livedeals" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Live Alerts</a>
      <a href="/blog" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Insights</a>
      <a href="/about" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Our Story</a>
    </nav>

    {/* Right CTA */}
    <div class="flex items-center gap-4">
      <a 
        href="https://whatsapp.com/channel/0029Va8sOrp4SpkEQKVElV1i" 
        target="_blank" 
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-[10px] tracking-widest rounded-lg shadow-sm hover:shadow uppercase transition-all"
      >
        Join WhatsApp Channel
      </a>
    </div>

  </div>
</header>
