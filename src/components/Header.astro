---
import BrandLogo from './BrandLogo.astro';

interface Props {
  activePath?: string;
}

const { activePath = Astro.url.pathname } = Astro.props;

const navItems = [
  { label: "Live Deals", href: "/livedeals", isCurrent: activePath === "/livedeals" || activePath.startsWith("/livedeals"), badge: null, icon: "⚡" },
  { label: "Tools", href: "/tools", isCurrent: activePath.startsWith("/tools"), badge: null, icon: "🛠️" },
  { label: "Stores", href: "/livedeals#stores", isCurrent: false, badge: null, icon: "🏬" },
  { label: "Blog", href: "/blog", isCurrent: activePath.startsWith("/blog"), badge: null, icon: "📰" },
  { label: "About", href: "/about", isCurrent: activePath === "/about", badge: null, icon: "ℹ️" },
];
---

<!-- 2026 Floating Tubelight Island Navigation Bar -->
<header id="site-tubelight-header" class="fixed top-2.5 sm:top-3.5 inset-x-0 mx-auto w-full max-w-6xl px-3 sm:px-6 z-50 pointer-events-none transition-all duration-300">
  <div class="tubelight-capsule pointer-events-auto relative w-full bg-[#0a0d14]/85 hover:bg-[#0c101a]/95 border border-white/10 hover:border-white/15 rounded-2xl sm:rounded-full px-3.5 sm:px-5 py-2 sm:py-2.5 backdrop-blur-2xl shadow-[0_16px_40px_rgba(0,0,0,0.55)] transition-all duration-300 flex items-center justify-between gap-2 sm:gap-4 overflow-visible">
    
    <!-- Top Edge Ambient Neon Rim Light -->
    <div class="ambient-rim absolute inset-x-8 sm:inset-x-16 top-0 h-[1.5px] bg-gradient-to-r from-transparent via-emerald-400/80 to-transparent pointer-events-none transition-opacity duration-300"></div>

    <!-- Brand Logo: dealshubindia.in -->
    <a href="/" class="flex items-center gap-2 group shrink-0 focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded-lg py-1 pr-1" aria-label="dealshubindia.in — Best Curated Deals">
      <div class="brand-icon-wrap flex-shrink-0 transition-transform duration-300 group-hover:scale-105">
        <BrandLogo size={28} gradientId="hdr-tubelight-logo-grad" />
      </div>
      <div class="flex items-center tracking-tight leading-none">
        <span class="font-black text-base sm:text-lg text-white group-hover:text-emerald-300 transition-colors">dealshubindia</span>
        <span class="text-emerald-400 font-extrabold text-base sm:text-lg">.in</span>
      </div>
    </a>

    

    <!-- Center Navigation Tabs with Tubelight Glow Active Indicator -->
    <nav class="hidden md:flex items-center gap-1 relative bg-white/[0.03] p-1 rounded-full border border-white/5">
      {navItems.map((item) => (
        <a
          href={item.href}
          data-nav-label={item.label}
          class:list={[
            "tubelight-tab relative inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all duration-200 select-none group/tab",
            item.isCurrent
              ? "active-tubelight text-white font-bold bg-white/[0.08]"
              : "text-slate-300 hover:text-white hover:bg-white/[0.05]"
          ]}
        >
          <span>{item.label}</span>
          
          {item.badge && (
            <span class="inline-flex items-center px-1.5 py-0.2 rounded text-[9px] font-mono font-extrabold uppercase tracking-wide bg-emerald-500/20 text-emerald-300 border border-emerald-500/35">
              {item.badge}
            </span>
          )}

          {/* Tubelight Lamp Indicator on Active Tab */}
          {item.isCurrent && (
            <span class="tubelight-beam absolute -bottom-1.5 inset-x-2.5 h-[3px] bg-emerald-400 rounded-full shadow-[0_0_12px_#34d399,0_0_24px_#10b981]">
              <span class="absolute -top-1 inset-x-0 h-3 bg-emerald-400/30 blur-sm rounded-full"></span>
            </span>
          )}
        </a>
      ))}
    </nav>

    <!-- Right Controls: Command Palette Trigger + Action Pills -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      
      <!-- Quick Find Search Button -->
      <button
        type="button"
        id="tubelight-search-trigger"
        aria-label="Search deals (⌘K)"
        class="search-pill flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-full bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 hover:border-emerald-500/40 text-slate-300 hover:text-white text-xs font-medium transition-all shadow-sm cursor-pointer"
      >
        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden xl:inline text-slate-400">Search</span>
        <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[9px] font-mono text-slate-400 bg-black/40 border border-white/10 rounded">
          ⌘K
        </kbd>
      </button>

      <!-- WhatsApp Channel Pill -->
      <a
        href="https://whatsapp.com/channel/0029Vb81sJqGk1FxL7t9lW0h"
        target="_blank"
        rel="noopener noreferrer"
        class="social-pill inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#25D366] hover:bg-[#20be5b] text-slate-950 font-black text-xs shadow-md shadow-[#25D366]/20 transition-all hover:scale-105 active:scale-95 shrink-0"
        title="Join WhatsApp Alerts"
        aria-label="Join WhatsApp Alerts"
      >
        <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        <span class="hidden sm:inline">WhatsApp</span>
      </a>

      <!-- Telegram Channel Pill (Desktop) -->
      <a
        href="https://t.me/DealsHubIndiaa"
        target="_blank"
        rel="noopener noreferrer"
        class="social-pill hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#0088cc] hover:bg-[#0077b5] text-white font-bold text-xs shadow-md shadow-[#0088cc]/20 transition-all hover:scale-105 active:scale-95 shrink-0"
        title="Join Telegram Alerts"
        aria-label="Join Telegram Alerts"
      >
        <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .4z"/>
        </svg>
        <span>Telegram</span>
      </a>

      <!-- Mobile Dropdown Toggle Button -->
      <button
        type="button"
        id="tubelight-mobile-btn"
        aria-expanded="false"
        aria-controls="tubelight-mobile-drawer"
        aria-label="Toggle Navigation"
        class="md:hidden p-2 rounded-xl text-slate-300 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 focus:outline-none transition-colors cursor-pointer"
      >
        <svg id="tubelight-open-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="tubelight-close-icon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Drawer Menu (Sliding Glass Card) -->
  <div id="tubelight-mobile-drawer" class="hidden md:hidden pointer-events-auto mt-2 w-full bg-[#0a0d14]/95 border border-white/10 rounded-2xl p-4 shadow-2xl backdrop-blur-3xl space-y-3">
    <nav class="flex flex-col space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all",
            item.isCurrent
              ? "text-emerald-400 bg-emerald-500/15 font-bold border border-emerald-500/25"
              : "text-slate-300 hover:text-white hover:bg-white/5"
          ]}
        >
          <div class="flex items-center gap-2">
            <span>{item.icon}</span>
            <span>{item.label}</span>
          </div>
          {item.badge && (
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
              {item.badge}
            </span>
          )}
        </a>
      ))}
    </nav>

    <!-- Mobile Drawer Social Action Bar -->
    <div class="pt-3 border-t border-white/10 grid grid-cols-2 gap-2">
      <a
        href="https://whatsapp.com/channel/0029Vb81sJqGk1FxL7t9lW0h"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 py-2.5 rounded-xl bg-[#25D366] text-slate-950 font-bold text-xs shadow-md"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        <span>WhatsApp</span>
      </a>
      <a
        href="https://t.me/DealsHubIndiaa"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 py-2.5 rounded-xl bg-[#0088cc] text-white font-bold text-xs shadow-md"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .4z"/>
        </svg>
        <span>Telegram</span>
      </a>
    </div>
  </div>
</header>

<!-- Spacer placeholder to push page content down smoothly on desktop & mobile -->
<div class="h-16 sm:h-20 w-full shrink-0" aria-hidden="true"></div>

<script>
  import { gsap } from "gsap";

  function initTubelightNavbar() {
    const header = document.getElementById("site-tubelight-header");
    const capsule = header?.querySelector(".tubelight-capsule");
    const mobileBtn = document.getElementById("tubelight-mobile-btn");
    const mobileDrawer = document.getElementById("tubelight-mobile-drawer");
    const openIcon = document.getElementById("tubelight-open-icon");
    const closeIcon = document.getElementById("tubelight-close-icon");
    const searchBtn = document.getElementById("tubelight-search-trigger");

    if (!header || !capsule) return;

    // 1. GSAP Entrance Animation
    gsap.fromTo(
      capsule,
      { y: -24, opacity: 0, scale: 0.98 },
      { y: 0, opacity: 1, scale: 1, duration: 0.6, ease: "power3.out" }
    );

    // 2. GSAP Micro-Interactions on Tabs
    const tabs = header.querySelectorAll(".tubelight-tab");
    tabs.forEach((tab) => {
      tab.addEventListener("mouseenter", () => {
        gsap.to(tab, { scale: 1.04, duration: 0.2, ease: "power2.out" });
      });
      tab.addEventListener("mouseleave", () => {
        gsap.to(tab, { scale: 1, duration: 0.2, ease: "power2.inOut" });
      });
    });

    // 3. GSAP Tubelight Beam Subtle Glow Pulsing
    const beam = header.querySelector(".tubelight-beam");
    if (beam) {
      gsap.to(beam, {
        boxShadow: "0 0 18px #34d399, 0 0 32px #10b981",
        duration: 1.8,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut",
      });
    }

    // 4. GSAP Scroll Response (Scroll down -> compact capsule; Scroll up -> reveal)
    let lastScrollY = window.scrollY;
    let ticking = false;

    window.addEventListener("scroll", () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const currentY = window.scrollY;
          if (currentY > 60 && currentY > lastScrollY) {
            // Scrolling down -> elevate & tighten
            gsap.to(capsule, {
              y: -4,
              backgroundColor: "rgba(10, 13, 20, 0.95)",
              boxShadow: "0 20px 48px rgba(0,0,0,0.75)",
              duration: 0.3,
            });
          } else {
            // Scrolling up / top -> return to airy glass state
            gsap.to(capsule, {
              y: 0,
              backgroundColor: "rgba(10, 13, 20, 0.85)",
              boxShadow: "0 16px 40px rgba(0,0,0,0.55)",
              duration: 0.3,
            });
          }
          lastScrollY = currentY;
          ticking = false;
        });
        ticking = true;
      }
    });

    // 5. Mobile Drawer Toggle with GSAP Slide
    if (mobileBtn && mobileDrawer) {
      mobileBtn.onclick = () => {
        const isClosed = mobileDrawer.classList.contains("hidden");
        if (isClosed) {
          mobileDrawer.classList.remove("hidden");
          openIcon?.classList.add("hidden");
          closeIcon?.classList.remove("hidden");
          gsap.fromTo(
            mobileDrawer,
            { opacity: 0, y: -12, scale: 0.98 },
            { opacity: 1, y: 0, scale: 1, duration: 0.3, ease: "back.out(1.5)" }
          );
        } else {
          gsap.to(mobileDrawer, {
            opacity: 0,
            y: -8,
            scale: 0.98,
            duration: 0.2,
            ease: "power2.in",
            onComplete: () => {
              mobileDrawer.classList.add("hidden");
              openIcon?.classList.remove("hidden");
              closeIcon?.classList.add("hidden");
            },
          });
        }
      };
    }

    // 6. Search Trigger Focus
    if (searchBtn) {
      searchBtn.onclick = () => {
        const searchInput = (document.getElementById("hero-editorial-search-input") ||
          document.getElementById("live-search-input")) as HTMLInputElement | null;
        if (searchInput) {
          searchInput.focus();
          searchInput.scrollIntoView({ behavior: "smooth", block: "center" });
        } else {
          window.location.href = "/livedeals";
        }
      };
    }
  }

  // Support ClientRouter and Astro view transitions
  document.addEventListener("DOMContentLoaded", initTubelightNavbar);
  document.addEventListener("astro:page-load", initTubelightNavbar);
</script>
