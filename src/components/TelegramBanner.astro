---
interface Props {
  memberCount?: string;
}

const { memberCount = "115,000+" } = Astro.props;
---

<aside aria-label="Join DealsHub Community Alert Channels" class="relative overflow-hidden my-12 sm:my-16 rounded-3xl border border-emerald-500/25 bg-gradient-to-br from-slate-900 via-[#0a1829] to-slate-900 p-6 sm:p-10 shadow-2xl shadow-emerald-500/10">
  <!-- Glowing background orbs -->
  <div class="absolute -right-20 -top-20 w-80 h-80 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -left-20 -bottom-20 w-80 h-80 bg-[#0088cc]/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
    
    <!-- Left Copy Column -->
    <div class="lg:col-span-7 xl:col-span-8 space-y-4">
      
      <!-- VIP Community Pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-bold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span>⚡ INSTANT PRICE DROP ALERTS • 1FreeDeal Hunters</span>
      </div>

      <!-- Headline -->
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white tracking-tight leading-snug">
        Catch Loot Drops <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-sky-400">5 Minutes Before</span> They Expire
      </h2>

      <!-- Subtitle -->
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl leading-relaxed">
        Join our fast-growing community on WhatsApp or Telegram for instant verified price glitches. Never miss a ₹1 drop or price glitch again.
      </p>

      <!-- Key Value Points -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
        <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-200">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>100% Free Forever</span>
        </div>
        <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-200">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>Zero Spam Policy</span>
        </div>
        <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-200">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>Instant Muteable Alerts</span>
        </div>
      </div>

    </div>

    <!-- Right Action Column: Dual Action Buttons -->
    <div class="lg:col-span-5 xl:col-span-4 flex flex-col gap-3 justify-center pt-2 lg:pt-0">
      <!-- 1. WhatsApp Channel Button -->
      <a
        href="https://whatsapp.com/channel/0029Vb81sJqGk1FxL7t9lW0h"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-between gap-3 px-5 py-3.5 rounded-2xl bg-[#25D366] hover:bg-[#20bd5a] text-slate-950 text-sm sm:text-base font-bold shadow-xl shadow-[#25D366]/20 transition-all hover:scale-[1.02] active:scale-95 text-left group"
      >
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          <span>Join WhatsApp Channel</span>
        </div>
        <span class="text-xs bg-black/15 text-slate-950 font-bold px-2 py-0.5 rounded-full whitespace-nowrap">Free↗</span>
      </a>

      <!-- 2. Telegram Channel Button -->
      <a
        href="https://t.me/DealsHubIndiaa"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-between gap-3 px-5 py-3.5 rounded-2xl bg-[#0088cc] hover:bg-[#0077b5] text-white text-sm sm:text-base font-bold shadow-xl shadow-[#0088cc]/30 transition-all hover:scale-[1.02] active:scale-95 text-left group"
      >
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .4z"/>
          </svg>
          <span>Join Telegram Channel</span>
        </div>
        <span class="text-xs bg-white/20 text-white font-bold px-2 py-0.5 rounded-full whitespace-nowrap">Free↗</span>
      </a>

      <span class="text-xs text-slate-400 text-center">No registration required • 1-click instant join</span>
    </div>

  </div>
</aside>
