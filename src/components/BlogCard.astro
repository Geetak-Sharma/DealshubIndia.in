---
import { format } from 'date-fns';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  pubDate: Date | string;
  author: string;
  image?: string | any;
  url: string;
  category?: string;
  readingTime?: string;
  editorialBadge?: string;
}

const {
  title,
  description,
  pubDate,
  author = "DealsHub Editorial",
  image,
  url,
  category = "Field Guide",
  readingTime = "5 min read",
  editorialBadge = "EDITORIAL GUIDE",
} = Astro.props;

const hasImage = !!image;
const parsedDate = typeof pubDate === 'string' ? new Date(pubDate) : pubDate;
const formattedDate = parsedDate && !isNaN(parsedDate.getTime())
  ? format(parsedDate, 'MMM dd, yyyy')
  : 'Recent';
---

<article class="editorial-blog-card group bg-slate-900/80 hover:bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-2xl overflow-hidden flex flex-col justify-between transition-all duration-200 shadow-sm hover:shadow-xl hover:shadow-black/50">
  <div>
    <!-- Cover Image Wrap with Clean Aspect Ratio -->
    <a href={url} class="block relative w-full pt-[52%] overflow-hidden bg-slate-950 border-b border-slate-800">
      {hasImage ? (
        typeof image === "object" ? (
          <Image
            src={image}
            alt={title}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        ) : (
          <img
            src={image}
            alt={title}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        )
      ) : (
        <div class="absolute inset-0 flex items-center justify-center bg-slate-950 text-slate-600">
          <svg class="w-10 h-10 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
        </div>
      )}

      <!-- Editorial / Field Guide Badge -->
      <span class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-slate-950/90 backdrop-blur-md border border-slate-800 text-emerald-400 font-mono font-bold text-[10px] tracking-wider uppercase shadow-sm">
        {editorialBadge || category}
      </span>

      <!-- Reading Time Pill -->
      <span class="absolute top-3 right-3 px-2.5 py-1 rounded-md bg-slate-950/90 backdrop-blur-md border border-slate-800 text-slate-300 font-mono font-medium text-[10px] shadow-sm">
        ⏱️ {readingTime}
      </span>
    </a>

    <!-- Post Info -->
    <div class="p-5 pb-0">
      <!-- Wirecutter-style Metadata Line: Author · PubDate · Field Guide indicator -->
      <div class="flex items-center gap-2 text-xs font-mono text-gray-500 mb-2.5 flex-wrap">
        <span class="text-slate-300 font-medium">{author}</span>
        <span class="text-slate-600">•</span>
        <time datetime={parsedDate?.toISOString?.() || ""}>{formattedDate}</time>
        <span class="text-slate-600">•</span>
        <a href="/blog" class="text-emerald-400/90 hover:text-emerald-300 font-semibold hover:underline">
          Field Guide
        </a>
      </div>

      <!-- Title -->
      <a href={url} class="block mb-2">
        <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-emerald-300 transition-colors line-clamp-2 leading-snug tracking-tight">
          {title}
        </h3>
      </a>

      <!-- Description excerpt -->
      <p class="text-xs sm:text-sm text-gray-500 line-clamp-2 leading-relaxed">
        {description}
      </p>
    </div>
  </div>

  <!-- Card Action Footer -->
  <div class="p-5 pt-4 flex items-center justify-between border-t border-slate-800/60 mt-3">
    <a
      href={url}
      class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-emerald-400 group-hover:text-emerald-300 transition-all"
    >
      <span>Read Field Guide</span>
      <span class="font-black group-hover:translate-x-1 transition-transform">→</span>
    </a>
    <a
      href="/blog"
      class="text-[11px] font-mono text-slate-500 hover:text-emerald-400 transition-colors"
      title="All guides at /blog"
    >
      /blog
    </a>
  </div>
</article>
