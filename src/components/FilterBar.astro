---
const categories = [
  { id: "all", label: "All Drops", icon: "✨" },
  { id: "loot", label: "Loot Deals", icon: "🔥" },
  { id: "under99", label: "Under ₹99", icon: "⚡" },
  { id: "tech", label: "Tech & Gadgets", icon: "📱" },
  { id: "fashion", label: "Fashion", icon: "👕" },
  { id: "home", label: "Home & Living", icon: "🏠" },
];

const stores = [
  { id: "all", label: "All Stores", icon: "🌐" },
  { id: "amazon", label: "Amazon", icon: "📦" },
  { id: "flipkart", label: "Flipkart", icon: "🛍️" },
];
---

<div id="stores" class="w-full py-4 border-y border-gray-200 bg-white/95 shadow-sm backdrop-blur-xl sticky top-16 z-30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-3">
    
    <!-- Primary Row: Categories and Active Count -->
    <div class="flex items-center justify-between gap-4 overflow-x-auto no-scrollbar pb-1 sm:pb-0">
      
      <!-- Category Pills -->
      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0" role="tablist" aria-label="Filter deals by category">
        {categories.map((cat) => (
          <button
            type="button"
            role="tab"
            aria-selected={cat.id === "all" ? "true" : "false"}
            data-category={cat.id}
            class:list={[
              "filter-cat-btn inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold transition-all whitespace-nowrap cursor-pointer",
              cat.id === "all"
                ? "bg-gray-900 text-white font-bold shadow-sm active"
                : "bg-white hover:bg-gray-50 text-gray-700 hover:text-gray-900 border border-gray-200 shadow-sm"
            ]}
          >
            <span>{cat.icon}</span>
            <span>{cat.label}</span>
          </button>
        ))}
      </div>

      <!-- Quick Store Dropdown or Pills on desktop -->
      <div class="hidden sm:flex items-center gap-1.5 shrink-0 pl-4 border-l border-gray-200">
        <span class="text-xs text-gray-500 font-medium mr-1">Store:</span>
        {stores.map((store) => (
          <button
            type="button"
            data-store={store.id}
            class:list={[
              "filter-store-btn inline-flex items-center gap-1 px-3 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer",
              store.id === "all"
                ? "bg-emerald-50 text-emerald-700 border border-emerald-300 font-bold active"
                : "bg-white hover:bg-gray-50 text-gray-600 hover:text-gray-900 border border-gray-200"
            ]}
          >
            <span>{store.icon}</span>
            <span>{store.label}</span>
          </button>
        ))}
      </div>

    </div>

    <!-- Mobile Secondary Store Row -->
    <div class="sm:hidden flex items-center gap-2 overflow-x-auto no-scrollbar pt-1">
      <span class="text-[11px] text-gray-500 font-medium shrink-0">Store:</span>
      {stores.map((store) => (
        <button
          type="button"
          data-store={store.id}
          class:list={[
            "filter-store-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium shrink-0 transition-all cursor-pointer",
            store.id === "all"
              ? "bg-emerald-50 text-emerald-700 border border-emerald-300 font-bold active"
              : "bg-white text-gray-600 border border-gray-200"
          ]}
        >
          <span>{store.icon}</span>
          <span>{store.label}</span>
        </button>
      ))}
    </div>

  </div>
</div>

<script is:inline>
  (function() {
    function setupFilterBar() {
      const catBtns = document.querySelectorAll(".filter-cat-btn");
      const storeBtns = document.querySelectorAll(".filter-store-btn");

      let currentCategory = "all";
      let currentStore = "all";

      // Read URL params if preset
      const urlParams = new URLSearchParams(window.location.search);
      const urlCat = urlParams.get("filter") || urlParams.get("category");
      const urlStore = urlParams.get("store");

      if (urlCat) currentCategory = urlCat;
      if (urlStore) currentStore = urlStore;

      function updateActiveUI() {
        catBtns.forEach(btn => {
          const cat = btn.getAttribute("data-category");
          const isActive = cat === currentCategory;
          btn.setAttribute("aria-selected", String(isActive));
          if (isActive) {
            btn.className = "filter-cat-btn inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold transition-all whitespace-nowrap cursor-pointer bg-gray-900 text-white font-bold shadow-sm active";
          } else {
            btn.className = "filter-cat-btn inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold transition-all whitespace-nowrap cursor-pointer bg-white hover:bg-gray-50 text-gray-700 hover:text-gray-900 border border-gray-200 shadow-sm";
          }
        });

        storeBtns.forEach(btn => {
          const store = btn.getAttribute("data-store");
          const isActive = store === currentStore;
          if (isActive) {
            btn.className = "filter-store-btn inline-flex items-center gap-1 px-3 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer bg-emerald-50 text-emerald-700 border border-emerald-300 font-bold active";
          } else {
            btn.className = "filter-store-btn inline-flex items-center gap-1 px-3 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer bg-white hover:bg-gray-50 text-gray-600 hover:text-gray-900 border border-gray-200";
          }
        });

        // Broadcast filter event
        window.dispatchEvent(new CustomEvent("deals-filter", {
          detail: { category: currentCategory, store: currentStore }
        }));
      }

      catBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          currentCategory = btn.getAttribute("data-category") || "all";
          updateActiveUI();
        });
      });

      storeBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          currentStore = btn.getAttribute("data-store") || "all";
          updateActiveUI();
        });
      });

      // Initial trigger if params were set
      if (urlCat || urlStore) {
        updateActiveUI();
      }
    }

    setupFilterBar();
    document.addEventListener("astro:after-swap", setupFilterBar);
  })();
</script>
