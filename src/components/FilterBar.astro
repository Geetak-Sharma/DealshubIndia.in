---
interface Props {
  deals?: any[];
}

const { deals = [] } = Astro.props;

const categories = [
  { id: "all", label: "All Drops", icon: "✨" },
  { id: "loot", label: "Loot Deals", icon: "🔥" },
  { id: "under99", label: "Under ₹99", icon: "⚡" },
  { id: "under499", label: "Under ₹499", icon: "🎯" },
  { id: "tech", label: "Tech", icon: "📱" },
  { id: "fashion", label: "Fashion", icon: "👕" },
  { id: "home", label: "Home", icon: "🏠" },
];

const knownStoreMeta: Record<string, { label: string; icon: string }> = {
  amazon: { label: "Amazon", icon: "📦" },
  flipkart: { label: "Flipkart", icon: "🛍️" },
  myntra: { label: "Myntra", icon: "👗" },
  ajio: { label: "Ajio", icon: "🏷️" },
  croma: { label: "Croma", icon: "⚡" },
  meesho: { label: "Meesho", icon: "🛒" },
  tatacliq: { label: "Tata CLiQ", icon: "✨" },
};

// Compute dynamic top 5 stores based on deals posted in the last 4 hours
const fourHoursMs = 4 * 60 * 60 * 1000;
const now = Date.now();

const recentStoreCounts: Record<string, number> = {};
const allStoreCounts: Record<string, number> = {};

if (Array.isArray(deals) && deals.length > 0) {
  deals.forEach((d: any) => {
    const rawMerchant = (d.merchant || "Amazon").toLowerCase();
    let norm = "amazon";
    if (rawMerchant.includes("flipkart") || rawMerchant.includes("fkrt")) norm = "flipkart";
    else if (rawMerchant.includes("myntra")) norm = "myntra";
    else if (rawMerchant.includes("ajio")) norm = "ajio";
    else if (rawMerchant.includes("croma")) norm = "croma";
    else if (rawMerchant.includes("meesho")) norm = "meesho";
    else if (rawMerchant.includes("tatacliq")) norm = "tatacliq";
    else norm = "amazon";

    const timestamp = d.timestamp ? Number(d.timestamp) : (d.date ? new Date(d.date).getTime() : 0);
    allStoreCounts[norm] = (allStoreCounts[norm] || 0) + 1;

    if (now - timestamp <= fourHoursMs && timestamp > 0) {
      recentStoreCounts[norm] = (recentStoreCounts[norm] || 0) + 1;
    }
  });
}

// Rank stores: first by last 4-hour deal volume, then fall back to all-time deal volume
const sortedRecent = Object.keys(recentStoreCounts).sort((a, b) => recentStoreCounts[b] - recentStoreCounts[a]);
const sortedAll = Object.keys(allStoreCounts).sort((a, b) => allStoreCounts[b] - allStoreCounts[a]);

const dynamicStoreKeys: string[] = [...sortedRecent];
for (const s of sortedAll) {
  if (!dynamicStoreKeys.includes(s) && knownStoreMeta[s]) {
    dynamicStoreKeys.push(s);
  }
}

// Fallback safety to default top stores if fresh list is under 5
const defaultFallback = ["amazon", "flipkart", "myntra", "ajio", "croma"];
for (const s of defaultFallback) {
  if (!dynamicStoreKeys.includes(s)) {
    dynamicStoreKeys.push(s);
  }
}

// Pick the Top 5 stores
const top5StoreKeys = dynamicStoreKeys.slice(0, 5);

const dynamicStores = [
  { id: "all", label: "All Stores", icon: "🌐", count: 0 },
  ...top5StoreKeys.map(k => ({
    id: k,
    label: knownStoreMeta[k]?.label || (k.charAt(0).toUpperCase() + k.slice(1)),
    icon: knownStoreMeta[k]?.icon || "🏬",
    count: recentStoreCounts[k] || 0,
  }))
];
---

<div id="stores" class="w-full py-2.5 border-y border-white/10 bg-[#151922]/95 shadow-md backdrop-blur-xl sticky top-16 z-30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-2">
    
    <!-- Primary Row: Categories and Dynamic Top 5 Store Pills -->
    <div class="flex items-center justify-between gap-3 overflow-x-auto no-scrollbar py-0.5">
      
      <!-- Category Pills -->
      <div class="flex items-center gap-1.5 shrink-0" role="tablist" aria-label="Filter deals by category">
        {categories.map((cat) => (
          <button
            type="button"
            role="tab"
            aria-selected={cat.id === "all" ? "true" : "false"}
            data-category={cat.id}
            class:list={[
              "filter-cat-btn inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold transition-all whitespace-nowrap cursor-pointer",
              cat.id === "all"
                ? "bg-emerald-400/20 text-emerald-300 border border-emerald-400/40 font-bold shadow-sm active"
                : "bg-[#181D27] hover:bg-[#202735] text-slate-300 hover:text-white border border-white/10 shadow-sm"
            ]}
          >
            <span>{cat.icon}</span>
            <span>{cat.label}</span>
          </button>
        ))}
      </div>

      <!-- Dynamic Top 5 Stores on desktop (calculated from last 4h drops) -->
      <div id="store-pills-desktop" class="hidden md:flex items-center gap-1 shrink-0 pl-3 border-l border-white/10">
        <span class="text-[10px] text-emerald-400/90 font-bold tracking-wider uppercase inline-flex items-center gap-1 mr-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Top Stores:
        </span>
        {dynamicStores.map((store) => (
          <button
            type="button"
            data-store={store.id}
            class:list={[
              "filter-store-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer",
              store.id === "all"
                ? "bg-emerald-400/20 text-emerald-300 border border-emerald-400/40 font-bold active"
                : "bg-[#181D27] hover:bg-[#202735] text-slate-300 hover:text-white border border-white/10"
            ]}
            title={store.count > 0 ? `${store.label} (${store.count} drops in last 4h)` : store.label}
          >
            <span>{store.icon}</span>
            <span>{store.label}</span>
          </button>
        ))}
      </div>

    </div>

    <!-- Mobile / Tablet Secondary Store Row with Dynamic Top 5 -->
    <div id="store-pills-mobile" class="md:hidden flex items-center gap-1.5 overflow-x-auto no-scrollbar pt-0.5">
      <span class="text-[10px] text-emerald-400/90 font-bold tracking-wider uppercase shrink-0 inline-flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        Top Stores:
      </span>
      {dynamicStores.map((store) => (
        <button
          type="button"
          data-store={store.id}
          class:list={[
            "filter-store-btn inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-xs font-medium shrink-0 transition-all cursor-pointer",
            store.id === "all"
              ? "bg-emerald-400/20 text-emerald-300 border border-emerald-400/40 font-bold active"
              : "bg-[#181D27] text-slate-300 border border-white/10"
          ]}
        >
          <span>{store.icon}</span>
          <span>{store.label}</span>
        </button>
      ))}
    </div>

  </div>
</div>

<script is:inline>
  (function() {
    function setupFilterBar() {
      const catBtns = document.querySelectorAll(".filter-cat-btn");
      const storeBtns = document.querySelectorAll(".filter-store-btn");

      let currentCategory = "all";
      let currentStore = "all";

      const urlParams = new URLSearchParams(window.location.search);
      const urlCat = urlParams.get("filter") || urlParams.get("category");
      const urlStore = urlParams.get("store");

      if (urlCat) currentCategory = urlCat;
      if (urlStore) currentStore = urlStore;

      function updateActiveUI() {
        catBtns.forEach(btn => {
          const cat = btn.getAttribute("data-category");
          const isActive = cat === currentCategory;
          btn.setAttribute("aria-selected", String(isActive));
          if (isActive) {
            btn.className = "filter-cat-btn inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold transition-all whitespace-nowrap cursor-pointer bg-emerald-400/20 text-emerald-300 border border-emerald-400/40 font-bold shadow-sm active";
          } else {
            btn.className = "filter-cat-btn inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold transition-all whitespace-nowrap cursor-pointer bg-[#181D27] hover:bg-[#202735] text-slate-300 hover:text-white border border-white/10 shadow-sm";
          }
        });

        storeBtns.forEach(btn => {
          const store = btn.getAttribute("data-store");
          const isActive = store === currentStore;
          if (isActive) {
            btn.className = "filter-store-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer bg-emerald-400/20 text-emerald-300 border border-emerald-400/40 font-bold active";
          } else {
            btn.className = "filter-store-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium transition-all cursor-pointer bg-[#181D27] hover:bg-[#202735] text-slate-300 hover:text-white border border-white/10";
          }
        });

        window.dispatchEvent(new CustomEvent("deals-filter", {
          detail: { category: currentCategory, store: currentStore }
        }));
      }

      catBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          currentCategory = btn.getAttribute("data-category") || "all";
          updateActiveUI();
        });
      });

      storeBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          currentStore = btn.getAttribute("data-store") || "all";
          updateActiveUI();
        });
      });

      if (urlCat || urlStore) {
        updateActiveUI();
      }
    }

    setupFilterBar();
    document.addEventListener("astro:after-swap", setupFilterBar);
  })();
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
  }
  .no-scrollbar {
    -ms-overflow-style: none !important;
    scrollbar-width: none !important;
  }
</style>
