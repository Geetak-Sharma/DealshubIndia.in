---
import { QCDataStore } from '../lib/qcStore.js';
import { startQCScraper } from '../lib/qcScraper.js';
import { formatTimeAgo } from '../lib/qc/normalizeDeal';

// Boot scraper when homepage loads
startQCScraper();

const latestDeals = QCDataStore.getLatest(3);

// Trending deals sorted by clickCount
const trendingDeals = QCDataStore.load().posts
  .filter(p => !p.isExpired)
  .sort((a, b) => (b.clickCount || 0) - (a.clickCount || 0))
  .slice(0, 4);

// Most Shared deals sorted by shareCount
const sharedDeals = QCDataStore.load().posts
  .filter(p => !p.isExpired)
  .sort((a, b) => (b.shareCount || 0) - (a.shareCount || 0))
  .slice(0, 4);

const hasAnyDeals = latestDeals.length > 0;
---

{hasAnyDeals && (
<section class="qchp-section">
  <div class="qchp-inner">

    <!-- Section header -->
    <div class="qchp-header">
      <div>
        <div class="qchp-eyebrow">
          <span class="qchp-live-dot" />
          LIVE UPDATED
        </div>
        <h2 class="qchp-title">🍕 Quick Commerce Offers</h2>
        <p class="qchp-sub">Food delivery, grocery & instant cashback deals — auto-imported every 2 minutes</p>
      </div>
      <a href="/quick-commerce" class="qchp-view-all">
        View All Offers →
      </a>
    </div>

    

    <!-- Grid: Latest -->
    <div class="qchp-grid" id="qchp-grid-latest">
      {latestDeals.map(deal => {
        const accent = deal.merchantColor || '#22C55E';
        const imgSrc = deal.image || deal.fallbackSvg || '';
        return (
          <a
            href={`/quick-commerce/${deal.slug}`}
            class={`qchp-card ${deal.isLoot ? 'qchp-card--loot' : ''}`}
            style={`--acc:${accent}`}
          >
            <div class="qchp-card__bar" />
            <div class="qchp-card__img-wrap">
              <img 
                src={imgSrc} 
                alt={deal.title} 
                class="qchp-card__img" 
                loading="lazy" 
                referrerpolicy="no-referrer"
                style={imgSrc ? "" : "display: none;"}
                onerror="this.onerror=null; if (this.dataset.fallback) { this.src = this.dataset.fallback; } else { this.style.display = 'none'; const ph = this.parentElement.querySelector('.qchp-card__img-ph'); if (ph) ph.style.display = 'flex'; }" 
                data-fallback={deal.image ? '' : (deal.fallbackSvg || '')} 
              />
              <div 
                class="qchp-card__img-ph" 
                style={imgSrc ? "display: none;" : "display: flex;"}
              >
                <span>{deal.merchantEmoji || '🛍️'}</span>
              </div>
              {deal.isExpiringToday && (
                <span class="qchp-card__expiry">⏰ Today</span>
              )}
            </div>
            <div class="qchp-card__body">
              <div class="qchp-card__meta">
                <span class="qchp-card__merchant" style={`color:${accent}`}>
                  {deal.merchantEmoji} {deal.merchant || 'Quick Commerce'}
                </span>
                <span class="qchp-card__time">{formatTimeAgo(deal.timestamp)}</span>
              </div>
              <p class="qchp-card__title">{deal.title}</p>
              {deal.explanation && (
                <p class="qchp-card__explanation" style="font-size: 10px; opacity: 0.6; line-height: 1.3; margin: 2px 0 0 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  ✨ {deal.explanation}
                </p>
              )}
              <div class="qchp-card__badges">
                {deal.discount && <span class="qchp-badge qchp-badge--discount">{deal.discount}</span>}
                {deal.cashback && <span class="qchp-badge qchp-badge--cashback">💰 {deal.cashback}</span>}
                {deal.couponCode && <span class="qchp-badge qchp-badge--coupon">🎟️ {deal.couponCode}</span>}
                {deal.isFreebie && <span class="qchp-badge qchp-badge--free">🆓 FREE</span>}
              </div>
              <div style="display: flex; gap: 8px; margin-top: auto; position: relative; z-index: 5;">
                <div class="qchp-card__cta" style={`background:${accent}; flex: 1;`}>
                  Get Offer
                  <span class='material-symbols-outlined' style='font-size:14px;font-variation-settings:"FILL" 0,"wght" 500,"GRAD" 0,"opsz" 20;margin-left:4px;'>arrow_outward</span>
                </div>
                <button
                  type="button"
                  class="qchp-card__cta deal-share-btn"
                  style={`background:transparent; border: 1px solid ${accent}; color: ${accent}; padding: 0 12px; border-radius: 999px;`}
                  data-title={deal.title}
                  data-image={imgSrc}
                  data-url={`https://dealshubindia.in/quick-commerce/${deal.slug}`}
                  data-platform={deal.merchant}
                  data-slug={deal.slug}
                  data-share-text={deal.whatsappShareText || deal.explanation || ''}
                  onclick="event.preventDefault(); event.stopPropagation();"
                >
                  <span class="material-symbols-outlined" style="font-size:16px;">share</span>
                </button>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Bottom CTA -->
    <div class="qchp-footer">
      <a href="/quick-commerce" class="qchp-footer-btn">
        🍽️ Browse All Quick Commerce Deals →
      </a>
    </div>

  </div>
</section>
)}



<style>
  /* ── M3 tokens ─────────────────────────────────────────── */
  :root {
    --m3-surface-container: #211F26;
    --m3-outline-variant:   #2B2930;
    --m3-on-surface:        #E6E1E5;
  }

  /* ── Section ──────────────────────────────────────────────── */
  .qchp-section {
    padding: 24px 0;
    border-top: 1px solid rgba(255,255,255,0.05);
    background: linear-gradient(180deg, transparent 0%, rgba(252,128,25,0.03) 50%, transparent 100%);
  }

  .qchp-inner {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* ── Header ───────────────────────────────────────────────── */
  .qchp-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    padding-bottom: 16px;
  }
  .qchp-eyebrow {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 9px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase;
    color: #FC8019; margin-bottom: 6px;
  }
  .qchp-live-dot {
    width: 6px; height: 6px; border-radius: 50%; background: #FC8019;
    animation: hpDotPing 1.8s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes hpDotPing {
    0%  { box-shadow: 0 0 0 0 rgba(252,128,25,0.8); }
    60% { box-shadow: 0 0 0 5px rgba(252,128,25,0); }
    100%{ box-shadow: 0 0 0 0 rgba(252,128,25,0); }
  }
  .qchp-title {
    font-size: 18px; font-weight: 900; color: var(--m3-on-surface);
    text-transform: uppercase; letter-spacing: 0.3px;
  }
  .qchp-sub {
    font-size: 10px; font-weight: 700; color: rgba(255,255,255,0.25);
    text-transform: uppercase; letter-spacing: 1px; margin-top: 4px;
  }
  .qchp-view-all {
    display: inline-flex; align-items: center;
    padding: 8px 16px; border-radius: 999px;
    font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;
    color: #FC8019; border: 1px solid rgba(252,128,25,0.3);
    background: rgba(252,128,25,0.06); text-decoration: none;
    transition: background 200ms cubic-bezier(0.2,0,0,1), border-color 200ms cubic-bezier(0.2,0,0,1);
    white-space: nowrap;
  }
  .qchp-view-all:hover { background: rgba(252,128,25,0.14); border-color: rgba(252,128,25,0.6); }

  /* ── M3 Secondary Tabs ──────────────────────────────────── */
  .qchp-tabs {
    display: flex;
    gap: 0;
    padding: 0;
    border-bottom: 1px solid var(--m3-outline-variant);
  }
  .qchp-tab-btn {
    padding: 10px 16px;
    border-radius: 0;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: rgba(255,255,255,0.45);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    position: relative;
    transition: color 200ms cubic-bezier(0.2,0,0,1),
                border-color 200ms cubic-bezier(0.2,0,0,1);
    overflow: hidden;
  }
  /* M3 state layer */
  .qchp-tab-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: currentColor;
    opacity: 0;
    transition: opacity 200ms cubic-bezier(0.2,0,0,1);
    pointer-events: none;
  }
  .qchp-tab-btn:hover::before { opacity: 0.08; }
  .qchp-tab-btn--active {
    color: #FC8019;
    background: transparent;
    border-bottom: 2px solid #FC8019;
  }

  /* ── M3 Assist Chip (merchant strip) ────────────────────── */
  .qchp-merchants {
    display: flex; flex-wrap: wrap; gap: 8px; padding: 4px 0;
  }
  .qchp-merchant-pill {
    padding: 0 12px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid var(--m3-outline-variant);
    background: transparent;
    font-size: 10px; font-weight: 700; color: rgba(255,255,255,0.55);
    transition: background 200ms cubic-bezier(0.2,0,0,1);
  }

  /* ── Grid ────────────────────────────────────────────────── */
  .qchp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  @media(max-width:640px){
    .qchp-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
  }
  @media(max-width:400px){
    .qchp-grid { grid-template-columns: 1fr; }
  }

  /* ── M3 Card ─────────────────────────────────────────────── */
  @keyframes qchpCardEnter {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .qchp-card {
    display: flex;
    flex-direction: column;
    background: var(--m3-surface-container);
    border: 1px solid var(--m3-outline-variant);
    border-radius: 16px;
    border-left: 3px solid var(--acc, #22C55E);
    overflow: hidden;
    text-decoration: none;
    position: relative;
    animation: qchpCardEnter 400ms cubic-bezier(0,0,0,1) both;
    transition: box-shadow 200ms cubic-bezier(0.2,0,0,1),
                border-color 200ms cubic-bezier(0.2,0,0,1);
  }
  /* M3 state layer overlay */
  .qchp-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--m3-on-surface, #E6E1E5);
    opacity: 0;
    transition: opacity 200ms cubic-bezier(0.2,0,0,1);
    pointer-events: none;
    z-index: 1;
  }
  .qchp-card:hover::before { opacity: 0.08; }
  .qchp-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.4);
  }
  .qchp-card--loot {
    border-left-color: #EF4444;
    animation: qchpCardEnter 400ms cubic-bezier(0,0,0,1) both,
               cardLootPulse 2.5s ease-in-out infinite;
  }
  @keyframes cardLootPulse {
    0%,100%{ box-shadow: none; }
    50%    { box-shadow: 0 0 16px rgba(239,68,68,0.25); }
  }

  /* Top bar hidden — replaced by left-border accent */
  .qchp-card__bar { display: none; }

  /* ── Card image ──────────────────────────────────────────── */
  .qchp-card__img-wrap {
    width: 100%; height: 150px; overflow: hidden; position: relative;
    background: rgba(255,255,255,0.02); flex-shrink: 0;
    border-radius: 12px 12px 0 0;
  }
  .qchp-card__img { width: 100%; height: 100%; object-fit: contain; background: rgba(0,0,0,0.15); transition: transform 200ms cubic-bezier(0.2,0,0,1); }
  .qchp-card:hover .qchp-card__img { transform: scale(1.04); }
  .qchp-card__img-ph {
    display: flex; align-items: center; justify-content: center;
    width: 100%; height: 100%;
    font-size: 2.5rem;
  }
  .qchp-card__expiry {
    position: absolute; top: 8px; right: 8px;
    background: rgba(239,68,68,0.85); color: white;
    font-size: 8px; font-weight: 800; padding: 2px 8px; border-radius: 999px;
    letter-spacing: 0.5px;
  }

  /* ── Card body ───────────────────────────────────────────── */
  .qchp-card__body { padding: 14px; display: flex; flex-direction: column; gap: 8px; flex: 1; position: relative; z-index: 2; }

  .qchp-card__meta { display: flex; align-items: center; justify-content: space-between; gap: 4px; }
  .qchp-card__merchant { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; }
  .qchp-card__time { font-size: 9px; color: rgba(255,255,255,0.25); font-weight: 600; }

  .qchp-card__title {
    font-size: 12px; font-weight: 700; color: var(--m3-on-surface);
    line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden; margin: 0;
  }

  .qchp-card__badges { display: flex; flex-wrap: wrap; gap: 4px; }
  .qchp-badge {
    display: inline-flex; align-items: center; gap: 2px;
    padding: 2px 7px; border-radius: 999px;
    font-size: 9px; font-weight: 800; white-space: nowrap;
  }
  .qchp-badge--discount { background: rgba(251,146,60,0.12); color:#fb923c; }
  .qchp-badge--cashback { background: rgba(34,197,94,0.10); color:#22C55E; }
  .qchp-badge--coupon   { background: rgba(34,197,94,0.08); color:#22C55E; font-family: monospace; }
  .qchp-badge--free     { background: rgba(52,211,153,0.10); color:#34d399; }

  /* ── M3 Filled Button CTA ────────────────────────────────── */
  .qchp-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    height: 32px;
    padding: 0 16px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1px;
    text-transform: none;
    color: #fff;
    margin-top: auto;
    position: relative;
    overflow: hidden;
    transition: box-shadow 200ms cubic-bezier(0.2,0,0,1);
  }
  .qchp-card__cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0;
    transition: opacity 200ms cubic-bezier(0.2,0,0,1);
    pointer-events: none;
  }
  .qchp-card:hover .qchp-card__cta::before { opacity: 0.08; }

  /* ── Footer ──────────────────────────────────────────────── */
  .qchp-footer { display: flex; justify-content: center; padding-top: 8px; }
  .qchp-footer-btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 12px 28px; border-radius: 999px;
    background: rgba(252,128,25,0.08); border: 1px solid rgba(252,128,25,0.25);
    color: #FC8019; font-size: 13px; font-weight: 800;
    text-decoration: none; letter-spacing: 0.3px;
    transition: background 200ms cubic-bezier(0.2,0,0,1), border-color 200ms cubic-bezier(0.2,0,0,1);
  }
  .qchp-footer-btn:hover { background: rgba(252,128,25,0.18); border-color: rgba(252,128,25,0.5); }

  /* ── Reduced motion ──────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .qchp-card,
    .qchp-card::before,
    .qchp-card__img,
    .qchp-card__cta,
    .qchp-card__cta::before,
    .qchp-tab-btn,
    .qchp-tab-btn::before,
    .qchp-view-all,
    .qchp-footer-btn {
      animation: none !important;
      transition: none !important;
    }
    .qchp-live-dot { animation: none !important; }
  }
</style>
