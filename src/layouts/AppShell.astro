---
import { Flags } from '@/lib/flags';
import Heading from "@/components/foundation/Heading.astro";
import Text from "@/components/foundation/Text.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "DealsHub - AI Powered Deals" } = Astro.props;

// Global bootstrap
const flags = await Flags.resolve({ env: 'production' });
const globalFlagsPayload = JSON.stringify(flags);
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <style>
      body { margin: 0; padding: 0; }
    </style>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased pb-24 selection:bg-primary/20 flex flex-col">
    
    {/* Global App Header */}
    <header class="sticky top-0 z-50 w-full border-b bg-background/80 backdrop-blur-md">
      <div class="max-w-7xl mx-auto flex h-16 items-center px-6 justify-between">
        <div class="flex gap-6 md:gap-10">
          <a href="/" class="flex items-center space-x-2">
            <span class="inline-block font-bold text-xl tracking-tight">DealsHub<span class="text-primary">.ai</span></span>
          </a>
          <nav class="hidden md:flex gap-6">
            <a href="#" class="flex items-center text-sm font-medium text-foreground/60 transition-colors hover:text-foreground">Today's Deals</a>
            <a href="#" class="flex items-center text-sm font-medium text-foreground/60 transition-colors hover:text-foreground">Trending</a>
            <a href="#" class="flex items-center text-sm font-medium text-foreground/60 transition-colors hover:text-foreground">Price Drops</a>
          </nav>
        </div>
        <div class="flex items-center gap-4">
          <a href="#" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">Sign In</a>
        </div>
      </div>
    </header>

    <main class="flex-grow flex flex-col relative w-full h-full" id="app-root">
      <slot />
    </main>

    <script define:vars={{ globalFlagsPayload }}>
      window.APP_FLAGS = JSON.parse(globalFlagsPayload);
    </script>
    <script src="../platform/analytics/client.ts"></script>
    <script src="../lib/performance/client.ts"></script>
  </body>
</html>
